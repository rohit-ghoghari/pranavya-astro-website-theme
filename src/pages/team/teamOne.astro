import PageHeading from "../../components/common/PageHeading.astro"
import TeamSection from "../../components/common/TeamSection.astro"
---

<Layout
  headerVariant="inner"
  footerVariant="inner"
  title="Our Instructors & Guides — Pranavya Yoga"
  description="Meet our team of dedicated yoga teachers, meditation guides, and wellness mentors at Pranavya Yoga."
  canonical="/team/teamOne/"
>

  <main
    class="h-full 2xl:pt-20.5 xl:pt-19.5 lg:pt-16.5 md:pt-14 sm:pt-13 pt-10"
