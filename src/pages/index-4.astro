---
import Layout from "../layouts/Layout.astro";
import IndexFourHeroSection from "../components/index-4/IndexFourHeroSection.astro";
import Discover from "../components/index-4/Discover.astro";
import Practice from "../components/index-4/Practice.astro";
import WhyChooseFour from "../components/index-4/WhyChooseFour.astro";
import ScheduleSection from "../components/index-4/ScheduleSection.astro";
import InsightsSection from "../components/index-4/InsightsSection.astro";
import TestimonialsSection from "../components/index-4/TestimonialsSection.astro";
import InstagramMarquee from "../components/index-4/InstagramMarquee.astro";
---

<Layout
  headerVariant="index-3"
  footerVariant="inner"
  title="Pranavya Yoga — Home 4 (Holistic Practice & Insights)"
  description="Discover Pranavya Yoga Home Variant 4. A clean editorial aesthetic presenting practice benefits, community testimonials, and mindfulness blogs."
  canonical="/index-4/"
>
  <!-- Section 1 -->
  <IndexFourHeroSection />

  <!-- Section 2 -->
  <Discover />

  <!-- Section 3 -->
  <Practice />

  <!-- Section 4 -->
  <section
    class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full bg-white border-t border-b border-primary/20 overflow-hidden 2xl:py-6 1xl:py-5 xl:py-4.5 lg:py-4 md:py-3.5 sm:py-3 py-2.5"
  >
    <div>
      <ul
        class="flex items-center justify-center 2xl:gap-10 1xl:gap-9 xl:gap-8 lg:gap-6 sm:gap-4 gap-1"
      >
        <li
          class="flex items-center 2xl:gap-10 1xl:gap-9 xl:gap-8 lg:gap-6 sm:gap-4 gap-1"
        >
          <svg
            class="lt:w-5 lt:h-5 md:w-4.5 md:h-4.5 dm:w-4 sm:h-4 w-1 h-1 shrink-0 text-primary/70"
            viewBox="0 0 20 20"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M16.2 10.2L12.72 10.44L14.82 12.72L16.68 15.48L11.1 19.08L9.84 15.78L9.24 12.6L7.38 15.66L4.86 18.96L0.6 15.54L3.6 12.66L6.48 10.44L3.18 10.26L0 9.66L2.82 4.08L5.76 5.34L8.52 7.02L8.4 3.72L8.76 0H15L13.8 3.72L12.3 7.02L15.66 5.28L19.02 3.96L19.68 9.54L16.2 10.2Z"
            ></path>
          </svg>
          <h5
            class="uppercase text-primary/80 italic underline underline-offset-4 sm:decoration-1 decoration-0.5 2xl:text-25 1xl:text-20 lt:text-18 md:text-15 sm:text-xs text-[7px]"
          >
            Studio &amp; Online Classes
          </h5>
        </li>
        <li
          class="flex items-center 2xl:gap-10 1xl:gap-9 xl:gap-8 lg:gap-6 sm:gap-4 gap-1"
        >
          <svg
            class="lt:w-5 lt:h-5 md:w-4.5 md:h-4.5 dm:w-4 sm:h-4 w-1 h-1 shrink-0 text-primary/70"
            viewBox="0 0 20 20"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M16.2 10.2L12.72 10.44L14.82 12.72L16.68 15.48L11.1 19.08L9.84 15.78L9.24 12.6L7.38 15.66L4.86 18.96L0.6 15.54L3.6 12.66L6.48 10.44L3.18 10.26L0 9.66L2.82 4.08L5.76 5.34L8.52 7.02L8.4 3.72L8.76 0H15L13.8 3.72L12.3 7.02L15.66 5.28L19.02 3.96L19.68 9.54L16.2 10.2Z"
            ></path>
          </svg>
          <h5
            class="uppercase text-primary/80 italic underline underline-offset-4 sm:decoration-1 decoration-0.5 2xl:text-25 1xl:text-20 lt:text-18 md:text-15 sm:text-xs text-[7px]"
          >
            Drop-In or Membership
          </h5>
        </li>
        <li
          class="flex items-center 2xl:gap-10 1xl:gap-9 xl:gap-8 lg:gap-6 sm:gap-4 gap-1"
        >
          <svg
            class="lt:w-5 lt:h-5 md:w-4.5 md:h-4.5 dm:w-4 sm:h-4 w-1 h-1 shrink-0 text-primary/70"
            viewBox="0 0 20 20"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M16.2 10.2L12.72 10.44L14.82 12.72L16.68 15.48L11.1 19.08L9.84 15.78L9.24 12.6L7.38 15.66L4.86 18.96L0.6 15.54L3.6 12.66L6.48 10.44L3.18 10.26L0 9.66L2.82 4.08L5.76 5.34L8.52 7.02L8.4 3.72L8.76 0H15L13.8 3.72L12.3 7.02L15.66 5.28L19.02 3.96L19.68 9.54L16.2 10.2Z"
            ></path>
          </svg>
          <h5
            class="uppercase text-primary/80 italic underline underline-offset-4 sm:decoration-1 decoration-0.5 2xl:text-25 1xl:text-20 lt:text-18 md:text-15 sm:text-xs text-[7px]"
          >
            All Levels Welcome
          </h5>
        </li>
        <li
          class="flex items-center 2xl:gap-10 1xl:gap-9 xl:gap-8 lg:gap-6 sm:gap-4 gap-1"
        >
          <svg
            class="lt:w-5 lt:h-5 md:w-4.5 md:h-4.5 dm:w-4 sm:h-4 w-1 h-1 shrink-0 text-primary/70"
            viewBox="0 0 20 20"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M16.2 10.2L12.72 10.44L14.82 12.72L16.68 15.48L11.1 19.08L9.84 15.78L9.24 12.6L7.38 15.66L4.86 18.96L0.6 15.54L3.6 12.66L6.48 10.44L3.18 10.26L0 9.66L2.82 4.08L5.76 5.34L8.52 7.02L8.4 3.72L8.76 0H15L13.8 3.72L12.3 7.02L15.66 5.28L19.02 3.96L19.68 9.54L16.2 10.2Z"
            ></path>
          </svg>
        </li>
      </ul>
    </div>
  </section>

  <!-- Section 5 -->
  <WhyChooseFour />

  <!-- Section 6 -->
  <section
    class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full h-full"
  >
    <div
      class="md:absolute md:inset-0 relative top-0 left-0 w-full h-full max-md:shadow-[0_35px_10px_2px_#e4e4e4ab] max-sm:shadow-[0_24px_10px_0px_#e4e4e4ab] md:bg-transparent bg-[#DFDFE0] md:p-0 sm:pt-7 pt-[14px] z-1"
    >
      <div class="container h-full flex items-center">
        <div
          class="flex flex-col my-auto items-start sm:justify-center justify-end 1xl:py-10 1xl:px-[30px] xl:py-9 sm:py-6 sm:px-[26px] p-5 text-black 2xl:max-w-[862px] 1xl:max-w-[775px] xl:max-w-[690px] lg:max-w-[610px] lt:max-w-[518px] md:max-w-[490px] w-full bg-[#FFFFFFA1] sm:backdrop-blur-[10px] backdrop-blur-sm rounded-[10px]"
        >
          <h3
            class="font-primary italic font-medium 2xl:mb-7 1xl:mb-6 xl:mb-5 sm:mb-3 mb-2.5 text-start text-primary"
          >
            Transform in Just 14 Days
          </h3>
          <h2 class="uppercase 1xl:mb-5 sm:mb-3 mb-2.5 text-start text-primary">
            Awaken strength and clarity.
          </h2>
          <p
            class="text-start text-thunder-100 xl:max-w-[83%] max-w-full w-full"
          >
            Experience daily guided sessions, mindful movement, and inner
            stillness.
          </p>
          <a
            href="/bookClass/"
            class="btn btn-secondary 1xl:mt-[45px] xl:mt-8 sm:mt-6 mt-4"
          >
            Join the 14-Day trial</a
          >
        </div>
      </div>
    </div>
    <div
      class="2xl:h-[680px] 1xl:h-[590px] xl:h-[550px] lg:h-[510px] md:h-[410px] sm:h-[350px] h-[272px]"
    >
      <div
        class="relative w-full bg-cover md:bg-center sm:bg-right bg-position-[80%] bg-no-repeat h-full"
        style="background-image: url('/trial-banner.webp')"
      >
      </div>
    </div>
  </section>

  <!-- Section 7 -->
  <ScheduleSection />

  <!-- Section 8 -->
  <InsightsSection />

  <!-- Section 9 -->
  <TestimonialsSection />

  <!-- Section 10 -->   
  <InstagramMarquee />
</Layout>
