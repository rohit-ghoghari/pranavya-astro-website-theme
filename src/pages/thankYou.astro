---
import Layout from "../layouts/Layout.astro"

const thankYouContent = {
    image: "/thank-you.webp",
    imageAlt: "Thank you",
    title: "“Thank You, Beautiful Soul!”",
    description:
        "Your energy is aligned — we’ve received your submission. Check your inbox for next steps and stay tuned for more mindful moments.",
    buttonText: "Return to Home",
    buttonHref: "/",
};
---
<Layout
  headerVariant="inner"
  footerVariant="inner"
  title="Thank You for Your Order — Pranavya Yoga"
  description="Thank you for your purchase with Pranavya Yoga. Your order confirmation and receipt have been processed."
  canonical="/thankYou/"
>
    
  <main class="h-full 2xl:pt-20.5 xl:pt-19.5 lg:pt-16.5 md:pt-14 sm:pt-13 pt-10">
    

<section class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full">
    <div class="container">
        <div class="relative 2xl:my-[100px] 1xl:my-20 xl:my-17 lg:my-14 md:my-12 sm:my-11 my-10 w-full flex items-center justify-center flex-col">

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-0 left-0 right-auto w-[22%] opacity-30 hidden md:block">
                <img loading="lazy" decoding="async" src="/flower-shape.svg" alt="decor" class="w-full h-full object-contain">
            </div>

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-0 left-auto right-0 lt:w-[10%] w-[17%] opacity-30 hidden md:block">
                <img loading="lazy" decoding="async" src="/flower-shape.svg" alt="decor" class="w-full h-full object-contain">
            </div>

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-auto bottom-20 left-auto right-0 w-[17%] opacity-30 hidden md:block">
                <img loading="lazy" decoding="async" src="/flower-shape.svg" alt="decor" class="w-full h-full object-contain">
            </div>

            <div class="1xl:size-92 xl:size-70 lt:size-62 md:size-54 sm:size-52 size-38 xl:p-10 lg:p-8 sm:p-7 p-5 overflow-hidden flex items-center justify-center sm:border-3 border border-primary/20 bg-whitesmoke-100 rounded-full 2xl:mb-12.5 1xl:mb-10 xl:mb-8 lg:mb-6 md:mb-5 sm:mb-4 mb-3.5">
                <img
                    loading="lazy"
                    src={thankYouContent.image}
                    alt={thankYouContent.imageAlt}
                    class="w-full h-full object-contain mx-auto"
                >
            </div>

            <h3 class="font-medium italic font-primary 2xl:mb-6 1xl:mb-5 mb-4 text-center">
                {thankYouContent.title}
            </h3>

            <p class="1xl:mb-10 sm:mb-7 mb-6 text-center font-medium 2xl:max-w-[40%] lg:max-w-1/2 md:max-w-[65%] w-full">
                {thankYouContent.description}
            </p>

            <a href={thankYouContent.buttonHref} class="btn btn-secondary">
                {thankYouContent.buttonText}
            </a>

        </div>
    </div>
</section>
  </main>
</Layout>