---
import Layout from "../layouts/Layout.astro";
---

<Layout
    headerVariant="inner"
    footerVariant="inner"
    title="Member Login & Registration — Pranavya Yoga"
    description="Sign in to your Pranavya Yoga account or register as a new member to manage class bookings, track wellness sessions, and access perks."
    canonical="/login/"
>
    <!-- ====== Main-Content ====== -->
    <main class="h-full 2xl:pt-20.5 xl:pt-19.5 lg:pt-16.5 md:pt-14 sm:pt-13 pt-10 relative">
        <section class="relative 2xl:my-[100px] 1xl:my-20 xl:my-17 lg:my-14 md:my-12 sm:my-11 my-10">
            <div class="container 2xl:max-w-[1480px] mx-auto">
                <div class="flex md:flex-row flex-col items-start justify-center 2xl:gap-20 1xl:gap-18 xl:gap-16 lt:gap-14 sm:gap-8 gap-5">
                    <div class="rounded-sm border border-primary/20 1xl:p-16 lg:p-14 lt:p-11 sm:p-8 p-6 w-full">
                        <div class="mb-5">
                            <h3 class="uppercase text-primary lg:mb-2.5 mb-2">Login</h3>
                            <p class="font-medium 2xl:mb-10 1xl:mb-8 mb-6">New user? Create an account.</p>
                        </div>
                        <div>
                            <form id="book-class-form" class="book-class-form validate-form"
                                data-popup="booking-success-popup" novalidate>
                                <!-- email -->
                                <div>
                                    <label class="block p lg:mb-2.5 mb-2">Email *</label>
                                    <input type="email" name="email" placeholder="Enter Your Email"
                                        class="w-full type-filed p2 placeholder:text-thunder-100/35 bg-white border-primary/20! focus:border-primary active:border-primary"
                                        required>
                                </div>

                                <div class="relative">
                                    <label class="block p lg:mb-2.5 mb-2">Password*</label>
                                    <div class="relative">

