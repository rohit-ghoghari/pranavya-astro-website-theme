---
import Layout from "../../layouts/Layout.astro"
import PageHeading from "../../components/common/PageHeading.astro"
import RetreatSection from "../../components/common/RetreatsSection.astro"
---

<Layout
  headerVariant="inner"
  footerVariant="inner"
  title="Yoga Retreats & Nature Immersions — Pranavya Yoga"
  description="Escape into nature, nourish your soul, and reconnect with your inner self. Discover our transformative seasonal yoga and meditation retreats."
  canonical="/retreat/YogaRetreat/"
>

  <main
    class="h-full 2xl:pt-20.5 xl:pt-19.5 lg:pt-16.5 md:pt-14 sm:pt-13 pt-10"
  >
    <PageHeading
      title="Yoga Retreats"
      description="From serene escapes in nature to immersive yoga intensives, our retreats are thoughtfully designed to meet you where you are. Retreats designed for relaxation, growth, and balance."
      backgroundClass="bg-whitesmoke-100"
    />

    <RetreatSection />
</main>
</Layout>