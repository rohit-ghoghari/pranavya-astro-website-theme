---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogDetailLayout from "../../components/blogs/BlogDetailLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blogs");

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = await getCollection("blogs");
const { Content } = await render(post);
const recentPosts = allPosts
  .filter((item) => item.id !== post.id)
  .slice(0, 4)
  .map(({ data }) => data);
const categoryCounts = new Map<string, number>();

for (const item of allPosts) {
  categoryCounts.set(
    item.data.category,
    (categoryCounts.get(item.data.category) ?? 0) + 1,
  );
}

const categories = [...categoryCounts].map(([name, count]) => ({
  name,
  count,
}));
const pageDescription = post.data.metaDescription ?? post.data.excerpt;
---

<Layout
  headerVariant="inner"
  footerVariant="inner"
  title={post.data.title.includes("Pranavya Yoga") ? post.data.title : `${post.data.title} — Pranavya Yoga`}
  description={pageDescription}
  canonical={`/blog/${post.data.slug}/`}
  image={post.data.image}
>
  <BlogDetailLayout post={post.data} recentPosts={recentPosts} categories={categories}>
    <Content />
  </BlogDetailLayout>
</Layout>
