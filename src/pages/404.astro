---
import Layout from "../layouts/Layout.astro";

const notFoundContent = {
    image: "/404.webp",
    imageAlt: "404 error",
    title: "“Oops... This Page Lost Its Balance ️”",
    description:
        "The page you’re looking for might have been moved, deleted, or never existed. Let’s get you back on track.",
    buttons: [
        {
            text: "Return Shop",
            href: "/shop/",
        },
        {
            text: "View order",
            href: "/confirmOrder/",
        },
    ],
};
---
<Layout
  headerVariant="inner"
  footerVariant="inner"
  title="404 Page Not Found — Pranavya Yoga"
  description="The page you are looking for cannot be found. Return to Pranavya Yoga homepage."
>
  <main class="h-full 2xl:pt-20.5 xl:pt-19.5 lg:pt-16.5 md:pt-14 sm:pt-13 pt-10">


<section class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full">
    <div class="container">
        <div class="relative 2xl:my-[100px] 1xl:my-20 xl:my-17 lg:my-14 md:my-12 sm:my-11 my-10 w-full flex items-center justify-center flex-col">

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-0 left-0 right-auto w-[22%] opacity-30 hidden md:block">
                <img loading="lazy" decoding="async" src="/flower-shape.svg" alt="decor" class="w-full h-full object-contain">
            </div>

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-0 left-auto right-0 lt:w-[10%] w-[17%] opacity-30 hidden md:block">
                <img loading="lazy" decoding="async" src="/flower-shape.svg" alt="decor" class="w-full h-full object-contain">
            </div>

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-auto bottom-20 left-auto right-0 w-[17%] opacity-30 hidden md:block">
                <img loading="lazy" decoding="async" src="/flower-shape.svg" alt="decor" class="w-full h-full object-contain">
            </div>

            <img
                loading="lazy"
                src={notFoundContent.image}
                alt={notFoundContent.imageAlt}
                class="1xl:w-212 xl:w-170 lg:w-140 lt:w-125 md:w-110 sm:w-100 w-full h-auto mx-auto 2xl:mb-12.5 1xl:mb-10 xl:mb-8 lg:mb-6 md:mb-5 sm:mb-4 mb-3.5"
            >

            <h3 class="italic font-medium font-primary 2xl:mb-6 1xl:mb-5 mb-4 text-center">
                {notFoundContent.title}
            </h3>

            <p class="1xl:mb-10 sm:mb-7 mb-6 text-center 1xl:max-w-[45%] xl:max-w-1/2 lt:max-w-[58%] md:max-w-[67%] w-full font-medium">
                {notFoundContent.description}
            </p>

            <div class="flex items-center justify-center sm:gap-8 gap-3 flex-wrap">
                {notFoundContent.buttons.map((button) => (
                    <a href={button.href} class="btn btn-secondary">
                        {button.text}
                    </a>
                ))}
            </div>

        </div>
    </div>
</section>

  </main>
</Layout>
