---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import ClassListing from "../../components/classOne/ClassListing.astro";
import TestimonialsSection from "../../components/classOne/TestimonialsSection.astro";

const classEntries = await getCollection("classes");
const classes = classEntries.map(({ id, data }) => ({
  slug: id,
  image: data.mainImage,
  imageAlt: data.mainImageAlt,
  intensity: data.intensityLevel,
  intensityClass: data.intensityBadgeClass,
  category: data.listingCategory,
  filterCategories: data.filterCategories,
  title: data.listingTitle,
  description: data.listingDescription,
  instructorImage: data.instructor.image,
  instructorName: data.instructor.name,
}));
---

<Layout
  headerVariant="inner"
  footerVariant="inner"
  title="Yoga Classes Listing — Pranavya Yoga"
  description="Explore our complete schedule of mindful yoga classes, from Hatha and Vinyasa Flow to Restorative and Iyengar practices."
  canonical="/classes/classOne/"
>
  <main
    class="h-full 2xl:pt-20.5 xl:pt-19.5 lg:pt-16.5 md:pt-14 sm:pt-13 pt-10"
  >
    <PageHeading
      title="Plan Your Practice"
      description="Experience yoga that fits your life-flow at your pace, at your time. Our thoughtfully curated class schedule nurtures your body, calms your mind, and uplifts your spirit -every single day."
      backgroundClass="bg-whitesmoke-100"
    />


    <ClassListing classes={classes} />

    <TestimonialsSection/>
  </main>
</Layout>
