---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Shopping Cart — Pranavya Yoga"
    description="Review your selected yoga accessories, mats, and wellness products in your shopping cart before proceeding to checkout."
    canonical="/Cart/"
    headerVariant="inner"
    footerVariant="inner"
>
    

    <!-- ====== Start Cart Section ====== -->
    <section class="2xl:mt-[100px] 1xl:mt-20 xl:mt-17 lg:mt-14 md:mt-12 sm:mt-11 mt-10 2xl:mb-[120px] 1xl:mb-[100px] xl:mb-20 lg:mb-16 md:mb-12 sm:mb-11 mb-10">
        <div class="container">
            <div class="text-center 2xl:mb-[60px] 1xl:mb-12 xl:mb-10 lg:mb-9 md:mb-8 sm:mb-7 mb-6">
                <h2 class="text-primary uppercase">Your Shopping Cart</h2>
            </div>

            <div class="flex lg:flex-row flex-col lg:gap-10 gap-8">
                <!-- Cart Table -->
                <div class="lg:w-[70%] w-full overflow-x-auto">
                    <table class="w-full min-w-[700px]">
                        <thead>
                            <tr class="border-b-2 border-primary/20">
                                <th class="text-left p font-medium 2xl:pb-6 pb-4 uppercase">Product</th>
                                <th class="text-left p font-medium 2xl:pb-6 pb-4 uppercase">Name</th>
                                <th class="text-left p font-medium 2xl:pb-6 pb-4 uppercase">Price</th>
                                <th class="text-left p font-medium 2xl:pb-6 pb-4 uppercase">Quantity</th>
                                <th class="text-left p font-medium 2xl:pb-6 pb-4 uppercase">Total</th>
                                <th class="text-left p font-medium 2xl:pb-6 pb-4"></th>
                            </tr>
                        </thead>
                        <tbody id="cartTableBody">
                            <!-- Cart items will be inserted here by JavaScript -->
                        </tbody>
                    </table>

                    <!-- Empty Cart Message -->
                    <div id="emptyCartMessage" class="hidden text-center py-12">
                        <p class="text-xl text-thunder-100/70 mb-4">Your cart is empty</p>
                        <a href="/shop" class="btn btn-secondary">Continue Shopping</a>
                    </div>

                    <!-- Update Cart Button -->
                    <div class="flex items-center justify-between 2xl:mt-8 mt-6">
                        <button id="updateCartBtn" class="btn btn-secondary flex items-center gap-3">
                            Update Cart
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <path d="M17.5 10C17.5 10 14.1667 5 10 5C5.83333 5 2.5 10 2.5 10C2.5 10 5.83333 15 10 15C14.1667 15 17.5 10 17.5 10Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M10 12.5C11.3807 12.5 12.5 11.3807 12.5 10C12.5 8.61929 11.3807 7.5 10 7.5C8.61929 7.5 7.5 8.61929 7.5 10C7.5 11.3807 8.61929 12.5 10 12.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Cart Summary -->
                <div class="lg:w-[30%] w-full">
                    <div class="bg-whitesmoke-100 rounded-sm 2xl:p-8 p-6">
                        <h4 class="font-primary font-medium text-primary uppercase mb-6">Cart Total</h4>

                        <div class="space-y-4 mb-6 pb-6 border-b border-primary/20">
                            <div class="flex items-center justify-between">
                                <p class="font-medium">Subtotal:</p>
                                <p class="font-medium" id="cartSubtotal">$0.00</p>
                            </div>
                            <div class="flex items-center justify-between">
                                <p class="font-medium">Shipping:</p>
                                <p class="font-medium">Free</p>
                            </div>
                            <div class="flex items-center justify-between">
                                <p class="font-medium">Tax (5%):</p>
                                <p class="font-medium" id="cartTax">$0.00</p>
                            </div>
                        </div>

                        <div class="flex items-center justify-between mb-6 pb-6 border-b border-primary/20">
                            <p class="font-medium">Sub Total</p>
                            <p class="font-medium" id="cartSubtotalWithTax">$0.00</p>
                        </div>

                        <!-- Coupon Code -->
                        <div class="mb-6">
                            <div class="flex items-stretch gap-2">
                                <input 
                                    type="text" 
                                    id="couponCode" 
                                    placeholder="YOGA20" 
                                    class="flex-1 border border-primary/20 rounded-sm px-4 py-2 focus:outline-none focus:border-primary"
                                />
                                <button id="applyCouponBtn" class="btn btn-secondary whitespace-nowrap">
                                    Submit
                                </button>
                            </div>
                            <div id="couponMessage" class="mt-2 text-sm hidden"></div>
                        </div>

                        <div class="flex items-center justify-between mb-8 pb-6 border-b border-primary/20" id="discountSection">
                            <p class="font-medium">Code Applied (YOGA20)</p>
                            <p class="font-medium text-green-600" id="cartDiscount">$0.00</p>
                        </div>

                        <div class="flex items-center justify-between mb-6">
                            <h5 class="text-primary uppercase">Total</h5>
                            <h5 class="text-primary" id="cartTotal">$0.00</h5>
                        </div>

                        <div class="space-y-4">
                            <a href="/confirmOrder" class="btn btn-secondary w-full text-center">
                                Proceed to Checkout
                                <span class="inline-block ml-2">→</span>
                            </a>
                            <a href="/shop" class="btn btn-outline w-full text-center">
                                Continue to shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- ====== End Cart Section ====== -->

    
</Layout>

<script>
    // Cart management
    interface CartItem {
        id: string;
        title: string;
        price: number;
        image: string;
        quantity: number;
        color?: string;
        size?: string;
        url: string;
    }

    function getCart(): CartItem[] {
        const cart = localStorage.getItem('cart');
        return cart ? JSON.parse(cart) : [];
    }

    function saveCart(cart: CartItem[]) {
        localStorage.setItem('cart', JSON.stringify(cart));
    }

    function updateCartDisplay() {
        const cart = getCart();
        const cartTableBody = document.getElementById('cartTableBody');
        const emptyCartMessage = document.getElementById('emptyCartMessage');
        
        if (!cartTableBody || !emptyCartMessage) return;

        if (cart.length === 0) {
            cartTableBody.innerHTML = '';
            emptyCartMessage.classList.remove('hidden');
            return;
        }

        emptyCartMessage.classList.add('hidden');

        // Render cart items
        cartTableBody.innerHTML = cart.map((item, index) => `
            <tr class="border-b border-primary/10" data-cart-index="${index}">
                <td class="2xl:py-6 py-4">
                    <div class="w-24 h-24 bg-[#E0E0E0] rounded-sm p-2 flex items-center justify-center">
                        <img src="${item.image}" alt="${item.title}" class="w-full h-full object-contain" />
                    </div>
                </td>
                <td class="2xl:py-6 py-4">
                    <a href="${item.url}" class="font-medium hover:text-primary">
                        ${item.title}
                    </a>
                    ${item.color ? `<p class="text-sm text-thunder-100/70 mt-1">Color: <span class="inline-block w-4 h-4 rounded-full align-middle ml-1" style="background-color: ${item.color}"></span></p>` : ''}
                </td>
                <td class="2xl:py-6 py-4">
                    <p class="font-medium">$${item.price.toFixed(2)}</p>
                </td>
                <td class="2xl:py-6 py-4">
                    <div class="flex items-center justify-between w-28 h-10 rounded-full border border-bronco-100 px-2">
                        <button type="button" aria-label="Decrease quantity" class="decrease-qty text-[#6B3F2A] hover:opacity-70">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" class="size-5">
                                <path d="M16.4053 11.4928C16.4053 11.4928 9.75608 11.4927 6.98658 11.4927" stroke="#673E2C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <p class="text-sm font-medium select-none">${item.quantity}</p>
                        <button type="button" aria-label="Increase quantity" class="increase-qty text-[#6B3F2A] hover:opacity-70">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" class="size-5">
                                <path d="M7.20703 11.4928C7.20703 11.4928 13.8562 11.4927 16.6257 11.4927" stroke="#673E2C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M11.9151 16.2023C11.9151 16.2023 11.9151 9.55307 11.915 6.78357" stroke="#673E2C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </td>
                <td class="2xl:py-6 py-4">
                    <p class="font-medium">$${(item.price * item.quantity).toFixed(2)}</p>
                </td>
                <td class="2xl:py-6 py-4">
                    <button class="remove-item flex items-center gap-2 text-thunder-100 hover:text-red-600 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M12.4955 3.96912L2.96973 13.4949" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2.96973 3.96912L12.4955 13.4949" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Remove
                    </button>
                </td>
            </tr>
        `).join('');

        // Update totals
        updateCartTotals();

        // Attach event listeners
        attachCartEventListeners();
    }

    function updateCartTotals() {
        const cart = getCart();
        const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        const tax = subtotal * 0.05;
        const subtotalWithTax = subtotal + tax;

        // Check for applied coupon
        const appliedCoupon = localStorage.getItem('appliedCoupon');
        let discount = 0;
        let total = subtotalWithTax;

        if (appliedCoupon === 'YOGA20') {
            discount = subtotalWithTax * 0.20;
            total = subtotalWithTax - discount;
            document.getElementById('discountSection')?.classList.remove('hidden');
            document.getElementById('cartDiscount')!.textContent = `$${discount.toFixed(2)}`;
        } else {
            document.getElementById('discountSection')?.classList.add('hidden');
        }

        document.getElementById('cartSubtotal')!.textContent = `$${subtotal.toFixed(2)}`;
        document.getElementById('cartTax')!.textContent = `$${tax.toFixed(2)}`;
        document.getElementById('cartSubtotalWithTax')!.textContent = `$${subtotalWithTax.toFixed(2)}`;
        document.getElementById('cartTotal')!.textContent = `$${total.toFixed(2)}`;
    }

    function attachCartEventListeners() {
        // Quantity increase/decrease
        document.querySelectorAll('.increase-qty').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const row = (e.target as HTMLElement).closest('tr');
                const index = parseInt(row?.getAttribute('data-cart-index') || '0');
                const cart = getCart();
                cart[index].quantity++;
                saveCart(cart);
                updateCartDisplay();
            });
        });

        document.querySelectorAll('.decrease-qty').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const row = (e.target as HTMLElement).closest('tr');
                const index = parseInt(row?.getAttribute('data-cart-index') || '0');
                const cart = getCart();
                if (cart[index].quantity > 1) {
                    cart[index].quantity--;
                    saveCart(cart);
                    updateCartDisplay();
                }
            });
        });

        // Remove item
        document.querySelectorAll('.remove-item').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const row = (e.target as HTMLElement).closest('tr');
                const index = parseInt(row?.getAttribute('data-cart-index') || '0');
                const cart = getCart();
                cart.splice(index, 1);
                saveCart(cart);
                updateCartDisplay();
            });
        });
    }

    // Coupon code
    document.getElementById('applyCouponBtn')?.addEventListener('click', () => {
        const couponInput = document.getElementById('couponCode') as HTMLInputElement;
        const couponMessage = document.getElementById('couponMessage');
        const code = couponInput.value.trim().toUpperCase();

        if (!couponMessage) return;

        if (code === 'YOGA20') {
            localStorage.setItem('appliedCoupon', code);
            couponMessage.textContent = 'Coupon applied successfully! 20% off';
            couponMessage.classList.remove('hidden', 'text-red-600');
            couponMessage.classList.add('text-green-600');
            updateCartTotals();
        } else {
            couponMessage.textContent = 'Invalid coupon code';
            couponMessage.classList.remove('hidden', 'text-green-600');
            couponMessage.classList.add('text-red-600');
        }
    });

    // Initialize cart display
    document.addEventListener('DOMContentLoaded', () => {
        updateCartDisplay();
    });
</script>

<style>
    .btn-outline {
        border: 1px solid #6F4E37;
        color: #6F4E37;
        background: transparent;
        padding: 0.75rem 1.5rem;
        border-radius: 0.125rem;
        text-transform: uppercase;
        font-weight: 500;
        transition: all 0.3s;
    }
    .btn-outline:hover {
        background: #6F4E37;
        color: white;
    }
</style>
