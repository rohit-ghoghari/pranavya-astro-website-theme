---
interface Props {
    sidebar: {
        title: string;
        image: {
            src: string;
            alt: string;
        };
        mapUrl: string;
        address: string;
        phoneHref: string;
        phone: string;
        bookButtonHref: string;
        bookButtonText: string;
        socials: {
            instagram: string;
            twitter: string;
            facebook: string;
            youtube: string;
        };
    };
}

const { sidebar } = Astro.props;
---

<!-- Sticky Sidebar -->
<div
    class="lt:w-[36%] md:w-[38%] w-full bg-whitesmoke-100 rounded-sm overflow-hidden 1xl:p-8.5 xl:p-6.5 lg:p-5.5 lt:p-4.5 p-4 sticky xl:top-25 top-22"
>
    <h5
        class="uppercase text-primary lt:pb-5 lt:mb-5.5 sm:pb-4 pb-3 mb-4 border-b border-primary/50"
    >
        {sidebar.title}
    </h5>
    <div
        class="1xl:h-[306px] xl:h-[250px] lg:h-[230px] lt:h-[210px] md:h-[170px] h-full w-full rounded-sm overflow-hidden 1xl:mb-8 sm:mb-6 mb-4"
    >
        <img
            src={sidebar.image.src}
            alt={sidebar.image.alt}
            class="w-full h-full object-cover"
            loading="lazy"
            fetchpriority="high"
            decoding="async"
        />
    </div>
    <div
        class="1xl:space-y-4 xl:space-y-3 space-y-2 lg:mb-9 mb-7"
    >
        <a
            href={sidebar.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open location in Google Maps"
            class="flex items-start 1xl:gap-3 xl:gap-2.5 gap-2"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 16 16"
                        class="text-primary shrink-0 2xl:w-9 1xl:w-8 xl:w-7 lt:w-6 lg:w-6.5 sm:w-5 w-4.5 h-full 1xl:mt-1.5 sm:mt-1 mt-0.5">
                        <path fill="currentColor" fill-rule="evenodd"
                            d="M8 1a5 5 0 0 0-5 5c0 1.14.56 2.488 1.377 3.934c.827 1.463 1.967 3.107 3.216 4.857l.407.57l.407-.57c1.25-1.75 2.389-3.394 3.216-4.857C12.44 8.488 13 7.14 13 6a5 5 0 0 0-5-5m0 2.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 0 0 0-5"
                            clip-rule="evenodd" />
                    </svg>
            <p
                class="font-medium uppercase 2xl:text-20 1xl:text-19 lg:text-16 sm:text-14 text-xs"
            >
                {sidebar.address}
            </p>
        </a>
        <a
            href={sidebar.phoneHref}
            class="flex items-center 1xl:gap-3 xl:gap-2.5 gap-2"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24"
                        class="text-primary 2xl:w-9 1xl:w-8 xl:w-7 lt:w-6 lg:w-6.5 sm:w-5 w-4.5 h-full 1xl:mt-1.5 sm:mt-1 mt-0.5 shrink-0">
                        <path fill="currentColor"
                            d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.98.98 0 0 0-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02c-.37-1.11-.56-2.3-.56-3.53c0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99C3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99" />
                    </svg>
            <p
                class="font-medium uppercase 2xl:text-20 1xl:text-19 lg:text-16 sm:text-14 text-xs"
            >
                {sidebar.phone}
            </p>
        </a>
    </div>
    <a
        href={sidebar.bookButtonHref}
        class="btn btn-secondary 1xl:mb-7 mb-5"
        >{sidebar.bookButtonText}</a
    >
    <!-- Social Media Icons -->
    <div
        class="flex items-center flex-wrap 1xl:gap-9 xl:gap-7 lt:gap-5 gap-3.5"
    >
        <a
            href={sidebar.socials.instagram}
            target="_blank"
            class="1xl:size-12 lt:size-11 size-9.5 lt:p-[10px] sm:p-[9px] p-2 btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" viewBox="0 0 24 24"
                        class="1xl:w-[26px] 1xl:h-[26px] w-5 h-5">
                        <path fill="currentColor"
                            d="M13.028 2c1.125.003 1.696.009 2.189.023l.194.007c.224.008.445.018.712.03c1.064.05 1.79.218 2.427.465c.66.254 1.216.598 1.772 1.153a4.9 4.9 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428c.012.266.022.487.03.712l.006.194c.015.492.021 1.063.023 2.188l.001.746v1.31a79 79 0 0 1-.023 2.188l-.006.194c-.008.225-.018.446-.03.712c-.05 1.065-.22 1.79-.466 2.428a4.9 4.9 0 0 1-1.153 1.772a4.9 4.9 0 0 1-1.772 1.153c-.637.247-1.363.415-2.427.465l-.712.03l-.194.006c-.493.014-1.064.021-2.189.023l-.746.001h-1.309a78 78 0 0 1-2.189-.023l-.194-.006a63 63 0 0 1-.712-.031c-1.064-.05-1.79-.218-2.428-.465a4.9 4.9 0 0 1-1.771-1.153a4.9 4.9 0 0 1-1.154-1.772c-.247-.637-.415-1.363-.465-2.428l-.03-.712l-.005-.194A79 79 0 0 1 2 13.028v-2.056a79 79 0 0 1 .022-2.188l.007-.194c.008-.225.018-.446.03-.712c.05-1.065.218-1.79.465-2.428A4.9 4.9 0 0 1 3.68 3.678a4.9 4.9 0 0 1 1.77-1.153c.638-.247 1.363-.415 2.428-.465c.266-.012.488-.022.712-.03l.194-.006a79 79 0 0 1 2.188-.023zM12 7a5 5 0 1 0 0 10a5 5 0 0 0 0-10m0 2a3 3 0 1 1 .001 6a3 3 0 0 1 0-6m5.25-3.5a1.25 1.25 0 0 0 0 2.5a1.25 1.25 0 0 0 0-2.5" />
                    </svg>
        </a>
        <a
            href={sidebar.socials.twitter}
            target="_blank"
            class="1xl:size-12 lt:size-11 size-9.5 lt:p-[10px] sm:p-[9px] p-2 btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22"
                        fill="none" class="1xl:w-[22px] 1xl:h-[22px] w-5 h-5">
                        <path
                            d="M16.8407 1.65039L11.6141 7.62498L7.09475 1.65039H0.546875L8.36897 11.8776L0.955921 20.3504H4.12995L9.85137 13.8119L14.852 20.3504H21.2356L13.0819 9.57082L20.0127 1.65039H16.8407ZM15.7276 18.4516L4.25235 3.44873H6.13857L17.4852 18.4506L15.7276 18.4516Z"
                            fill="currentColor" />
                    </svg>
        </a>
        <a
            href={sidebar.socials.facebook}
            target="_blank"
            class="1xl:size-12 lt:size-11 size-9.5 lt:p-[10px] sm:p-[9px] p-2 btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" viewBox="0 0 24 24"
                        class="xl:w-[26px] xl:h-[26px] w-6 h-6">
                        <path fill="currentColor"
                            d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4z" />
                    </svg>
        </a>
        <a
            href={sidebar.socials.youtube}
            target="_blank"
            class="1xl:size-12 lt:size-11 size-9.5 lt:p-[10px] sm:p-[9px] p-2 btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" viewBox="0 0 24 24"
                        class="xl:w-[26px] xl:h-[26px] w-6 h-6">
                        <path fill="currentColor"
                            d="m10 15l5.19-3L10 9zm11.56-7.83c.13.47.22 1.1.28 1.9c.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83c-.25.9-.83 1.48-1.73 1.73c-.47.13-1.33.22-2.65.28c-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44c-.9-.25-1.48-.83-1.73-1.73c-.13-.47-.22-1.1-.28-1.9c-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83c.25-.9.83-1.48 1.73-1.73c.47-.13 1.33-.22 2.65-.28c1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44c.9.25 1.48.83 1.73 1.73" />
                    </svg>
        </a>
    </div>
</div>
