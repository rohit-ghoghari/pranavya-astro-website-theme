---
import RetreatDetailSidebar from "./RetreatDetailSidebar.astro";

interface Props {
    data: any;
}

const { data } = Astro.props;
---

<!-- ====== Start Page Heading ====== -->
<section
    class="relative 1xl:pt-20 xl:pt-17 lg:pt-14 md:pt-12 sm:pt-11 pt-10 xl:mb-20 lg:mb-16 md:mb-12 sm:mb-11 mb-10 pb-[60px] bg-whitesmoke-100"
>
    <div class="container relative">
        <div
            class="flex flex-col items-center justify-center lt:max-w-[73%] md:max-w-[90%] max-w-full w-full text-center mx-auto space-y-2.5"
        >
            <h1 class="uppercase text-primary text-center" data-aos="fade-up">
                {data.hero.title}
            </h1>
            <p data-aos="fade-up">
                {data.hero.description}
            </p>
        </div>

        <!-- Decorative Flower -->
        <div
            class="pointer-events-none absolute 1xl:-top-20 xl:-top-[65px] lg:-top-[55px] -top-12 left-auto right-0 lg:w-[14.2%] w-[15%] hidden md:block opacity-30"
        >
            <img
                loading="lazy"
                decoding="async"
                src="/flower-shape.svg"
                alt="decor"
                class="w-full h-full object-contain"
            />
        </div>
    </div>
</section>
<!-- ====== End Page Heading ====== -->

<!-- ====== Start Retreat Detail ====== -->
<section
    class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full"
>
    <div class="container">
        <div
            class="flex items-start md:flex-row flex-col 1xl:gap-15 xl:gap-12 lg:gap-10 lt:gap-6 gap-4"
        >
            <!-- Main Content Column -->
            <div
                class="lt:w-[64%] md:w-[62%] w-full 2xl:space-y-12.5 1xl:space-y-11 md:space-y-7 space-y-4"
            >
                <!-- Hero Image -->
                <div class="rounded-sm overflow-hidden aspect-[3/2]" data-aos="fade-up">
                    <img
                        src={data.image.src}
                        alt={data.image.alt}
                        class="w-full h-full object-cover"
                        loading="lazy"
                        fetchpriority="high"
                        decoding="async"
                    />
                </div>

                <!-- Title & Meta -->
                <div data-aos="fade-up">
                    <h3 class="text-primary uppercase 1xl:mb-6 mb-4">
                        {data.title}
                    </h3>
                    <div class="1xl:space-y-5 md:space-y-4 space-y-3">
                        <div class="flex items-center md:gap-4.5 gap-2.5">
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                                        width="30" height="30" viewBox="0 0 30 30" fill="none"
                                        class="text-primary 1xl:w-7.5 xl:w-7 lg:w-6 md:w-5.5 w-4.5 h-full">
                                        <mask id="mask0_3146_18012" style="mask-type:alpha" maskUnits="userSpaceOnUse"
                                            x="0" y="0" width="30" height="30">
                                            <rect width="30" height="30" fill="url(#pattern0_3146_18012)" />
                                        </mask>
                                        <g mask="url(#mask0_3146_18012)">
                                            <rect width="30" height="30" fill="#673E2C" />
                                        </g>
                                        <defs>
                                            <pattern id="pattern0_3146_18012" patternContentUnits="objectBoundingBox"
                                                width="1" height="1">
                                                <use xlink:href="#image0_3146_18012" transform="scale(0.0078125)" />
                                            </pattern>
                                            <image id="image0_3146_18012" width="128" height="128"
                                                preserveAspectRatio="none"
                                                xlink:href="data:image/png;base64," />
                                        </defs>
                                    </svg>
                            <p class="font-medium uppercase">
                                {data.meta.date}
                            </p>
                        </div>
                        <div class="flex items-center md:gap-3 gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                                        width="29" height="34" viewBox="0 0 29 34" fill="none"
                                        class="text-primary xl:w-8 md:w-7 w-5.5 h-full">
                                        <mask id="mask0_3146_17999" style="mask-type:alpha" maskUnits="userSpaceOnUse"
                                            x="0" y="0" width="29" height="34">
                                            <rect width="29" height="34" fill="url(#pattern0_3146_17999)" />
                                        </mask>
                                        <g mask="url(#mask0_3146_17999)">
                                            <rect width="29" height="34" fill="currentColor" />
                                        </g>
                                        <defs>
                                            <pattern id="pattern0_3146_17999" patternContentUnits="objectBoundingBox"
                                                width="1" height="1">
                                                <use xlink:href="#image0_3146_17999"
                                                    transform="matrix(0.00228987 0 0 0.00195312 -0.0862069 0)" />
                                            </pattern>
                                            <image id="image0_3146_17999" width="512" height="512"
                                                preserveAspectRatio="none"
                                                xlink:href="data:image/png;base64," />
                                        </defs>
                                    </svg>
                            <p class="uppercase text-primary">
                                Price <span class="text-thunder-100">:{data.meta.price}</span>
                            </p>
                        </div>
                        <div class="flex items-center md:gap-3 gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                                        width="34" height="34" viewBox="0 0 34 34" fill="none"
                                        class="text-primary 1xl:w-7.5 lg:w-7 md:w-6.5 w-5.5 h-full">
                                        <mask id="mask0_3146_18006" style="mask-type:alpha" maskUnits="userSpaceOnUse"
                                            x="0" y="0" width="34" height="34">
                                            <rect width="34" height="34" fill="url(#pattern0_3146_18006)" />
                                        </mask>
                                        <g mask="url(#mask0_3146_18006)">
                                            <rect width="29" height="34" fill="#673E2C" />
                                        </g>
                                        <defs>
                                            <pattern id="pattern0_3146_18006" patternContentUnits="objectBoundingBox"
                                                width="1" height="1">
                                                <use xlink:href="#image0_3146_18006" transform="scale(0.0078125)" />
                                            </pattern>
                                            <image id="image0_3146_18006" width="128" height="128"
                                                preserveAspectRatio="none"
                                                xlink:href="data:image/png;base64," />
                                        </defs>
                                    </svg>
                            <p class="uppercase text-primary">
                                Event Type: <span class="text-thunder-100">{data.meta.eventType}</span>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Program Description -->
                <div data-aos="fade-up">
                    <h3 class="text-primary uppercase 1xl:mb-5 lt:mb-4 mb-3">
                        {data.programDescription.title}
                    </h3>
                    <p>{data.programDescription.description}</p>
                </div>

                <!-- This Program Offers -->
                <div data-aos="fade-up">
                    <h3 class="uppercase text-primary 1xl:mb-6 lt:mb-4 mb-3">
                        {data.programOffers.title}
                    </h3>
                    <ul
                        class="list-disc 1xl:space-y-5 sm:space-y-3.5 space-y-2.5 sm:pl-4.5 pl-4"
                    >
                        {
                            data.programOffers.items.map((item: string) => (
                                <li>
                                    <p class="font-medium">{item}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Experience / Second Program Offers -->
                <div data-aos="fade-up">
                    <h3 class="uppercase text-primary 1xl:mb-6 lt:mb-4 mb-3">
                        {data.experience.title}
                    </h3>
                    {
                        data.experience.intro && (
                            <p class="1xl:mb-5 lt:mb-4 mb-3">
                                {data.experience.intro}
                            </p>
                        )
                    }
                    <ul
                        class="list-disc 1xl:space-y-5 sm:space-y-3.5 space-y-2.5 sm:pl-4.5 pl-4"
                    >
                        {
                            data.experience.items.map((item: string) => (
                                <li>
                                    <p class="font-medium">{item}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Divider -->
                <div
                    class="w-full h-[0.5px] bg-primary/20"
                    data-aos="fade-up"
                ></div>

                <!-- All Are Welcome -->
                <div data-aos="fade-up">
                    <h3 class="text-primary uppercase 1xl:mb-5 lt:mb-4 mb-3">
                        {data.welcome.title}
                    </h3>
                    <p>{data.welcome.description}</p>
                </div>
            </div>

            <!-- Sticky Sidebar -->
            <RetreatDetailSidebar sidebar={data.sidebar} />
        </div>
    </div>
</section>
<!-- ====== End Retreat Detail ====== -->
