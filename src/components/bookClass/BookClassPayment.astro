---
import type { DropdownOption } from '../../data/bookClass';
import { createDropdownValue } from '../../data/bookClass';

interface Props {
    paymentOptions: DropdownOption[];
    gatewayOptions: DropdownOption[];
    planOptions: DropdownOption[];
}

const { paymentOptions, gatewayOptions, planOptions } = Astro.props;
---
                    <!-- Payment Section -->
                    <div>
                        <h3 class="uppercase text-primary mb-5 1xl:pb-7.5 lg:pb-5 pb-3 border-b border-whitesmoke-100">
                            PAYMENT SECTION
                        </h3>

                        <div class="1xl:space-y-10.5 lt:space-y-7 sm:space-y-5 space-y-6">

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                                <!-- Preferred Payment Method * -->
                                <div>
                                    <label class="block p lg:mb-2.5 mb-2">
                                        Preferred Payment Method *
                                    </label>

                                    <div class="relative dropdown pointer-events-auto">
                                        <input type="hidden" name="payment" required>

                                        <!-- Button -->
                                        <button type="button" class="dropdown-btn border-primary/20!">
                                            <p class="dropdown-text p2 font-normal text-thunder-100/50">
                                                Select Payment Method
                                            </p>

                                            <svg class="dropdown-arrow w-5.5 h-5.5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7 10l5 5 5-5"></path>
                                            </svg>
                                        </button>

                                        <!-- Dropdown Menu -->
                                        <div class="dropdown-menu max-h-0 opacity-0 absolute transition-[max-height,opacity] duration-300 ease-in-out">
                                            <ul class="dropdown-list">
                                                {paymentOptions.map((option) => (
                                                    <li class="dropdown-item" data-value={createDropdownValue(option)}>
                                                        <p>{option.label}</p>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Coupon / Promo Code  * -->
                                <div>
                                    <label class="block p lg:mb-2.5 mb-2">
                                        Coupon / Promo Code
                                    </label>

                                    <input
                                        type="text"
                                        placeholder="Add code"
                                        name="coupon"
                                        class="w-full type-filed p2 placeholder:text-thunder-100/35 bg-white border-primary/20! focus:border-primary active:border-primary"
                                    >
                                </div>
                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                                <!-- Plan Type * -->
                                <div>
                                    <label class="block p lg:mb-2.5 mb-2">Plan Type *</label>

                                    <div class="relative dropdown pointer-events-auto">
                                        <input type="hidden" name="plan" required>

                                        <!-- Button -->
                                        <button type="button" class="dropdown-btn border-primary/20!">
                                            <p class="dropdown-text p2 font-normal text-thunder-100/50">
                                                Select Plan
                                            </p>

                                            <svg class="dropdown-arrow w-5.5 h-5.5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7 10l5 5 5-5"></path>
                                            </svg>
                                        </button>

                                        <!-- Dropdown Menu -->
                                        <div class="dropdown-menu max-h-0 opacity-0 absolute transition-[max-height,opacity] duration-300 ease-in-out">
                                            <ul class="dropdown-list">
                                                {planOptions.map((option) => (
                                                    <li class="dropdown-item" data-value={createDropdownValue(option)}>
                                                        <p>{option.label}</p>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Price -->
                                <div>
                                    <label class="block p lg:mb-2.5 mb-2">Price</label>

                                    <input
                                        type="text"
                                        placeholder="Auto-filled"
                                        class="w-full type-filed p2 placeholder:text-thunder-100/35 bg-white border-primary/20!"
                                        disabled
                                    >
                                </div>
                            </div>

                            <!-- Secure Payment Gateway * -->
                            <div>
                                <label class="block p lg:mb-2.5 mb-2">
                                    Secure Payment Gateway *
                                </label>

                                <div class="relative dropdown pointer-events-auto">
                                    <input type="hidden" name="gateway" required>

                                    <!-- Button -->
                                    <button type="button" class="dropdown-btn border-primary/20!">
                                        <p class="dropdown-text p2 font-normal text-thunder-100/50">
                                            Select Gateway
                                        </p>

                                        <svg class="dropdown-arrow w-5.5 h-5.5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7 10l5 5 5-5"></path>
                                        </svg>
                                    </button>

                                    <!-- Dropdown Menu -->
                                    <div class="dropdown-menu max-h-0 opacity-0 absolute transition-[max-height,opacity] duration-300 ease-in-out">
                                        <ul class="dropdown-list">
                                            {gatewayOptions.map((option) => (
                                                <li class="dropdown-item" data-value={createDropdownValue(option)}>
                                                    <p>{option.label}</p>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>


                    <!-- Consent & Terms -->
                    <div>
                        <h3 class="uppercase text-primary mb-5 1xl:pb-7.5 lg:pb-5 pb-3 border-b border-whitesmoke-100">
                            Consent &amp; Terms
                        </h3>

                        <div class="xl:space-y-4 space-y-3">

                            <div class="flex items-center gap-2.5">
                                <input
                                    type="checkbox"
                                    id="condition"
                                    name="condition"
                                    class="accent-primary cursor-pointer 1xl:size-7 xl:size-6.5 lg:size-6 size-5 shrink-0"
                                    required
                                >

                                <label for="condition" class="p2 cursor-pointer">
                                    I agree to the terms &amp; conditions and studio policy.
                                </label>
                            </div>

                            <div class="flex items-center gap-2.5">
                                <input
                                    type="checkbox"
                                    id="information"
                                    name="information"
                                    class="accent-primary cursor-pointer 1xl:size-7 xl:size-6.5 lg:size-6 size-5 shrink-0"
                                    required
                                >

                                <label for="information" class="p2 cursor-pointer">
                                    I confirm my information is accurate
                                </label>
                            </div>

                            <div class="flex items-center gap-2.5">
                                <input
                                    type="checkbox"
                                    id="updates"
                                    name="updates"
                                    class="accent-primary cursor-pointer 1xl:size-7 xl:size-6.5 lg:size-6 size-5 shrink-0"
                                >

                                <label for="updates" class="p2 cursor-pointer">
                                    I’d like to receive yoga tips &amp; class updates (optional)
                                </label>
                            </div>

                        </div>
                    </div>


                    <button type="submit" class="btn btn-primary">
                        <span class="submit-text">Book Membership</span>

                        <span class="submit-loader hidden items-center justify-center gap-2">
                            <span
                                class="inline-block w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"
                            ></span>
                            <span>Submitting...</span>
                        </span>
                    </button>

