---
---
                <div
                    id="booking-success-popup"
                    class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden w-full items-center justify-center z-50 px-4"
                >
                    <div class="relative text-center 1xl:max-w-[850px] xl:max-w-[670px] md:max-w-[600px] max-w-[490px] mx-3 w-full">

                        <button
                            class="popup-close relative flex items-center justify-center 1xl:size-10 md:size-9 sm:size-8 size-7 bg-white rounded-full ml-auto mr-0 1xl:mb-7.5 lt:mb-4.5 mb-2.5"
                        >
                            ✕
                        </button>

                        <div class="bg-white rounded-sm 1xl:px-10 px-4 1xl:py-25 sm:px-8 xl:py-21 md:py-16 sm:py-12 py-6 relative text-center flex items-center flex-col">

                            <div class="sm:mb-4 mb-3 1xl:size-[193px] xl:size-[150px] md:size-[135px] sm:size-[110px] size-[90px]">
                                <img
                                    loading="lazy"
                                    src="/booking-success-icon.svg"
                                    class="w-full h-full"
                                >
                            </div>

                            <h2 class="uppercase text-black 1xl:mb-5 mb-3">
                                BOOKING CONFIRMED.
                            </h2>

                            <p class="1xl:max-w-4/5 xl:max-w-[85%]">
                                Your spot has been successfully reserved. We’ll send you a confirmation email
                                with your class details shortly.
                            </p>

                        </div>
                    </div>
                </div>

