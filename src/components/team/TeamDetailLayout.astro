---
import TeamDetailContact from "./TeamDetailContact.astro";

interface Props {
    data: any;
}

const { data } = Astro.props;

const profile = data.profile;
const background = data.background;
const featuredSpecialty = data.featuredSpecialty;
const specialties = data.specialties;
const contact = data.contact;
---

<!-- ====== Start Page Heading ====== -->
<section
    class="relative 1xl:pt-20 xl:pt-17 lg:pt-14 md:pt-12 sm:pt-11 pt-10 xl:mb-20 lg:mb-16 md:mb-12 sm:mb-11 mb-10 pb-[60px] bg-whitesmoke-100"
>
    <div class="container relative">
        <div
            class="flex flex-col items-center justify-center lt:max-w-[73%] md:max-w-[90%] max-w-full w-full text-center mx-auto space-y-2.5"
        >
            <h1 class="uppercase text-primary text-center" data-aos="fade-up">
                {data.hero.title}
            </h1>
            <p
                class="1xl:max-w-3/4 xl:max-w-[85%] w-full"
                data-aos="fade-up"
            >
                {data.hero.description}
            </p>
        </div>

        <!-- Decorative Flower -->
        <div
            class="pointer-events-none absolute 1xl:-top-20 xl:-top-[65px] lg:-top-[55px] -top-12 left-auto right-0 lg:w-[14.2%] w-[15%] hidden md:block opacity-30"
        >
            <img
                loading="lazy"
                decoding="async"
                src={data.hero.flowerImage}
                alt={data.hero.flowerImageAlt}
                class="w-full h-full object-contain"
            />
        </div>
    </div>
</section>
<!-- ====== End Page Heading ====== -->

<!-- ====== Find Your Flow Section ====== -->
<section
    class="relative bg-white 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10"
>
    <div class="container">
        <div
            class="flex lt:flex-row flex-col-reverse items-stretch 2xl:gap-17.5 1xl:gap-16 xl:gap-12 lg:gap-8 sm:gap-5 gap-3"
            data-aos="fade-up"
        >
            <!-- Right: Content -->
            <div class="lt:w-[57%] w-full my-auto 1xl:py-22 xl:py-8 py-2">
                <h2
                    class="text-primary font-normal uppercase 1xl:mb-5 xl:mb-4 mb-2.5"
                >
                    {profile.name}
                </h2>
                <h3
                    class="text-black font-primary font-medium italic 2xl:mb-12.5 1xl:mb-11 md:mb-5 mb-4"
                >
                    {profile.designation}
                </h3>
                <h3 class="text-primary uppercase 1xl:mb-7.5 xl:mb-5 mb-4">
                    {profile.aboutTitle}
                </h3>
                <div
                    class="1xl:space-y-5 xl:space-y-4 lg:space-y-3 sm:space-y-2 space-y-1"
                >
                    {
                        profile.aboutParagraphs.map((paragraph: string) => (
                            <p>{paragraph}</p>
                        ))
                    }
                </div>
            </div>

            <!-- Left: Image -->
            <div class="lt:w-[43%] w-full h-auto">
                <div
                    class="overflow-hidden rounded-sm relative before:content-[''] before:block before:pt-[100%] w-full h-full"
                >
                    <img
                        loading="lazy"
                        decoding="async"
                        src={profile.image}
                        alt={profile.imageAlt}
                        class="absolute top-0 left-0 w-full h-full object-cover"
                    />
                </div>
            </div>
        </div>

        <div
            class="1xl:space-y-20 lg:space-y-12 space-y-10 1xl:mt-0 xl:mt-3 lt:mt-8 mt-6"
        >
                        <!-- Background & Experience -->
            <div data-aos="fade-up">
                <h3
                    class="uppercase text-primary 1xl:mb-6 lt:mb-4 mb-3"
                >
                    {background.title}
                </h3>
                <ul
                    class="list-disc 1xl:space-y-5 sm:space-y-3.5 space-y-2.5 sm:pl-4.5 pl-4"
                >
                    {
                        background.items.map((item: string) => (
                            <li>
                                <p class="font-medium">{item}</p>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Featured Quote / Specialty -->
            <div data-aos="fade-up">
                <h3
                    class="uppercase text-primary 1xl:mb-6 lt:mb-4 mb-3"
                >
                    {featuredSpecialty.title}
                </h3>
                <div
                    class="1xl:p-7.5 lg:p-6 md:p-5 p-4 bg-whitesmoke-100 font-medium border-l-2 border-primary flex items-start 1xl:gap-7.5 lg:gap-6 lt:gap-5 sm:gap-4 gap-2.5"
                >
                    <div class="shrink-0">
                        <img
                            loading="lazy"
                            src={featuredSpecialty.icon}
                            alt={featuredSpecialty.iconAlt}
                            class="1xl:size-12.5 lg:size-11 sm:size-10 size-7.5 object-contain"
                        />
                    </div>

                    <div>
                        <h5 class="text-primary uppercase md:mb-4 mb-2.5">
                            {featuredSpecialty.quote}
                        </h5>
                        <p>
                            {featuredSpecialty.description}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Specialties -->
            <div data-aos="fade-up">
                <h3
                    class="uppercase text-primary 1xl:mb-6 lt:mb-4 mb-3"
                >
                    {specialties.title}
                </h3>
                <ul
                    class="list-disc text-primary 1xl:space-y-4 lt:space-y-3 space-y-2.5 pl-4.5"
                >
                    {
                        specialties.items.map((item: { title: string; description: string }) => (
                            <li>
                                <p class="text-primary font-medium">{item.title} <span class="text-thunder-100">- {item.description}</span></p>
                            </li>
                        ))
                    }
                </ul>
            </div>

                        <!-- Contact -->
            <div data-aos="fade-up">
                <h3
                    class="uppercase text-primary 1xl:mb-6 lt:mb-4 mb-3"
                >
                    {contact.title}
                </h3>
                <div>
                    <a
                        href={contact.booking.url}
                        class="flex items-center 1xl:gap-4.5 md:gap-3.5 gap-2.5 w-fit group text-primary hover:text-thunder-100"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            width="30"
                            height="30"
                            viewBox="0 0 30 30"
                            fill="none"
                            class="2xl:w-7.5 1xl:w-6.5 lt:w-6 w-5.5 h-full text-primary"
                        >
                            <mask
                                id="mask0_3146_20030"
                                style="mask-type:alpha"
                                maskUnits="userSpaceOnUse"
                                x="0"
                                y="0"
                                width="30"
                                height="30"
                            >
                                <rect
                                    width="30"
                                    height="30"
                                    fill="url(#pattern0_3146_20030)"
                                />
                            </mask>
                            <g mask="url(#mask0_3146_20030)">
                                <rect
                                    width="30"
                                    height="30"
                                    fill="currentColor"
                                />
                            </g>
                            <defs>
                                <pattern
                                    id="pattern0_3146_20030"
                                    patternContentUnits="objectBoundingBox"
                                    width="1"
                                    height="1"
                                >
                                    <use
                                        xlink:href="#image0_3146_20030"
                                        transform="scale(0.0078125)"
                                    />
                                </pattern>
                                <image
                                    id="image0_3146_20030"
                                    width="128"
                                    height="128"
                                    preserveAspectRatio="none"
                                    xlink:href="data:image/png;base64,"
                                />
                            </defs>
                        </svg>
                        <div class="flex items-center 1xl:gap-3 gap-2 w-full">
                            <p
                                class="uppercase font-medium text-primary group-hover:text-thunder-100"
                            >
                                {contact.booking.label}
                            </p>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="31"
                                viewBox="0 0 20 31"
                                fill="none"
                                class="1xl:w-5.5 w-4.5 h-full"
                            >
                                <g clip-path="url(#clip0_3146_20028)">
                                    <path
                                        d="M2.86573 20.6159C2.86573 20.6159 10.8425 12.639 14.165 9.31648M14.165 9.31648L14.4897 17.824M14.165 9.31648L5.65684 8.99236"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </g>
                                <defs>
                                    <clipPath id="clip0_3146_20028">
                                        <rect
                                            y="0.0298199"
                                            width="19.9297"
                                            height="30.9612"
                                            rx="5"
                                            transform="rotate(-0.0857288 0 0.0298199)"
                                            fill="white"
                                        >
                                        </rect>
                                    </clipPath>
                                </defs>
                            </svg>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Contact for Private Sessions -->
            <TeamDetailContact contact={contact} />
        </div>
    </div>
</section>
<!-- ====== End Find Your Flow Section ====== -->
