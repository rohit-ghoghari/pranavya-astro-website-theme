---
import { orderDetails as order } from "../../data/order-detail";
import OrderSummary from "./OrderSummary.astro";
import OrderAddresses from "./OrderAddresses.astro";
import OrderItems from "./OrderItems.astro";
import OrderTotals from "./OrderTotals.astro";
---

<!-- ====== Start Page Heading ====== -->
<section class="relative 1xl:mt-20 xl:mt-17 lg:mt-14 lt:mt-12 sm:mt-9 mt-6 1xl:mb-11 xl:mb-8 sm:mb-7 mb-6">
    <div class="container">
        <div class="flex flex-col items-center justify-center max-w-full w-full text-center mx-auto space-y-2.5">
            <h1 class="uppercase text-primary text-center">
                Thank You! Your Order Has Been Placed.
            </h1>
            <p class="2xl:max-w-[55%] xl:max-w-[64%] lg:max-w-[70%] lt:max-w-4/5 max-w-full">
                Your order has been successfully received and is now being processed. A confirmation email has
                been sent to your registered email address.
            </p>
        </div>
    </div>
</section>
<!-- ====== End Page Heading ====== -->

<!-- ====== Start order-detail ====== -->
<section class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full">
    <div class="container">
        <div class="2xl:space-y-12.5 1xl:space-y-11 xl:space-y-10 md:space-y-8 sm:space-y-7 space-y-5">
            <OrderSummary order={order} />

            <OrderAddresses
                billing={order.billingAddress}
                shipping={order.shippingAddress}
            />

            <div class="flex items-start lt:flex-row flex-col xl:gap-10 lt:gap-6 md:gap-10 sm:gap-8 gap-4">
                <OrderItems
                    products={order.products}
                    giftCard={order.giftCard}
                    totals={order.productTableTotals}
                />

                <OrderTotals
                    totals={order.cartTotals}
                    cartSubtotal={order.cartSubtotal}
                    discountLabel={order.discountLabel}
                    discount={order.discount}
                    grandTotal={order.grandTotal}
                />
            </div>
        </div>
    </div>
</section>
<!-- ====== End order-detail ====== -->
