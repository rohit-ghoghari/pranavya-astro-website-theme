---
interface RelatedBlog {
  title: string;
  slug: string;
  image: string;
  date: string;
}

interface Props {
  recentPosts: RelatedBlog[];
  categories: { name: string; count: number }[];
}

const { recentPosts, categories } = Astro.props;
---

<aside
  class="lt:w-[36%] w-full bg-whitesmoke-100 rounded-sm overflow-hidden 1xl:p-8.5 xl:p-6.5 md:p-5.5 p-4 1xl:space-y-10 xl:space-y-7 sm:space-y-6 space-y-5"
  data-aos="fade-up"
>
  <h5 class="uppercase text-primary xl:pb-5 pb-3.5 border-b border-primary/50">
    Stay in Flow
  </h5>
  <form
    class="relative w-full max-w-full bg-white flex items-center gap-2 1xl:px-6 lg:px-4 px-3 py-0 border border-primary/50 rounded-full newsletter home-4_newsletter"
  >
    <label class="sr-only" for="blog-newsletter-email">Email address</label>
    <input
      id="blog-newsletter-email"
      type="email"
      name="email"
      required
      placeholder="Enter your email address"
      class="p2 lt:py-3 md:py-2.5 py-2 flex-1 w-full text-gray-800 placeholder-gray-500 focus:outline-none"
    />
    <button
      type="submit"
      class="text-black hover:text-primary focus:text-primary active:text-primary h-full"
      aria-label="Subscribe"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="30"
        height="28"
        viewBox="0 0 30 28"
        fill="none"
        class="text-primary hover:text-black sm:size-7.5 size-6.5"
      >
        <path
          d="M10.4585 26.1424L24.1951 7.89726L1.50868 10.5251L4.98048 16.6034L18.9893 10.8805L6.96932 20.074L10.4585 26.1424Z"
          fill="currentColor"
        />
      </svg>
    </button>
  </form>

  <div>
    <h5 class="text-primary uppercase xl:pb-5 pb-3.5 border-b border-primary/50">
      Categories
    </h5>
    <ul class="1xl:mt-7.5 lg:mt-5.5 mt-4 1xl:space-y-5 lg:space-y-4 space-y-3">
      {categories.map((category) => (
        <li class="flex items-center justify-between gap-3 1xl:pb-4 lg:pb-3 pb-2 border-b border-primary/25">
          <p>{category.name}</p>
          <p>({String(category.count).padStart(2, "0")})</p>
        </li>
      ))}
    </ul>
  </div>

  <div>
    <h5 class="text-primary uppercase xl:pb-5 pb-3.5 border-b border-primary/50">
      Recent posts
    </h5>
    <div class="1xl:mt-7.5 lg:mt-5.5 mt-4 1xl:space-y-5 lg:space-y-4 space-y-3">
      {recentPosts.map((recent) => (
        <a
          href={`/blog/${recent.slug}/`}
          class="flex items-center 1xl:gap-5 sm:gap-4 gap-2.5 1xl:pb-5.5 sm:pb-4 pb-3 border-b border-primary/25"
        >
          <div class="1xl:w-[105px] lg:w-[98px] lg:h-[95px] sm:size-[90px] size-16 rounded-sm overflow-hidden shrink-0">
            <img
              loading="lazy"
              src={recent.image}
              alt={recent.title}
              class="w-full h-full object-cover"
            />
          </div>
          <div class="flex flex-col items-start">
            <p class="text-primary">{recent.date}</p>
            <p class="1xl:w-[85%] w-full">{recent.title}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="flex sm:items-center items-start sm:flex-row flex-col xl:gap-5 lg:gap-4 lt:gap-2 sm:gap-3 gap-1.5">
    <h5 class="uppercase text-primary">Follow :</h5>
    <div class="flex items-center flex-wrap 1xl:gap-7.5 xl:gap-6 lg:gap-3.5 lt:gap-2.5 gap-3">
      <a
        href="https://www.instagram.com/"
        target="_blank"
        rel="noreferrer"
        aria-label="Instagram"
        class="1xl:size-12 lg:size-11 size-9.5 lg:p-[10px] sm:p-[9px] p-2 btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="1xl:w-[26px] 1xl:h-[26px] w-5 h-5" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2" />
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
        </svg>
      </a>
      <a
        href="https://x.com/?lang=en"
        target="_blank"
        rel="noreferrer"
        aria-label="X"
        class="1xl:size-12 lg:size-11 size-9.5 lg:p-[10px] sm:p-[9px] p-2 btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 22 22" class="1xl:w-[22px] 1xl:h-[22px] w-5 h-5" fill="currentColor" aria-hidden="true">
          <path d="M16.84 1.65h3.17l-6.93 7.92 8.15 10.78h-6.38l-5-6.54-5.72 6.54H.96l7.41-8.47L.55 1.65h6.55l4.52 5.97zm-1.11 16.8h1.76L6.14 3.45H4.25z" />
        </svg>
      </a>
      <a
        href="https://www.facebook.com/"
        target="_blank"
        rel="noreferrer"
        aria-label="Facebook"
        class="1xl:size-12 lg:size-11 size-9.5 lg:p-[10px] sm:p-[9px] p-2 btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="xl:w-[26px] xl:h-[26px] w-6 h-6" fill="currentColor" aria-hidden="true">
          <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.04 15.94 2 14.64 2 11.93 2 10 3.66 10 6.7v2.8H7v4h3V22h4z" />
        </svg>
      </a>
      <a
        href="https://www.youtube.com/"
        target="_blank"
        rel="noreferrer"
        aria-label="YouTube"
        class="1xl:size-12 lg:size-11 size-9.5 lg:p-[10px] sm:p-[9px] p-2 btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="xl:w-[26px] xl:h-[26px] w-6 h-6" fill="currentColor" aria-hidden="true">
          <path d="m10 15 5.19-3L10 9z" />
          <path d="M21.56 7.17c-.13-.47-.5-1.48-1.4-1.73C19.13 5.16 12 5.16 12 5.16s-7.13 0-8.16.28c-.9.25-1.27 1.26-1.4 1.73C2.16 8.2 2 9.81 2 12s.16 3.8.44 4.83c.13.47.5 1.48 1.4 1.73 1.03.28 8.16.28 8.16.28s7.13 0 8.16-.28c.9-.25 1.27-1.26 1.4-1.73.28-1.03.44-2.64.44-4.83s-.16-3.8-.44-4.83" />
        </svg>
      </a>
    </div>
  </div>
</aside>
