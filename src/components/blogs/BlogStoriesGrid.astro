interface BlogCard {
    date: string;
    title: string;
    description: string;
    image: string;
    imageAlt?: string;
    badge: string;
}

interface Props {
    cards?: BlogCard[];
    initialCount?: number;
    loadCount?: number;
}

const {
    cards = [
        {
            date: "July 10, 2025",
            title: "Breathwork Basics: The Power of Pranayama",
            description:
                "Learn how conscious breathing techniques can reduce stress, improve focus, and enhance vitality.",
            image: "/class-stories-1.webp",
            imageAlt: "Yoga",
            badge: "Yoga Tips",
        },
        {
            date: "July 10, 2025",
            title: "5 Morning Yoga Poses to Start Fresh",
            description:
                "Jumpstart your day with energizing asanas that awaken your body and focus your mind.",
            image: "/class-stories-2.webp",
            imageAlt: "Yoga",
            badge: "Yoga Tips",
        },
        {
            date: "August 5, 2025",
            title: "Sun Salutation Sequence for Beginners",
            description:
                "Discover a step-by-step guide to this energizing flow that improves flexibility, strength, and balance.",
            image: "/class-stories-3.webp",
            imageAlt: "Yoga",
            badge: "Morning Flow",
        },
        {
            date: "August 15, 2025",
            title: "Yoga for Desk Workers: Stretch Away Stiffness",
            description:
                "Simple seated and standing stretches to ease tension in your neck, shoulders, and lower back.",
            image: "/class-stories-4.webp",
            imageAlt: "Yoga",
            badge: "Wellness at Work",
        },
        {
            date: "September 2, 2025",
            title: "Balancing Poses: Find Your Balance",
            description:
                "Enhance stability, posture, and concentration with easy-to-learn balancing postures.",
            image: "/class-stories-5.webp",
            imageAlt: "Yoga",
            badge: "Balance & Stability",
        },
        {
            date: "September 18, 2025",
            title: "Gentle Morning Stretches for Vitality",
            description:
                "Wake up your body with soft stretches that increase circulation and boost mood.",
            image: "/class-stories-6.webp",
            imageAlt: "Yoga",
            badge: "Energizing Flows",
        },
        {
            date: "October 1, 2025",
            title: "Restorative Yoga: Relax and Recharge",
            description:
                "Slow, supported poses to help release deep tension and calm the mind after a busy day.",
            image: "/class-stories-7.webp",
            imageAlt: "Yoga",
            badge: "Deep Relaxation",
        },
        {
            date: "October 20, 2025",
            title: "Core Strength for a Healthier Back",
            description:
                "Strengthen your abdominal muscles to protect your spine and improve posture.",
            image: "/class-stories-8.webp",
            imageAlt: "Yoga",
            badge: "Core & Strength",
        },
        {
            date: "October 5, 2025",
            title: "Morning Awakening Sunrise Yoga: Start with Stillness",
            description:
                "Greet the day with intention through gentle, flowing movements that awaken the body and clear the mind.",
            image: "/class-stories-9.webp",
            imageAlt: "Yoga",
            badge: "Mental Clarity",
        },
        {
            date: "August 15, 2025",
            title: "Yoga for Focus and Mental Clarity",
            description:
                "Struggling with scattered thoughts or digital fatigue? Discover how breath-led movement and grounding postures.",
            image: "/nav-blog-2.webp",
            imageAlt: "Yoga",
            badge: "Mental Clarity",
        },
        {
            date: "October 14, 2024",
            title: "Release & Let GoEvening Flow: Unwind from Stress",
            description:
                "Melt away tension with a calming evening sequence designed to soothe your nervous system.",
            image: "/class-stories-11.webp",
            imageAlt: "Yoga",
            badge: "Balance & Stability",
        },
        {
            date: "September 20, 2025",
            title: "Find Inner Peace Yoga Nidra: Deep Rest for the Soul",
            description:
                "Yoga Nidra, or yogic sleep, guides you into a state of conscious rest that helps reset your body and calm your mind.",
            image: "/class-stories-12.webp",
