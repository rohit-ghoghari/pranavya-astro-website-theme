---

<section class="relative bg-white 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10">
    <div class="container">

        <div
            id="blog-cards-grid"
            class="grid lt:grid-cols-2 grid-cols-1 1xl:gap-12.5 xl:gap-9 sm:gap-6 gap-4"
        >
            {cards.map((card, index) => (
                <div
                    class="blog-card rounded-sm bg-white border border-[#673E2C80] overflow-hidden w-full"
                    data-aos="fade-up"
                    data-card-index={index}
                    style={index >= initialCount ? "display: none;" : undefined}
                >
                    <div class="flex sm:flex-row flex-col justify-between 1xl:gap-7 xl:gap-6 sm:gap-4 gap-5 1xl:p-7 xl:p-5 lt:p-4 md:p-6 p-4 items-stretch h-full">

                        <!-- Left Content -->
                        <div class="sm:w-[55%] w-full my-auto flex flex-col items-start">

                            <!-- Date -->
                            <div class="flex items-center xl:gap-[10px] gap-2 1xl:mb-6 mb-4">
                                <div class="1xl:w-[30px] 1xl:h-[30px] xl:w-[28px] xl:h-[28px] w-[26px] h-[26px] p-1 rounded-sm bg-primary flex items-center justify-center">

                                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                            <mask id="mask0_3632_4866" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="20" height="20">
                                                <rect width="20" height="20" fill="url(#pattern0_3632_4866)"></rect>
                                            </mask>
                                            <g mask="url(#mask0_3632_4866)">
                                                <rect width="20" height="20" fill="white"></rect>
                                            </g>
                                            <defs>
                                                <pattern id="pattern0_3632_4866" patternContentUnits="objectBoundingBox" width="1" height="1">
                                                    <use xlink:href="#image0_3632_4866" transform="scale(0.00195312)"></use>
                                                </pattern>
                                                <image id="image0_3632_4866" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"></image>
                                            </defs>
                                        </svg>
                                </div>

                                <span class="uppercase p2 text-black">
                                    {card.date}
                                </span>
                            </div>

                            <!-- Title -->
                            <a href={blogHref(card.title)}>
                                <h3 class="uppercase text-primary 1xl:mb-5 xl:mb-4 mb-3 hover:text-thunder-100">
                                    {card.title}
                                </h3>
                            </a>

                            <!-- Description -->
                            <p class="1xl:mb-11 xl:mb-8 sm:mb-6 mb-5">
                                {card.description}
                            </p>

                            <!-- Read More -->
                            <a
                                href={blogHref(card.title)}
                                class="p2 font-normal btn-link uppercase hover:text-primary text-black leading-[100%]"
                            >
                                Read more

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="13"
                                    height="13"
                                    viewBox="0 0 13 13"
                                    class="sm:w-[13px] sm:h-[13px] w-[11px] h-[11px]"
                                    fill="none"
                                >
                                    <path
                                        d="M0.750055 11.9871L11.5781 1.15908M11.5781 1.15908C11.8347 1.4157 11.9911 1.77255 11.9871 2.1668L11.9095 9.8493M11.5781 1.15908C11.3215 0.902467 10.9646 0.746093 10.5704 0.750076L2.88787 0.827704"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </a>
                        </div>

                        <!-- Right Image -->
                        <div class="relative lt:w-[45%] sm:w-[38%] block overflow-hidden rounded-sm">
                            <div class="relative shrink-0 before:content-[''] before:pt-[100%] before:block h-full overflow-hidden">

                                <img
                                    loading="lazy"
                                    src={card.image}
                                    alt={card.imageAlt || card.title}
                                    class="w-full h-full object-cover absolute top-0 left-0"
                                />

                                <!-- Badge -->
                                <p class="absolute 1xl:top-4 1xl:right-4 xl:top-3 p2 xl:right-3 top-2.5 right-2.5 bg-white text-[#6b3f2b] 1xl:px-[18px] xl:px-[14px] px-3 xl:py-[3px] py-[2px] rounded-full">
                                    {card.badge}
                                </p>

                            </div>
                        </div>

                    </div>
                </div>
            ))}
        </div>

        <!-- Reveal More -->
        <button
            id="reveal-more-btn"
            type="button"
            class="2xl:mt-12.5 1xl:mt-12 xl:mt-11 lg:mt-10 md:mt-9 sm:mt-8 mt-7.5 btn reveal-more flex items-center justify-center mx-auto gap-4"
            aria-label="Reveal more blog posts"
        >
            <span>Reveal More</span>

            <img
                loading="lazy"
                src="/loading.svg"
                alt="load"
                class="1xl:size-7.5 xl:size-6.5 size-5.5 animate-spin mx-auto"
            />
        </button>

    </div>
</section>

<script define:vars={{ initialCount, loadCount }}>
    const grid = document.querySelector("#blog-cards-grid");
    const revealButton = document.querySelector("#reveal-more-btn");

    if (grid && revealButton) {
        const cards = Array.from(
            grid.querySelectorAll(".blog-card")
        );

        let visibleCount = initialCount;

        const updateRevealButton = () => {
            if (visibleCount >= cards.length) {
                revealButton.style.display = "none";
            } else {
                revealButton.style.display = "flex";
            }
        };

        revealButton.addEventListener("click", () => {
            const nextVisibleCount = Math.min(
                visibleCount + loadCount,
                cards.length
            );

            for (let i = visibleCount; i < nextVisibleCount; i++) {
                const card = cards[i];

                if (card) {
                    card.style.display = "";
                }
            }

            visibleCount = nextVisibleCount;

            updateRevealButton();

            // Re-trigger AOS animation for newly revealed cards
            if (window.AOS) {
                window.AOS.refreshHard();
            }
        });

        updateRevealButton();
    }
</script>