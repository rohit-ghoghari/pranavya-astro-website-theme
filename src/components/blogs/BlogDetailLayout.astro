---
import BlogSidebar from "./BlogSidebar.astro";
import BlogCommentsSection from "./BlogCommentsSection.astro";
import "../../styles/blogDetail.css";

interface BlogPost {
  title: string;
  slug: string;
  excerpt: string;
  image: string;
  date: string;
  category: string;
  tags: string[];
  author: string;
  authorImage: string;
}

interface RelatedBlog extends BlogPost {}

interface Props {
  post: BlogPost;
  recentPosts: RelatedBlog[];
  categories: { name: string; count: number }[];
}

const { post, recentPosts, categories } = Astro.props;
---

<main class="h-full 2xl:pt-20.5 xl:pt-19.5 lg:pt-16.5 md:pt-14 sm:pt-13 pt-10">
  <section
    class="relative 1xl:pt-20 xl:pt-17 lg:pt-14 md:pt-12 sm:pt-11 pt-10 xl:mb-20 lg:mb-16 md:mb-12 sm:mb-11 mb-10 pb-[60px] bg-whitesmoke-100"
  >
    <div class="container relative">
      <div
        class="flex flex-col items-center justify-center lt:max-w-[73%] md:max-w-[90%] max-w-full w-full text-center mx-auto space-y-2.5"
      >
        <h1 class="uppercase text-primary text-center" data-aos="fade-up">
          {post.title}
        </h1>
        <p
          class="1xl:max-w-[63%] xl:max-w-[73%] lg:max-w-4/5 w-full"
          data-aos="fade-up"
        >
          {post.excerpt}
        </p>
      </div>

      <div
        class="pointer-events-none absolute 1xl:-top-20 xl:-top-[65px] lg:-top-[55px] -top-12 left-auto right-0 lg:w-[14.2%] w-[15%] hidden md:block opacity-30"
      >
        <img
          loading="lazy"
          decoding="async"
          src="/flower-shape.svg"
          alt="decor"
          class="w-full h-full object-contain"
        />
      </div>
    </div>
  </section>

  <section
    class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full"
  >
    <div class="container">
      <div
        class="w-full aspect-[35/12] overflow-hidden 1xl:mb-11 xl:mb-9 md:mb-7 mb-5"
        data-aos="fade-up"
      >
        <img
          loading="lazy"
          src={post.image}
          alt={post.title}
          class="w-full h-full object-cover"
        />
      </div>

      <div class="flex items-start lt:flex-row flex-col 1xl:gap-15 xl:gap-12 lg:gap-10 lt:gap-6 gap-4">
        <article class="lt:w-[64%] w-full 2xl:space-y-12.5 1xl:space-y-11 md:space-y-7 space-y-4">
          <div data-aos="fade-up" class="blog-article-content">
            <h3 class="text-primary uppercase 1xl:mb-5 lt:mb-4 mb-3">
              {post.title}
            </h3>
            <slot />
          </div>

          <div class="pt-5 border-t border-primary/25" data-aos="fade-up">
            <p class="text-primary font-medium">{post.date}</p>
            <div class="flex items-center gap-3 mt-2">
              <img
                loading="lazy"
                src={post.authorImage}
                alt={post.author}
                class="size-10 rounded-full object-cover"
              />
              <p>By {post.author}</p>
            </div>
            <div class="flex flex-wrap gap-2.5 mt-4">
              <span class="inline-block border border-primary/30 rounded-4xl text-primary px-3 py-1">
                {post.category}
              </span>
              {post.tags.map((tag) => (
                <span class="inline-block border border-primary/30 rounded-4xl text-primary px-3 py-1">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>

        <BlogSidebar recentPosts={recentPosts} categories={categories} />
      </div>
    </div>
  </section>

  <BlogCommentsSection />
</main>

<script src="./blogCommentsScript.ts"></script>
