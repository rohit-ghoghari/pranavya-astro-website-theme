---
import EventDetailHighlights from "./EventDetailHighlights.astro";
import EventDetailOrganization from "./EventDetailOrganization.astro";

interface Props {
    data: any;
}

const { data } = Astro.props;

const feedback = data.feedback;
const programHighlights = data.programHighlights ?? [];
---

<!-- ====== Start Page Heading ====== -->
<section
    class="relative 1xl:pt-20 xl:pt-17 lg:pt-14 md:pt-12 sm:pt-11 pt-10 xl:mb-20 lg:mb-16 md:mb-12 sm:mb-11 mb-10 pb-[60px] bg-whitesmoke-100"
>
    <div class="container relative">
        <div
            class="flex flex-col items-center justify-center lt:max-w-[73%] md:max-w-[90%] max-w-full w-full text-center mx-auto space-y-2.5"
        >
            <h1
                class="uppercase text-primary text-center"
                data-aos="fade-up"
            >
                {data.hero.title}
            </h1>

            <p data-aos="fade-up">
                {data.hero.description}
            </p>
        </div>

        <!-- Decorative Flower -->
        <div
            class="pointer-events-none absolute 1xl:-top-20 xl:-top-[65px] lg:-top-[55px] -top-12 left-auto right-0 lg:w-[14.2%] w-[15%] hidden md:block opacity-30"
        >
            <img
                loading="lazy"
                decoding="async"
                src="/flower-shape.svg"
                alt="decor"
                class="w-full h-full object-contain"
            />
        </div>
    </div>
</section>
<!-- ====== End Page Heading ====== -->


<!-- ====== Start video ====== -->
<section
    class="relative xl:mb-20 lg:mb-16 md:mb-12 sm:mb-11 mb-10 "
>
    <div class="container">
        <div
            class="2xl:h-[682px] 1xl:h-[640px] xl:h-[530px] lg:h-[475px] lt:h-[410px] md:h-[370px] sm:h-[310px] h-[230px] relative "
        >
            <video
                id="eventVideo"
                class="w-full rounded-sm overflow-hidden h-full object-cover"
                controls
                preload="metadata"
                poster={data.video.poster}
            >
                <source
                    src={data.video.source}
                    type="video/mp4"
                />
            </video>

            <!-- Video Play Button Overlay -->
            <div
                class="video-play flex justify-center absolute top-0 m-auto w-full h-full items-center pointer-events-none"
            >
                <div
                    class="pointer-events-auto relative inline-flex items-center justify-center 2xl:w-25 2xl:h-25 1xl:w-24 1xl:h-24 xl:w-22 xl:h-22 lg:w-20 lg:h-20 md:w-18 md:h-18 sm:w-16 sm:h-16 w-13.5 h-13.5 rounded-full bg-white/50 md:p-[7px] p-1 cursor-pointer"
                >
                    <div
                        class="absolute inset-0 animate-ping w-full h-full rounded-full bg-white/50"
                    ></div>
                    <span
                        class="relative w-full h-full rounded-full bg-white flex items-center justify-center md:p-[5px] p-[3px]"
                    >
                        <span
                            class="w-full h-full rounded-full bg-white flex items-center justify-center md:border-2 border border-primary transition-all decoration-300"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                class="2xl:size-9 1xl:size-8 xl:size-7.5 lg:size-6.5 sm:size-5.5 size-5 group-hover/video_popup:text-thunder-100 text-primary transition-all decoration-300"
                            >
                                <path
                                    fill="currentColor"
                                    d="M21.409 9.353a2.998 2.998 0 0 1 0 5.294L8.597 21.614C6.534 22.737 4 21.277 4 18.968V5.033c0-2.31 2.534-3.769 4.597-2.648z"
                                    stroke-width="0.5"
                                    stroke="currentColor"
                                />
                            </svg>
                        </span>
                    </span>
                </div>
            </div>

            <!-- Date Badge -->
            <div
                class="absolute 1xl:top-6 1xl:right-6 xl:top-4 xl:right-4 lg:top-3 lg:right-3 sm:top-2 sm:right-2 top-1.5 right-1.5 bg-white shadow-md rounded-full xl:px-5.5 lg:px-5 sm:px-4 px-3 lg:py-2 py-1.5 leading-[15px] flex items-center lg:gap-[9px] gap-1.5"
            >
                <!-- Calendar icon -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    class="1xl:w-[21px] sm:w-4.5 w-3.5 h-full text-primary"
                >
                    <path
                        d="M7 2V5M17 2V5M3.5 9H20.5M5 4H19C20.1046 4 21 4.89543 21 6V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V6C3 4.89543 3.89543 4 5 4Z"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                    />
                    <path
                        d="M7 13H7.01M12 13H12.01M17 13H17.01M7 17H7.01M12 17H12.01"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                    />
                </svg>

                <span class="sm:text-14 text-xs font-medium uppercase">
                    {data.event.date}
                </span>
            </div>

        </div>

        <!-- Event Metadata -->
        <div class="1xl:mt-7.5 lg:mt-6.5 md:mt-5.5 mt-4.5">
            <div
                class="flex md:flex-row flex-col md:items-center items-start justify-start 2xl:gap-5 lt:gap-3 gap-2 md:divide-x divide-primary"
            >
                <!-- Location -->
                <div
                    class="flex items-center lg:gap-2 gap-1.5 1xl:pr-5 lt:pr-3 md:pr-2"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="30"
                        height="30"
                        viewBox="0 0 16 16"
                        class="text-primary 2xl:w-7.5 2xl:h-7.5 lg:w-6.5 lg:h-6.5 lt:w-6 lt:h-6 w-5.5 h-5.5"
                    >
                        <path
                            fill="currentColor"
                            fill-rule="evenodd"
                            d="M8 1a5 5 0 0 0-5 5c0 1.14.56 2.488 1.377 3.934c.827 1.463 1.967 3.107 3.216 4.857l.407.57l.407-.57c1.25-1.75 2.389-3.394 3.216-4.857C12.44 8.488 13 7.14 13 6a5 5 0 0 0-5-5m0 2.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 0 0 0-5"
                            clip-rule="evenodd"
                        />
                    </svg>

                    <p class="font-medium">
                        {data.event.location}
                    </p>
                </div>

                <!-- Time -->
                <div
                    class="flex items-center lg:gap-2 gap-1.5 1xl:pr-5 lt:pr-3 md:pr-2"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="30"
                        height="30"
                        viewBox="0 0 24 24"
                        fill="none"
                        class="text-primary 2xl:w-7.5 2xl:h-7.5 lg:w-6.5 lg:h-6.5 lt:w-6 lt:h-6 w-5.5 h-5.5"
                    >
                        <circle
                            cx="12"
                            cy="12"
                            r="8.5"
                            stroke="currentColor"
                            stroke-width="1.5"
                        />
                        <path
                            d="M12 7V12L15.5 14"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>

                    <p class="font-medium">
                        {data.event.time}
                    </p>
                </div>

                <!-- Participants -->
                <div
                    class="flex items-center lg:gap-2 gap-1.5 1xl:pr-5 lt:pr-3 md:pr-2 last:pr-0"
                >
                    <img
                        loading="lazy"
                        src="/person-group.svg"
                        alt="pin"
                        class="2xl:w-7.5 2xl:h-7.5 lg:w-6.5 lg:h-6.5 lt:w-6 lt:h-6 w-5.5 h-5.5"
                    />

                    <p class="font-medium">
                        {data.event.participants}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ====== End video ====== -->

<!-- ====== Highlights and Feedback Sections ====== -->
<EventDetailHighlights
    about={data.about}
    programHighlights={programHighlights}
    highlightImage={data.highlightImage}
    feedback={feedback}
/>

<!-- ====== Event Organizing Section ====== -->
<EventDetailOrganization
    organization={data.organization}
    participants={data.event.participants}
/>

<script src="./eventVideoScript.ts"></script>