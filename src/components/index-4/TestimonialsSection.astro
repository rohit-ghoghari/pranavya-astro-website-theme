---
import { defaultTestimonialsIndex4, type Testimonial } from "../../data/testimonialsIndex4";

export type { Testimonial };

interface Props {
    eyebrow?: string;
    title?: string;
    description?: string;
    testimonials?: Testimonial[];
}

const {
    eyebrow = "What Our Members Say",
    title = "Inspired by Experience.",
    description =
        "Every testimonial is a testament to personal growth, emotional healing, and inner strength.",
    testimonials = defaultTestimonialsIndex4,
} = Astro.props;
---

<section
    class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 overflow-hidden home-4_reviews"
>
    <div class="container relative">

        <!-- Intro -->
        <div
            class="flex flex-row justify-between items-center w-full sm:gap-8 gap-5 2xl:mb-[50px] 1xl:mb-11 xl:mb-8.5 sm:mb-8 mb-5"
        >
            <div>
                <h3
                    class="text-thunder-100 font-primary italic font-medium 2xl:mb-7.5 1xl:mb-6 md:mb-4 sm:mb-3 mb-2.5"
                >
                    {eyebrow}
                </h3>

                <h2
                    class="text-primary font-normal uppercase 1xl:mb-5 sm:mb-3.5 mb-2.5"
                >
                    {title}
                </h2>

                <p class="text-thunder-100 lt:max-w-[90%] w-full">
                    {description}
                </p>
            </div>

            <!-- Desktop Navigation -->
            <div
                class="2xl:w-[123px] xl:w-[105px] lt:w-[95px] md:w-[85px] w-[80px] shrink-0 relative md:flex hidden items-center justify-between right-0 z-10"
            >
                <button
                    type="button"
                    class="slider-custom-arrow testimonial-prev"
                    aria-label="Previous testimonial"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="18"
                        viewBox="0 0 22 18"
                        fill="none"
                        class="custom-navigation-icon"
                    >
                        <path
                            d="M20.9741 8.80684C20.9741 8.80684 6.87288 8.80675 0.999486 8.80669M0.999486 8.80669L8.23218 16.6134M0.999486 8.80669L8.23321 1"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        ></path>
                    </svg>
                </button>

                <button
                    type="button"
                    class="slider-custom-arrow testimonial-next"
                    aria-label="Next testimonial"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="18"
                        viewBox="0 0 22 18"
                        fill="none"
                        class="custom-navigation-icon rotate-180"
                    >
                        <path
                            d="M20.9741 8.80684C20.9741 8.80684 6.87288 8.80675 0.999486 8.80669M0.999486 8.80669L8.23218 16.6134M0.999486 8.80669L8.23321 1"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        ></path>
                    </svg>
                </button>
            </div>
        </div>


        <div>
            <!-- Swiper -->
            <div class="swiper home-4_testimonial">
                <div class="swiper-wrapper">

                    {
                        testimonials.map((testimonial) => (
                            <div class="swiper-slide h-auto! bg-whitesmoke-100">

                                <div class="2xl:p-10 1xl:p-8 xl:p-7 lg:p-6 p-5">

                                    <div
                                        class="1xl:mb-10 xl:mb-8 sm:mb-6 mb-5"
                                    >
                                        <h3
                                            class="italic font-medium 1xl:mb-11.5 xl:mb-8.5 md:mb-7 sm:mb-6 mb-4 font-primary text-primary"
                                        >
                                            {testimonial.quoteTitle}
                                        </h3>

                                        <p
                                            class="md:mb-3 sm:mb-2 mb-1 font-medium"
                                        >
                                            {testimonial.text}
                                        </p>

                                        <svg
                                            width="39"
                                            height="31"
                                            viewBox="0 0 39 31"
                                            fill="none"
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="ml-auto mr-0 lt:w-10 lt:h-7.5 md:w-9 md:h-6.5 sm:w-7 sm:h-5.5 w-5 h-4"
                                        >
                                            <path
                                                d="M14.8967 0C16.2954 0.349687 17.2046 1.46868 17.6242 3.35699C15.596 4.47599 13.5329 6.15449 11.4348 8.39249C9.33665 10.6305 7.86796 13.0783 7.02871 15.7359H7.34343C10.0011 15.7359 12.0642 16.4353 13.5329 17.834C15.0715 19.1628 15.8408 20.9113 15.8408 23.0793C15.8408 25.1075 15.0715 26.821 13.5329 28.2198C12.0642 29.6185 10.2808 30.3179 8.18268 30.3179C5.66493 30.3179 3.67171 29.4437 2.20303 27.6952C0.734343 25.8768 0 23.7088 0 21.191C0 16.9249 1.36378 13.1133 4.09134 9.75627C6.8189 6.39927 10.4207 3.14718 14.8967 0ZM35.8779 0C37.2766 0.349687 38.1858 1.46868 38.6055 3.35699C36.5773 4.47599 34.5141 6.15449 32.416 8.39249C30.3179 10.6305 28.8492 13.0783 28.0099 15.7359H28.3247C30.9823 15.7359 33.0454 16.4353 34.5141 17.834C36.0527 19.1628 36.8221 20.9113 36.8221 23.0793C36.8221 25.1075 36.0527 26.821 34.5141 28.2198C33.0454 29.6185 31.262 30.3179 29.1639 30.3179C26.6462 30.3179 24.6529 29.4437 23.1843 27.6952C21.7156 25.8768 20.9812 23.7088 20.9812 21.191C20.9812 16.9249 22.345 13.1133 25.0726 9.75627C27.8001 6.39927 31.4019 3.14718 35.8779 0Z"
                                                fill="#673E2C"
                                            ></path>
                                        </svg>
                                    </div>


                                    <div
                                        class="border-t-2 border-[#673e2c2b] 1xl:pt-7.5 xl:pt-6 sm:pt-5 pt-4 flex items-center justify-between w-full flex-wrap xl:gap-3 gap-2.5"
                                    >

                                        <div
                                            class="flex items-center 1xl:gap-4 md:gap-2.5 sm:gap-2 gap-1.5"
                                        >
                                            <div
                                                class="1xl:w-12.5 1xl:h-12.5 xl:w-11.5 xl:h-11.5 md:w-10 md:h-10 sm:w-[35px] sm:h-[35px] w-7 h-7 rounded-full overflow-hidden"
                                            >
                                                <img
                                                    loading="lazy"
                                                    src={testimonial.image}
                                                    alt={testimonial.imageAlt}
                                                    class="w-full h-full object-cover"
                                                    decoding="async"
                                                />
                                            </div>

                                            <p
                                                class="p2 text-black uppercase"
                                            >
                                                {testimonial.name}
                                            </p>
                                        </div>


                                        <div
                                            class="flex items-center 1xl:gap-2.5 md:gap-2 gap-1"
                                        >
                                            {
                                                Array.from({
                                                    length: testimonial.rating ?? 5,
                                                }).map(() => (
                                                    <img
                                                        loading="lazy"
                                                        src="/yellow-star.svg"
                                                        alt="star"
                                                        class="1xl:w-5.5 xl:w-5 sm:w-4 w-3.5 h-full object-contain"
                                                    />
                                                ))
                                            }
                                        </div>

                                    </div>

                                </div>

                            </div>
                        ))
                    }

                </div>
            </div>


            <!-- Mobile Navigation -->
            <div
                class="w-[80px] shrink-0 relative mx-auto mt-6 flex md:hidden items-center justify-between right-0 z-10"
            >
                <button
                    type="button"
                    class="slider-custom-arrow testimonial-prev"
                    aria-label="Previous testimonial"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="18"
                        viewBox="0 0 22 18"
                        fill="none"
                        class="custom-navigation-icon"
                    >
                        <path
                            d="M20.9741 8.80684C20.9741 8.80684 6.87288 8.80675 0.999486 8.80669M0.999486 8.80669L8.23218 16.6134M0.999486 8.80669L8.23321 1"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        ></path>
                    </svg>
                </button>

                <button
                    type="button"
                    class="slider-custom-arrow testimonial-next"
                    aria-label="Next testimonial"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="18"
                        viewBox="0 0 22 18"
                        fill="none"
                        class="custom-navigation-icon rotate-180"
                    >
                        <path
                            d="M20.9741 8.80684C20.9741 8.80684 6.87288 8.80675 0.999486 8.80669M0.999486 8.80669L8.23218 16.6134M0.999486 8.80669L8.23321 1"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        ></path>
                    </svg>
                </button>
            </div>
        </div>

    </div>
</section>

<style is:global>
    .home-4_reviews .slider-custom-arrow {
        cursor: pointer;
        pointer-events: auto;
    }
    .home-4_reviews .slider-custom-arrow.is-disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
</style>

<script src="./testimonialsFourScript.ts"></script>