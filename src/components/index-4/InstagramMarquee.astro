<section
    class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 overflow-hidden marquee-slider-4"
>
    <div
        class="2xl:space-y-[50px] 1xl:space-y-11 xl:space-y-[38px] sm:space-y-8 md:space-y-5 space-y-3.5"
    >

        <!-- TOP SLIDER -->
        <div class="overflow-hidden">
            <div
                class="marquee-track animate-slide-left"
                data-marquee=""
            >

                {
                    topImages.map((item) => (
                        <div class="slider-img">

                            <a
                                href={item.link ?? "https://www.instagram.com/"}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="relative group cursor-pointer"
                            >

                                <img
                                    loading="lazy"
                                    src={item.image}
                                    alt={item.alt ?? "Instagram image"}
                                    class="w-full h-full object-cover object-center"
                                />

                                <div
                                    class="absolute inset-0 bg-linear-to-b from-primary/0 to-primary/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
                                >
                                    <div
                                        class="bg-white rounded-full overflow-hidden sm:size-12 size-10 flex items-center justify-center"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            class="sm:w-6 sm:h-6 w-5 h-5"
                                            fill="none"
                                        >
                                            <path
                                                d={instagramPath}
                                                fill="#673e2c"
                                            ></path>
                                        </svg>
                                    </div>
                                </div>

                            </a>

                        </div>
                    ))
                }

            </div>
        </div>


        <!-- BOTTOM SLIDER -->
        <div class="overflow-hidden">
            <div
                class="marquee-track animate-slide-right"
                data-marquee=""
            >

                {
                    bottomImages.map((item) => (
                        <div class="slider-img">

                            <a
                                href={item.link ?? "https://www.instagram.com/"}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="relative group cursor-pointer"
                            >

                                <img
                                    loading="lazy"
                                    src={item.image}
                                    alt={item.alt ?? "Instagram image"}
                                    class="w-full h-full object-cover object-center"
                                />

                                <div
                                    class="absolute inset-0 bg-linear-to-b from-primary/0 to-primary/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
                                >
                                    <div
