                                                d={instagramPath}
                                                fill="#673e2c"
                                            ></path>
                                        </svg>
                                    </div>
                                </div>

                            </a>

                        </div>
                    ))
                }

            </div>
        </div>

    </div>
</section>


<style>
    /*
     * Keep the original marquee classes:
     * animate-slide-left
     * animate-slide-right
     *
     * These animations make the two rows move continuously.
     */

    .marquee-track {
        display: flex;
        width: max-content;
        will-change: transform;
    }

    .marquee-track:hover {
        animation-play-state: paused;
    }

    .marquee-track.animate-slide-left {
        animation: marquee-left 30s linear infinite;
    }

    .marquee-track.animate-slide-right {
        animation: marquee-right 30s linear infinite;
    }

    @keyframes marquee-left {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    @keyframes marquee-right {
        from {
            transform: translateX(-50%);
        }

        to {
            transform: translateX(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-track.animate-slide-left,
        .marquee-track.animate-slide-right {
            animation: none;
        }
    }
</style>