---
interface Bullet {
    text: string;
    icon: string;
    iconAlt: string;
}

interface Props {
    eyebrow?: string;
    title?: string;
    paragraphs?: string[];
    highlightText?: string;
    bullets?: Bullet[];
    buttonText?: string;
    buttonLink?: string;
    image?: string;
    imageAlt?: string;
}

const {
    eyebrow = "Breathe In. Begin Again.",
    title = "Ancient Practice. Present Moment.",
    paragraphs = [
        "At Pranavya Yoga, we believe yoga is more than movement — it's a mindful journey toward balance, clarity, and inner peace. Our studio blends ancient yogic wisdom with a modern, inclusive approach, offering a safe space for every body and every level. Whether you're joining us in-studio or online, our certified instructors guide you through personalized.",
    ],
    highlightText = "We don’t just teach poses — we teach presence, breath, and connection.",
    bullets = [
        {
            text: "Small class sizes for personal attention",
            icon: "/bullets-point.svg",
            iconAlt: "Bullets Point",
        },
        {
            text: "Certified, compassionate instructors",
            icon: "/bullets-point.svg",
            iconAlt: "Bullets Point",
        },
        {
            text: "Options for group, private, and virtual sessions",
            icon: "/bullets-point.svg",
            iconAlt: "Bullets Point",
        },
    ],
    buttonText = "Discover the Space",
    buttonLink = "/about/",
    image = "/home-4_about-us.webp",
    imageAlt = "About Image",
} = Astro.props;
---

<section class="relative bg-white 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10">
    <div class="container">
        <div class="grid lt:grid-cols-2 grid-cols-1 items-center 2xl:gap-[135px] 1xl:gap-[80px] lg:gap-[50px] gap-[30px]">

            <!-- Right: Content -->
            <div class="w-full">

                <h3 class="text-thunder-100 font-primary italic font-medium 1xl:mb-[30px] xl:mb-6 md:mb-[18px] sm:mb-4 mb-2.5">
                    {eyebrow}
                </h3>

                <h2 class="text-primary font-normal uppercase 1xl:mb-[25px] mb-3">
                    {title}
                </h2>

                {
                    paragraphs.map((paragraph) => (
                        <p class="text-thunder-100 xl:mb-5 mb-4">
                            {paragraph}
                        </p>
                    ))
                }

                <p class="font-medium">
                    {highlightText}
                </p>

                <!-- Bullets -->
                <ul class="1xl:mt-7 sm:mt-5 mt-4 flex flex-col items-start justify-center 2xl:gap-5 1xl:gap-4 gap-3">
                    {
                        bullets.map((bullet) => (
                            <li class="flex items-center md:gap-[11px] gap-2">
                                <span class="shrink-0 whitespace-nowrap 1xl:w-7.5 xl:w-7 lg:w-6 md:w-5 w-4 h-full">
                                    <img
                                        loading="lazy"
                                        src={bullet.icon}
                                        alt={bullet.iconAlt}
                                    />
                                </span>

                                <p class="text-primary font-medium p2">
                                    {bullet.text}
                                </p>
                            </li>
                        ))
                    }
                </ul>

                <div class="2xl:mt-11 1xl:mt-10 md:mt-8 sm:mt-7 mt-5">
                    <a href={buttonLink} class="btn btn-secondary">
                        {buttonText}
                    </a>
                </div>

            </div>

            <!-- Left: Image -->
            <div class="w-full">
                <div class="overflow-hidden relative before:content-[''] before:block 2xl:before:pt-[96%] xl:before:pt-[100%] lg:before:pt-[116%] lt:before:pt-[125%] sm:before:pt-[65%] before:pt-[89%] w-full">
                    <img
                        loading="lazy"
                        src={image}
                        alt={imageAlt}
                        class="absolute top-0 left-0 w-full h-full object-cover"
                        decoding="async"
                    />
                </div>
            </div>

        </div>
    </div>
</section>
