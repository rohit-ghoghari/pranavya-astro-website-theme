---
interface ScheduleItem {
    type: "class" | "rest";
    title?: string;
    level?: string;
    time?: string;
}

interface ScheduleRow {
    items: ScheduleItem[];
}

interface Props {
    eyebrow?: string;
    title?: string;
    description?: string;
    buttonText?: string;
    buttonLink?: string;
    days?: string[];
    schedule?: ScheduleRow[];
