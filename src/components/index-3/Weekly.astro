---
import { defaultScheduleDaysIndex3 as scheduleDays } from "../../data/scheduleIndex3";
---

<section class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 bg-white">
    <div id="schedule" class="schedule-3">
        <div class="container relative z-10">

            <div class="text-center lg::max-w-[65%] lt:max-w-[80%] max-w-full w-full mx-auto mb-10">
                <h3 class="font-primary italic font-medium 2xl:mb-7 1xl:mb-6 xl:mb-5 sm:mb-3 mb-2.5 text-center">
                    Weekly Practice Calendar
                </h3>

                <h2 class="text-primary uppercase 1xl:mb-5 mb-3 text-center">
                    Flow on Your Time
                </h2>

                <p>
                    Create a rhythm that supports your lifestyle. Whether you're welcoming the sunrise with
                    movement
                    or unwinding under evening light, our weekly class
                </p>
            </div>

            <!-- Day Tabs -->
            <div>
                <div class="md:hidden relative w-full">
                    <select
                        id="scheduleSelect"
                        class="w-full sm:px-5 sm:py-3 px-4 py-2 bg-primary text-white font-Work border border-primary focus:outline-none appearance-none select-arrow"
                    >
                        {scheduleDays.map((day) => (
                            <option value={`#${day.id}`}>
                                {day.name}
                            </option>
                        ))}
                    </select>
                </div>
            </div>

            <div class="overflow-x-auto md:block hidden">
                <div class="inline-flex min-w-full overflow-hidden 1xl:gap-5 lg:gap-4 lt:gap-3 gap-2">
                    {scheduleDays.map((day, index) => (
                        <button
                            id={`schedule-tab-${day.id}`}
                            type="button"
                            class={`schedule-tab ${index === 0 ? "text-white w-full bg-black is-active" : "text-primary w-full"}`}
                            data-target={`#${day.id}`}
                            role="tab"
                            aria-controls={day.id}
                            aria-selected={index === 0 ? "true" : "false"}
                        >
                            {day.name}
                        </button>
                    ))}
                </div>
            </div>

            <!-- Tables by Day -->
            <div class="2xl:mt-8 1xl:mt-7 xl:mt-6 lt:mt-5 mt-4 lt:-mx-3">

                {scheduleDays.map((day, dayIndex) => (
                    <div
                        id={day.id}
                        class={`schedule-panel custom-scroll-2 ${dayIndex === 0 ? "" : "hidden"}`}
                        role="tabpanel"
                        aria-labelledby={`schedule-tab-${day.id}`}
                    >
                        <div class="transition-all duration-300">

                            <table class={dayIndex === 0 ? "w-full table" : "w-full border-collapse block md:table"}>

                                <thead class={dayIndex === 0 ? "table-header-group" : "table-header-group bg-whitesmoke-100"}>
                                    <tr>
                                        <th class="w-1/5">Time</th>
                                        <th class="w-1/5">Class</th>
                                        <th class="w-1/5">Level</th>
                                        <th class="w-1/5">Trainer</th>
                                        <th class="w-1/5">Action</th>
                                    </tr>
                                </thead>

                                <tbody class="table-row-group space-y-5">

                                    {day.rows.map((row) => (
                                        
                                        <tr class="group hover:bg-whitesmoke-100">

                                            <td class="group-hover:text-primary">
                                                <p>{row.time}</p>
                                            </td>

                                            <td class="group-hover:text-primary">
                                                <p>{row.className}</p>
                                            </td>

                                            <td class="group-hover:text-primary">
                                                <p>{row.level}</p>
                                            </td>

                                            <td class="group-hover:text-primary">
                                                <p>{row.trainer}</p>
                                            </td>

                                            <td class="group-hover:text-primary">
                                                <a
                                                    href="/bookClass/"
                                                    class="p text-thunder-100 hover:text-primary underline decoration-1 underline-offset-2 flex items-center flex-wrap sm:gap-1 gap-0.5 w-full justify-center"
                                                >
                                                    Book Now

                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="27"
                                                        height="27"
                                                        viewBox="0 0 27 27"
                                                        fill="none"
                                                        class="2xl:w-[27px] 2xl:h-[27px] sm:w-[25px] sm:h-[25px] w-5 h-5"
                                                    >
                                                        <g clip-path="url(#clip0_3130_6678)">
                                                            <path
                                                                d="M8.37896 18.7836L19.207 7.95556M19.207 7.95556C19.4636 8.21217 19.62 8.56903 19.616 8.96328L19.5384 16.6458M19.207 7.95556C18.9504 7.69895 18.5935 7.54257 18.1993 7.54655L10.5168 7.62418"
                                                                stroke="currentColor"
                                                                stroke-width="1.5"
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                            ></path>
                                                        </g>
                                                    </svg>
                                                </a>
                                            </td>

                                        </tr>
                                    ))}

                                </tbody>
                            </table>

                        </div>
                    </div>
                ))}

            </div>
        </div>
    </div>
</section>

<script>
    function initWeeklySchedule() {
        const schedule = document.querySelector<HTMLElement>(".schedule-3");

        if (!schedule || schedule.dataset.initialized === "true") return;

        const scheduleTabs = schedule.querySelectorAll<HTMLButtonElement>(".schedule-tab");
        const schedulePanels = schedule.querySelectorAll<HTMLElement>(".schedule-panel");
        const scheduleSelect = schedule.querySelector<HTMLSelectElement>("#scheduleSelect");

        const showSchedule = (target: string) => {
            const activePanel = schedule.querySelector<HTMLElement>(target);

            if (!activePanel || !activePanel.classList.contains("schedule-panel")) return;

            schedulePanels.forEach((panel) => {
                panel.classList.toggle("hidden", panel !== activePanel);
            });

            scheduleTabs.forEach((tab) => {
                const isActive = tab.dataset.target === target;

                tab.classList.toggle("is-active", isActive);
                tab.classList.toggle("bg-black", isActive);
                tab.classList.toggle("text-white", isActive);
                tab.classList.toggle("text-primary", !isActive);
                tab.setAttribute("aria-selected", String(isActive));
            });

            if (scheduleSelect && scheduleSelect.value !== target) {
                scheduleSelect.value = target;
            }
        };

        scheduleTabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const target = tab.dataset.target;

                if (target) showSchedule(target);
            });
        });

        scheduleSelect?.addEventListener("change", () => {
            showSchedule(scheduleSelect.value);
        });

        schedule.dataset.initialized = "true";
        showSchedule(scheduleSelect?.value ?? scheduleTabs[0]?.dataset.target ?? "");
    }

    initWeeklySchedule();
    document.addEventListener("astro:page-load", initWeeklySchedule);
</script>