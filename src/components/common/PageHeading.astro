---
interface Props {
  title?: string;
  description?: string;
  backgroundClass?: string;
  descriptionClass?: string;
}

const {
  title = "Join Your Journey",
  description = `Experience yoga that grows with you-practice at your pace, on your path. Our thoughtfully designed memberships unlock exclusive classes, special events, and mindful perks to support your body.`,
  backgroundClass = "bg-whitesmoke-100",
  descriptionClass = "max-w-full w-full",
} = Astro.props;
---

<!-- Page Heading -->
<section
  class:list={[
    "relative 1xl:pt-20 xl:pt-17 lg:pt-14 md:pt-12 sm:pt-11 pt-10 xl:mb-20 lg:mb-16 md:mb-12 sm:mb-11 mb-10 pb-[60px]",
    backgroundClass,
  ]}
>
  <div class="container relative">
    <div
      class="flex flex-col items-center justify-center lt:max-w-[73%] md:max-w-[90%] max-w-full w-full text-center mx-auto space-y-2.5"
    >
      <h1
        class="uppercase text-primary text-center"
        data-aos="fade-up"
      >
        {title}
      </h1>

      <p
        class={descriptionClass}
        data-aos="fade-up"
        data-aos-delay="100"
      >
        {description}
      </p>
    </div>

    <!-- Decorative Flower -->
    <div
      class="pointer-events-none absolute 1xl:-top-20 xl:-top-[65px] lg:-top-[55px] -top-12 left-auto right-0 lg:w-[14.2%] w-[15%] hidden md:block opacity-30"
    >
      <img
        loading="lazy"
        decoding="async"
        src="/flower-shape.svg"
        alt="decor"
        class="w-full h-full object-contain"
      />
    </div>
  </div>
</section>