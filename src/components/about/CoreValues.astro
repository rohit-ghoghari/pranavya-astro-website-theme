---
interface CoreValue {
  icon: string;
  title: string;
  description: string;
  iconAlt?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  values?: CoreValue[];
}

const {
  eyebrow = "Core Values",
  title = "Rooted in Yoga, Driven by Purpose",
  values = [
    {
      icon: "/about-accessibility.svg",
      title: "Accessibility",
      description:
        "We believe yoga should be available to everyone, regardless of their background, location, or financial means.",
      iconAlt: "Personalized Yoga",
    },
    {
      icon: "/about-kindness.svg",
      title: "Kindness",
      description:
        "These values are not just ideas—they're actions we live by. From the way we interact with our community.",
      iconAlt: "Personalized Yoga",
    },
    {
      icon: "/about-transparency.svg",
      title: "Transparency",
      description:
        "Honesty and openness define how we operate. We share our processes, business model, and community impact clearly.",
      iconAlt: "Personalized Yoga",
    },
  ],
} = Astro.props;
---

<section
  class="relative bg-white 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10"
>
  <div class="container">
    <div
      class="2xl:mb-13 xl:mb-10 lt:mb-8 mb-6"
      data-aos="fade-right"
    >
      <h3
        class="text-thunder-100 font-primary italic font-medium 2xl:mb-7.5 1xl:mb-6 lg:mb-4 mb-2.5"
      >
        {eyebrow}
      </h3>

      <h3 class="text-primary font-normal uppercase">
        {title}
      </h3>
    </div>

    <div
      class="grid lt:grid-cols-3 grid-cols-1 1xl:gap-6 lt:gap-5 md:gap-4 gap-5"
    >
      {
        values.map((value) => (
          <div
            class="group border border-primary/15 2xl:p-7.5 1xl:p-6 xl:p-4 md:p-3.5 p-4 bg-whitesmoke-100 transition-all duration-300"
            data-aos="fade-up"
          >
            <div class="flex 1xl:gap-6 xl:gap-4 lt:gap-3.5 md:gap-2 gap-3.5">
              <div class="2xl:w-16 2xl:h-16 1xl:w-14 1xl:h-14 lg:w-12 lg:h-12 sm:w-10 sm:h-10 w-9 h-9 shrink-0">
                <img
                  loading="lazy"
                  decoding="async"
                  src={value.icon}
                  alt={value.iconAlt ?? value.title}
                  class="w-full h-full object-cover"
                />
              </div>

              <div>
                <h5
                  class="uppercase text-primary transition-all duration-300 1xl:mb-7 xl:mb-5 lg:mb-4 md:mb-3 mb-4"
                >
                  {value.title}
                </h5>

                <p>
                  {value.description}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>