---
import type { ShopProduct } from "../../data/shopCatalog";

interface Props {
    product: ShopProduct;
    view: "grid" | "list";
}

const { product, view } = Astro.props;
const isList = view === "list";
const title = isList ? product.listView?.title ?? product.title : product.title;
const price = isList ? product.listView?.price ?? product.price : product.price;
const priceValue = Number(price.replace(/[^0-9.]/g, ""));
const description = product.listView?.description ?? "";
const href = "/shop/manduka-pro-yoga-mat/";
---

{isList ? (
    <div
        class="shop-product-card w-full h-full flex items-stretch sm:flex-row flex-col border border-primary/15 rounded-sm overflow-hidden"
        data-product-id={product.id}
        data-category={product.category}
        data-brand={product.brand}
        data-price={priceValue}
        data-colors={product.colors?.map((color) => color.value.toLowerCase()).join(",") ?? ""}
        data-title={title.toLowerCase()}
        data-product-title={title}
    >
        <div class="lg:w-[32%] sm:w-[35%] w-full p-2.5">
            <div class="h-full relative flex items-center justify-center rounded-sm overflow-hidden">
                <a
                    href={href}
                    class="w-full bg-[#E0E0E0] rounded-sm overflow-hidden md:p-6 p-5 1xl:h-[280px] xl:h-[250px] lg:h-[235px] h-[220px]"
                >
                    <img
                        loading="lazy"
                        src={product.image}
                        alt={product.alt}
                        class="lg:w-[90%] w-full m-auto h-full object-contain"
                    />
                </a>
                {product.colors?.length ? (
                    <div
                        class="absolute 1xl:top-5 1xl:right-5 lg:top-4 lg:right-4 top-2.5 right-2.5 flex flex-col 1xl:gap-4 gap-3.5"
                    >
                        {product.colors.map((color) => (
                            <label class="cursor-pointer">
                                <input
                                    type="radio"
                                    name={`color-set-${product.id + 9}`}
                                    class="peer hidden"
                                    checked={color.selected}
                                />
                                <span class="block rounded-full overflow-hidden 1xl:size-6 xl:size-5.5 size-5 p-0 border border-transparent peer-checked:border-primary peer-checked:p-0.5 hover:border-primary hover:p-0.5 transition">
                                    <span
                                        class="block w-full h-full rounded-full"
                                        style={`background-color: ${color.value}`}
                                    ></span>
                                </span>
                            </label>
                        ))}
                    </div>
                ) : null}
            </div>
        </div>
        <div
            class="lg:w-[68%] sm:w-[65%] w-full h-auto bg-whitesmoke-200 flex items-start justify-center flex-col md:p-5 p-4"
        >
            <p class="font-medium 1xl:mb-5 mb-3">{title}</p>
            {description ? <p class="text-black 1xl:mb-5 mb-4 1xl:w-4/5 lg:w-[85%]">{description}</p> : null}
            <div class="flex items-center 1xl:gap-4 gap-2 mb-2">
                <button
                    type="button"
                    class="1xl:size-10 xl:size-9 size-8 flex items-center justify-center xl:p-2 p-1.5 bg-white rounded-full group border border-primary/15 cart-btn cursor-pointer"
                    aria-label="Add to cart"
                    aria-pressed="false"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 20 20"
                        fill="none"
                        class="icon stroke"
                    >
                        <path
