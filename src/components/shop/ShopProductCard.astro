                            fill="#2D2D2D"
                        />
                    </svg>
                </button>
                <button
                    type="button"
                    class="1xl:size-10 xl:size-9 size-8 flex items-center justify-center xl:p-2 p-1.5 bg-white rounded-full group cart-btn cursor-pointer"
                    aria-label="Add to wishlist"
                    aria-pressed="false"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 20 20"
                        fill="none"
                        class="icon filled"
                    >
                        <path
                            d="M6.24984 3.33301C3.71859 3.33301 1.6665 5.38509 1.6665 7.91634C1.6665 12.4997 7.08317 16.6663 9.99984 17.6355C12.9165 16.6663 18.3332 12.4997 18.3332 7.91634C18.3332 5.38509 16.2811 3.33301 13.7498 3.33301C12.1998 3.33301 10.829 4.10259 9.99984 5.28051C9.57713 4.67859 9.01565 4.18734 8.3629 3.84835C7.71016 3.50936 6.98536 3.33259 6.24984 3.33301Z"
                            fill="currentColor"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 20 20"
                        fill="none"
                        class="icon stroke"
                    >
                        <path
                            d="M6.25033 3.33301C3.71908 3.33301 1.66699 5.38509 1.66699 7.91634C1.66699 12.4997 7.08366 16.6663 10.0003 17.6355C12.917 16.6663 18.3337 12.4997 18.3337 7.91634C18.3337 5.38509 16.2816 3.33301 13.7503 3.33301C12.2003 3.33301 10.8295 4.10259 10.0003 5.28051C9.57762 4.67859 9.01614 4.18734 8.36339 3.84835C7.71065 3.50936 6.98585 3.33259 6.25033 3.33301Z"
                            stroke="#2D2D2D"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>
            </div>
            <p class="text-black">{price}</p>
        </div>
    </div>
) : (
    <div
        class="product-card-wrapper shop-product-card group"
        data-product-id={product.id}
        data-category={product.category}
        data-brand={product.brand}
        data-price={priceValue}
        data-colors={product.colors?.map((color) => color.value.toLowerCase()).join(",") ?? ""}
        data-title={title.toLowerCase()}
        data-product-title={title}
    >
        <div
            class="relative bg-[#E0E0E0] p-6 flex items-center justify-center 2xl:h-[470px] 1xl:h-[420px] xl:h-[350px] h-[320px] rounded-sm overflow-hidden"
        >
            <a href={href} class="w-full h-full">
                <img
                    loading="lazy"
                    src={product.image}
                    alt={product.alt}
                    class="w-full h-full object-contain"
                />
            </a>
            {product.colors?.length ? (
                <div
                    class="absolute 1xl:top-5 1xl:right-5 top-4 right-4 flex flex-col 1xl:gap-4 gap-3.5"
                >
                    {product.colors.map((color) => (
                        <label class="cursor-pointer">
                            <input
                                type="radio"
                                name={`color-grid-${product.id}`}
                                class="peer hidden"
                                checked={color.selected}
                            />
                            <span class="block rounded-full overflow-hidden 1xl:size-6 xl:size-5.5 size-5 p-0 border border-transparent peer-checked:border-primary peer-checked:p-0.5 hover:border-primary hover:p-0.5 transition">
                                <span
                                    class="block w-full h-full rounded-full"
                                    style={`background-color: ${color.value}`}
                                ></span>
                            </span>
                        </label>
                    ))}
                </div>
            ) : null}
            <div
                class="absolute bottom-0 w-full 1xl:p-5 p-3.5 rounded-sm overflow-hidden bg-linear-to-t from-thunder-100 via-thunder-100/50 to-thunder-100/25 backdrop-blur-xs"
            >
                <a
                    href={href}
                    class="group hover:underline decoration-1.5 underline-offset-2 decoration-white w-full h-full"
                >
                    <p class="font-medium mb-3 text-white">{title}</p>
                </a>
                <div class="flex items-center justify-between w-full gap-2">
                    <div class="flex items-center 1xl:gap-4 gap-2">
                        <button
                            type="button"
                            class="1xl:size-10 xl:size-9 size-8 flex items-center justify-center xl:p-2 p-1.5 bg-white rounded-full group cart-btn cursor-pointer"
                            aria-label="Add to cart"
                            aria-pressed="false"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 20 20"
                                fill="none"
                                class="icon stroke"
                            >
