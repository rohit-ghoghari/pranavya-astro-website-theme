                                    d="M7.29199 10.833C7.29199 10.6672 7.22614 10.5083 7.10893 10.3911C6.99172 10.2739 6.83275 10.208 6.66699 10.208C6.50123 10.208 6.34226 10.2739 6.22505 10.3911C6.10784 10.5083 6.04199 10.6672 6.04199 10.833V14.1663C6.04199 14.3321 6.10784 14.4911 6.22505 14.6083C6.34226 14.7255 6.50123 14.7913 6.66699 14.7913C6.83275 14.7913 6.99172 14.7255 7.10893 14.6083C7.22614 14.4911 7.29199 14.3321 7.29199 14.1663V10.833ZM13.3337 10.208C13.4994 10.208 13.6584 10.2739 13.7756 10.3911C13.8928 10.5083 13.9587 10.6672 13.9587 10.833V14.1663C13.9587 14.3321 13.8928 14.4911 13.7756 14.6083C13.6584 14.7255 13.4994 14.7913 13.3337 14.7913C13.1679 14.7913 13.0089 14.7255 12.8917 14.6083C12.7745 14.4911 12.7087 14.3321 12.7087 14.1663V10.833C12.7087 10.6672 12.7745 10.5083 12.8917 10.3911C13.0089 10.2739 13.1679 10.208 13.3337 10.208ZM10.6253 10.833C10.6253 10.6672 10.5595 10.5083 10.4423 10.3911C10.3251 10.2739 10.1661 10.208 10.0003 10.208C9.83457 10.208 9.67559 10.2739 9.55838 10.3911C9.44117 10.5083 9.37533 10.6672 9.37533 10.833V14.1663C9.37533 14.3321 9.44117 14.4911 9.55838 14.6083C9.67559 14.7255 9.83457 14.7913 10.0003 14.7913C10.1661 14.7913 10.3251 14.7255 10.4423 14.6083C10.5595 14.4911 10.6253 14.3321 10.6253 14.1663V10.833Z"
                                    fill="#2D2D2D"
                                />
                            </svg>
                        </button>
                        <button
                            type="button"
                            class="1xl:size-10 xl:size-9 size-8 flex items-center justify-center xl:p-2 p-1.5 bg-white rounded-full group cart-btn cursor-pointer"
                            aria-label="Add to wishlist"
                            aria-pressed="false"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 20 20"
                                fill="none"
                                class="icon filled"
                            >
                                <path
                                    d="M6.24984 3.33301C3.71859 3.33301 1.6665 5.38509 1.6665 7.91634C1.6665 12.4997 7.08317 16.6663 9.99984 17.6355C12.9165 16.6663 18.3332 12.4997 18.3332 7.91634C18.3332 5.38509 16.2811 3.33301 13.7498 3.33301C12.1998 3.33301 10.829 4.10259 9.99984 5.28051C9.57713 4.67859 9.01565 4.18734 8.3629 3.84835C7.71016 3.50936 6.98536 3.33259 6.24984 3.33301Z"
                                    fill="currentColor"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
