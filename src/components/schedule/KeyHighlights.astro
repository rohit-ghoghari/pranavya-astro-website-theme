---
interface Highlight {
    title: string;
    heading: string;
    description: string;
}

interface Props {
    eyebrow?: string;
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    highlights?: Highlight[];
}

const {
    eyebrow = "Key Highlights",
    title = "A Practice That Fits Your Life",
    description = "Designed for accessibility, ease, and flexibility Whether you're a beginner or a seasoned yogi, our approach ensures every session is welcoming, convenient, and easy to book — from anywhere, anytime.",
    image = "/scheduling-highlight.webp",
    imageAlt = "Yoga",
    highlights = [
        {
            title: "All Levels Welcome",
            heading: "Supportive Classes for Every Stage",
            description:
                "Our instructors offer inclusive classes that accommodate all skill levels. Beginners receive guidance and modifications, while experienced students can deepen their practice with advanced variations.",
        },
        {
            title: "In-Studio & Virtual Options",
            heading: "Practice Anytime, Anywhere",
            description:
                "Enjoy the freedom to attend sessions at our serene studio or from the comfort of your home. Live-streamed and on-demand options give you full control.",
        },
        {
            title: "Book Instantly",
            heading: "Seamless Scheduling in One Click",
            description:
                "No logins. No long forms. Just one click and you’re in. Our instant booking system makes class reservations effortless so you can spend more time flowing and less time planning.",
        },
    ],
} = Astro.props;
---

<section class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full 2xl:py-20 1xl:py-17 lg:py-14 md:py-12 sm:py-11 py-10 bg-whitesmoke-100" data-aos="fade-up">
    <div class="container">
        <div class="text-start max-w-full w-full 2xl:mb-[50px] 1xl:mb-11 md:mb-9 mb-7">
            <h3 class="font-primary italic font-medium 2xl:mb-7 1xl:mb-6 xl:mb-5 sm:mb-3 mb-2.5">
                {eyebrow}
            </h3>

            <h2 class="text-primary uppercase 1xl:mb-9 lg:mb-5 mb-3">
                {title}
            </h2>

            <p class="text-thunder-100 w-full">
                {description}
            </p>
        </div>

        <div class="flex justify-between lt:flex-row flex-col-reverse 2xl:gap-17 1xl:gap-13 lg:gap-10 md:gap-8 sm:gap-6 gap-5 md:items-stretch items-start">

            <!-- Right: Content -->
            <div class="w-full lt:max-w-[52.5%]">

                {
                    highlights.map((highlight) => (
                        
                        <div class="flex items-start flex-col 1xl:py-7.5 xl:py-6.5 md:py-6 sm:py-5 py-4 first:pt-0 border-b border-primary/15">

                            <div class="flex items-center 1xl:gap-5.5 xl:gap-4.5 sm:gap-3 gap-2 1xl:mb-4 md:mb-3 mb-2.5">

                                <div class="shrink-0 1xl:size-13.5 xl:size-11.5 lg:size-10.5 sm:size-10 size-9.5">
                                    <img
                                        loading="lazy"
                                        src="/highlight-arrow.svg"
                                        alt="arrow"
                                        class="w-full h-full"
                                    >
                                </div>

                                <h5 class="uppercase text-primary">
                                    {highlight.title}
                                </h5>

                            </div>

                            <div class="1xl:pl-19.5 md:pl-14 sm:pl-13 pl-11.5">
                                <p class="font-medium xl:mb-2.5 mb-2">
                                    {highlight.heading}
                                </p>

                                <p>
                                    {highlight.description}
                                </p>
                            </div>

                        </div>
                    ))
                }

            </div>

            
            <div class="lt:sticky relative lt:top-20 top-0 w-full lt:max-w-[47.5%] rounded-sm overflow-hidden">
                <div class="overflow-hidden relative before:block before:content-[''] lt:before:pt-[100%] before:pt-[80%] h-full">
                    <img
                        loading="lazy"
                        decoding="async"
                        src={image}
                        alt={imageAlt}
                        class="w-full h-full object-cover object-center absolute top-0 left-0"
                    >
                </div>
            </div>

        </div>
    </div>
</section>