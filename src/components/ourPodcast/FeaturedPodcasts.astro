---
import FeaturedPodcastCard from "./FeaturedPodcastCard.astro";
import {
  DEFAULT_FEATURED_PODCASTS,
  INITIAL_VISIBLE_COUNT,
  type Podcast,
} from "./featuredPodcastData";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  podcasts?: Podcast[];
}

const {
  eyebrow = "Why Listen to Our Featured Podcast?",
  title = "Your Wellness, One Episode at a Time",
  description = `At Pranavya Yoga, our featured podcast episodes are more than just conversations—they’re tools
for transformation. Each one is carefully crafted to guide you toward balance, clarity, and
personal growth.`,
  podcasts = DEFAULT_FEATURED_PODCASTS,
} = Astro.props;

const shouldShowRevealMore = podcasts.length > INITIAL_VISIBLE_COUNT;
---

<section
  id="featured-podcasts"
  class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full 2xl:py-20 1xl:py-17 lg:py-14 md:py-12 sm:py-11 py-10 bg-whitesmoke-200"
>
  <div class="container">
    <div class="flex flex-col items-center justify-center 1xl:mb-[50px] sm:mb-11 mb-10">
      <h3
        class="font-primary italic font-medium 2xl:mb-7 1xl:mb-6 xl:mb-5 sm:mb-3 mb-2.5 text-center"
        data-aos="fade-up"
      >
        {eyebrow}
      </h3>
      <h2
        class="text-primary uppercase 1xl:mb-5 mb-3 text-center"
        data-aos="fade-up"
      >
        {title}
      </h2>
      <p
        class="2xl:w-[74%] xl:w-[80%] lt:w-[85%] w-full text-center"
        data-aos="fade-up"
      >
        {description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:gap-6 gap-5">
      {podcasts.map((podcast, index) => (
        <FeaturedPodcastCard podcast={podcast} index={index} />
      ))}
    </div>

    {shouldShowRevealMore && (
      <button
        class="2xl:mt-12.5 1xl:mt-12 xl:mt-11 lg:mt-10 md:mt-9 sm:mt-8 mt-7.5 btn reveal-more flex items-center justify-center mx-auto gap-4"
        type="button"
      >
        Reveal More
        <img
          loading="lazy"
          src="/loading.svg"
          alt="load"
          class="1xl:size-7.5 xl:size-6.5 size-5.5 mx-auto"
        />
      </button>
    )}
  </div>
</section>

<style is:global>

  /*
   * Cards after the first 6 remain hidden until Reveal More is clicked.
   */
  #featured-podcasts .podcast-card[data-extra="true"] {
    display: none !important;
  }

  /*
   * YouTube-style podcast progress bar.
   *
   * The visible line is only 3px high,
   * but the actual interaction area is 20px high,
   * making it much easier to drag on desktop and mobile.
   */
  #featured-podcasts .progress-bar {
    --progress: 0%;

    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    height: 20px;
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }

  /*
   * Background track
   */
  #featured-podcasts .progress-bar::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    width: 100%;
    height: 3px;
    transform: translateY(-50%);
    background: #e8e2df;
    border-radius: 999px;
    pointer-events: none;
  }

  /*
   * Played/filled portion
   */
  #featured-podcasts .progress-fill {
    position: absolute;
    left: 0;
    top: 50%;
    width: var(--progress);
    height: 3px;
    transform: translateY(-50%);
    background: #673e2c;
    border-radius: 999px;
    pointer-events: none;
    transition: width 0.05s linear;
  }

  /*
   * YouTube-style draggable handle.
   *
   * It stays hidden until the user hovers or drags.
   */
  #featured-podcasts .progress-bar::after {
    content: "";

    position: absolute;
    left: var(--progress);
    top: 50%;

    width: 9px;
    height: 9px;

    transform: translate(-50%, -50%);

    background: #673e2c;
    border-radius: 50%;

    opacity: 0;
    pointer-events: none;

    transition:
      opacity 0.15s ease,
      width 0.15s ease,
      height 0.15s ease;
  }

  /*
   * Show handle when hovering.
   */
  #featured-podcasts .progress-bar:hover::after {
    width: 12px;
    height: 12px;
    opacity: 1;
  }

  /*
   * Keep handle visible while dragging.
   */
  #featured-podcasts .progress-bar.is-dragging::after {
    width: 13px;
    height: 13px;
    opacity: 1;
  }

  /*
   * Keyboard accessibility.
   */
  #featured-podcasts .progress-bar:focus-visible {
    outline: 1px solid #673e2c;
    outline-offset: 3px;
  }

  /*
   * Reveal More loader.
   *
   * It does NOT spin constantly.
   * It only spins while hovering over Reveal More.
   */
  #featured-podcasts .reveal-more img {
    animation: none;
  }

  #featured-podcasts .reveal-more:hover img {
    animation: featuredPodcastRevealMoreSpin 1s linear infinite;
  }

  @keyframes featuredPodcastRevealMoreSpin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  import "./featuredPodcastClient";
</script>
