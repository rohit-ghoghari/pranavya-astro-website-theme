---
interface RelatedClass {
    title: string;
    category: string;
    description: string;
    image: string;
    intensity: string;
    intensityBadge: string;
    instructor: string;
    instructorImage: string;
    href: string;
}

interface Props {
    relatedClasses: RelatedClass[];
}

const { relatedClasses } = Astro.props;
---

<!-- ====== Start Classes Section ====== -->
<section class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full">
    <div class="container">
        <h5 class="uppercase text-primary mb-6">Related Classes</h5>
        <div class="grid lg:grid-cols-3 sm:grid-cols-2 grid-cols-1 1xl:gap-6 gap-5">
            {relatedClasses.map((classItem: any) => (
                <div class="yoga-card group" data-aos="fade-up">
                    <a href={classItem.href} class="yoga-card-image">
                        <img loading="lazy" src={classItem.image} alt={classItem.title} />
                        <div class="yoga-card-badge">
                            <span class:list={["badge-dot", classItem.intensityBadge]}></span>
                            <span>Intensity : {classItem.intensity}</span>
                        </div>
                    </a>
                    <div class="yoga-card-content">
                        <p class="yoga-card-category">{classItem.category}</p>
                        <a href={classItem.href}>
                            <h3 class="yoga-card-title group-hover:text-black">{classItem.title}</h3>
                        </a>
                        <p class="yoga-card-desc">{classItem.description}</p>
                        <div class="yoga-card-footer">
                            <div class="yoga-card-instructor">
                                <div class="instructor-img">
                                    <img loading="lazy" src={classItem.instructorImage} alt="Instructor" />
                                </div>
                                <p class="p2">{classItem.instructor}</p>
                            </div>
                            <a href={classItem.href} class="btn-link btn">
                                view now
                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10"
                                    fill="none" class="mt-1 2xl:w-4 sm:w-3.5 w-3 h-full">
                                    <path
                                        d="M0.701687 8.86162C0.701687 8.86162 6.30093 3.26231 8.63309 0.93009M8.63309 0.93009L8.86101 6.90189M8.63309 0.93009L2.66089 0.702578"
                                        stroke="currentColor" stroke-width="1.2" stroke-linecap="round"
                                        stroke-linejoin="round" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
<!-- ====== End Classes Section ====== -->
