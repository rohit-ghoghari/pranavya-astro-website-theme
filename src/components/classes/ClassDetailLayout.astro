---
// ClassDetailLayout.astro — Reusable class detail page layout
// Assembled from modular components: Flow, Overview, Instructor, Pricing, Related, Comments
import ClassFlowSection from './ClassFlowSection.astro';
import ClassVideoBanner from './ClassVideoBanner.astro';
import ClassOverviewSection from './ClassOverviewSection.astro';
import ClassInstructorCard from './ClassInstructorCard.astro';
import ClassPricingSection from './ClassPricingSection.astro';
import ClassRelatedSection from './ClassRelatedSection.astro';
import ClassCommentsSection from './ClassCommentsSection.astro';

interface Props {
    data: any;
}

const { data } = Astro.props;

const {
    pageTitle,
    pageDescription,
    mainImage,
    mainImageAlt,
    expectTitle,
    expectSubtitle,
    expectDescription,
    classFlowHeading,
    classFlowItems,
    experienceTitle,
    videoBanner,
    videoBannerAlt,
    videoSrc,
    intensityLevel,
    intensityBadgeClass,
    category,
    overview,
    benefits,
    instructor,
    monthlyPlans,
    yearlyPlans,
    relatedClasses,
} = data;
---

<main class="h-full 2xl:pt-20.5 xl:pt-19.5 lg:pt-16.5 md:pt-14 sm:pt-13 pt-10">
    <!-- ====== Start Page Heading ====== -->
    <section
        class="relative 2xl:mt-[100px] 1xl:mt-20 xl:mt-17 lg:mt-14 md:mt-12 sm:mt-11 mt-10 2xl:mb-[120px] 1xl:mb-[100px] xl:mb-20 lg:mb-16 md:mb-12 sm:mb-11 mb-10">
        <div class="container">
            <div
                class="flex flex-col items-center justify-center lt:max-w-[73%] md:max-w-[90%] max-w-full w-full text-center mx-auto space-y-2.5">
                <h1 class="uppercase text-primary text-center" data-aos="fade-up">{pageTitle}</h1>
                <p class="xl:max-w-[90%] w-full" data-aos="fade-up">
                    {pageDescription}
                </p>
            </div>

            <!-- Decorative Flower -->
            <div
                class="pointer-events-none absolute 1xl:-top-20 xl:-top-[65px] lg:-top-[55px] -top-12 left-auto right-0 lg:w-[14.2%] w-[15%] hidden md:block opacity-30">
                <img loading="lazy" decoding="async" src="/flower-shape.svg" alt="decor"
                    class="w-full h-full object-contain" />
            </div>
        </div>
    </section>
    <!-- ====== End Page Heading ====== -->

    <!-- ====== Main Content Section ====== -->
    <section class="relative bg-white 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10">
        <div class="container">
            <div
                class="flex lt:flex-row flex-col items-start 2xl:gap-19.5 1xl:gap-17 xl:gap-15 lg:gap-13.5 lt:gap-8.5 gap-3.5">
                <div
                    class="lt:w-[64%] w-full 2xl:space-y-12.5 1xl:space-y-11 xl:space-y-9 lg:space-y-7.5 sm:space-y-6 space-y-4">
                    <ClassFlowSection
                        mainImage={mainImage}
                        mainImageAlt={mainImageAlt}
                        expectTitle={expectTitle}
                        expectSubtitle={expectSubtitle}
                        expectDescription={expectDescription}
                        classFlowHeading={classFlowHeading}
                        classFlowItems={classFlowItems}
                    />
                    <ClassVideoBanner
                        experienceTitle={experienceTitle}
                        videoBanner={videoBanner}
                        videoBannerAlt={videoBannerAlt}
                        videoSrc={videoSrc}
                    />
                </div>

                <div class="lt:w-[36%] w-full">
                    <ClassOverviewSection
                        intensityLevel={intensityLevel}
                        intensityBadgeClass={intensityBadgeClass}
                        category={category}
                        overview={overview}
                        benefits={benefits}
                    />
                    <ClassInstructorCard
                        instructor={instructor}
                        pageTitle={pageTitle}
                    />
                </div>
            </div>
        </div>
    </section>
    <!-- ====== End Main Content Section ====== -->

    <!-- ====== Start Pricing Section ====== -->
    <ClassPricingSection
        monthlyPlans={monthlyPlans}
        yearlyPlans={yearlyPlans}
    />
    <!-- ====== End Pricing Section ====== -->

    <!-- ====== Start Classes Section ====== -->
    <ClassRelatedSection
        relatedClasses={relatedClasses}
    />
    <!-- ====== End Classes Section ====== -->

    <!-- ====== Start Comments & Reply Section ====== -->
    <ClassCommentsSection />
    <!-- ====== End Comments & Reply Section ====== -->
</main>

<script src="./classDetailScript.ts"></script>
