---
interface Props {
    instructor: {
        name: string;
        bio: string;
        image: string;
        imageAlt: string;
        certifications: string[];
        instagram: string;
        twitter: string;
        facebook: string;
        youtube: string;
    };
    pageTitle?: string;
}

const { instructor } = Astro.props;
---
                    <div
                        class="flex flex-col 2xl:p-9 1xl:p-8.5 xl:p-7 lg:p-5.5 p-4 bg-whitesmoke-100 2xl:mb-12.5 1xl:mb-11 xl:mb-9 lg:mb-7 sm:mb-6 mb-4">
                        <div>
                            <h5
                                class="uppercase text-primary 1xl:pb-5 1xl:mb-5 lg:pb-4 lg:mb-4 sm:pb-3 sm:mb-3 pb-2.5 mb-2.5 border-b border-primary/50">
                                Meet the Instructor
                            </h5>
                        </div>
                        <div class="flex items-start 2xl:gap-5 sm:gap-3 gap-1.5 mb-2">
                            <div class="lt:w-[60%] w-[67%]">
                                <ul class="list-disc text-primary font-medium pl-4 1xl:space-y-2.5 space-y-1.5">
                                    <li>
                                        <p>Name : <span class="font-normal text-thunder-100">{instructor.name}</span></p>
                                    </li>
                                    <li>
                                        <p>Bio : <span class="font-normal text-thunder-100">
                                                {instructor.bio}
                                            </span></p>
                                    </li>
                                </ul>
                                <div class="lt:hidden sm:block hidden mt-2">
                                    <ul class="list-disc text-primary font-medium pl-4">
                                        <li>
                                            <p>Certifications :</p>
                                            <ul
                                                class="text-thunder-100 font-normal 1xl:space-y-2 space-y-1.5 1xl:pt-3.5 sm:pt-2 pt-1.5">
                                                {instructor.certifications.map((cert: string) => (
                                                    <li>
                                                        <p>- {cert}</p>
                                                    </li>
                                                ))}
                                            </ul>
                                        </li>
                                    </ul>
                                    <!-- Social Media Icons -->
                                    <div
                                        class="flex items-center flex-wrap 1xl:gap-9 xl:gap-7 md:gap-5 gap-3 1xl:mt-6 sm:mt-5 mt-4">
                                        <a href={instructor.instagram} target="_blank"
                                            class="1xl:size-12 lg:size-11 sm:size-9.5 size-8 lg:p-[10px] sm:p-[9px] p-[7px] btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px"
                                                viewBox="0 0 24 24" class="1xl:w-[26px] 1xl:h-[26px] w-5 h-5">
                                                <path fill="currentColor"
                                                    d="M13.028 2c1.125.003 1.696.009 2.189.023l.194.007c.224.008.445.018.712.03c1.064.05 1.79.218 2.427.465c.66.254 1.216.598 1.772 1.153a4.9 4.9 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428c.012.266.022.487.03.712l.006.194c.015.492.021 1.063.023 2.188l.001.746v1.31a79 79 0 0 1-.023 2.188l-.006.194c-.008.225-.018.446-.03.712c-.05 1.065-.22 1.79-.466 2.428a4.9 4.9 0 0 1-1.153 1.772a4.9 4.9 0 0 1-1.772 1.153c-.637.247-1.363.415-2.427.465l-.712.03l-.194.006c-.493.014-1.064.021-2.189.023l-.746.001h-1.309a78 78 0 0 1-2.189-.023l-.194-.006a63 63 0 0 1-.712-.031c-1.064-.05-1.79-.218-2.428-.465a4.9 4.9 0 0 1-1.771-1.153a4.9 4.9 0 0 1-1.154-1.772c-.247-.637-.415-1.363-.465-2.428l-.03-.712l-.005-.194A79 79 0 0 1 2 13.028v-2.056a79 79 0 0 1 .022-2.188l.007-.194c.008-.225.018-.446.03-.712c.05-1.065.218-1.79.465-2.428A4.9 4.9 0 0 1 3.68 3.678a4.9 4.9 0 0 1 1.77-1.153c.638-.247 1.363-.415 2.428-.465c.266-.012.488-.022.712-.03l.194-.006a79 79 0 0 1 2.188-.023zM12 7a5 5 0 1 0 0 10a5 5 0 0 0 0-10m0 2a3 3 0 1 1 .001 6a3 3 0 0 1 0-6m5.25-3.5a1.25 1.25 0 0 0 0 2.5a1.25 1.25 0 0 0 0-2.5" />
                                            </svg>
                                        </a>
                                        <a href={instructor.twitter} target="_blank"
                                            class="1xl:size-12 lg:size-11 sm:size-9.5 size-8 lg:p-[10px] sm:p-[9px] p-[7px] btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                viewBox="0 0 22 22" fill="none"
                                                class="1xl:w-[22px] 1xl:h-[22px] w-5 h-5">
                                                <path
                                                    d="M16.8407 1.65039L11.6141 7.62498L7.09475 1.65039H0.546875L8.36897 11.8776L0.955921 20.3504H4.12995L9.85137 13.8119L14.852 20.3504H21.2356L13.0819 9.57082L20.0127 1.65039H16.8407ZM15.7276 18.4516L4.25235 3.44873H6.13857L17.4852 18.4506L15.7276 18.4516Z"
                                                    fill="currentColor" />
                                            </svg>
                                        </a>
                                        <a href={instructor.facebook} target="_blank"
                                            class="1xl:size-12 lg:size-11 sm:size-9.5 size-8 lg:p-[10px] sm:p-[9px] p-[7px] btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px"
                                                viewBox="0 0 24 24" class="xl:w-[26px] xl:h-[26px] w-6 h-6">
                                                <path fill="currentColor"
                                                    d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4z" />
                                            </svg>
                                        </a>
                                        <a href={instructor.youtube} target="_blank"
                                            class="1xl:size-12 lg:size-11 sm:size-9.5 size-8 lg:p-[10px] sm:p-[9px] p-[7px] btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px"
                                                viewBox="0 0 24 24" class="xl:w-[26px] xl:h-[26px] w-6 h-6">
                                                <path fill="currentColor"
                                                    d="m10 15l5.19-3L10 9zm11.56-7.83c.13.47.22 1.1.28 1.9c.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83c-.25.9-.83 1.48-1.73 1.73c-.47.13-1.33.22-2.65.28c-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44c-.9-.25-1.48-.83-1.73-1.73c-.13-.47-.22-1.1-.28-1.9c-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83c.25-.9.83-1.48 1.73-1.73c.47-.13 1.33-.22 2.65-.28c1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44c.9.25 1.48.83 1.73 1.73" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="lt:w-[40%] w-[33%]">
                                <div
                                    class="w-full 2xl:h-[240px] 1xl:h-[210px] lt:h-[180px] sm:h-[245px] h-[100px] rounded-sm overflow-hidden">
                                    <img loading="lazy" src={instructor.image} alt={instructor.imageAlt}
                                        class="w-full h-full object-cover" />
                                </div>
                            </div>
                        </div>
                        <div class="lt:block sm:hidden block">
                            <ul class="list-disc text-primary font-medium pl-4">
                                <li>
                                    <p>Certifications :</p>
                                    <ul
                                        class="text-thunder-100 font-normal 1xl:space-y-2 space-y-1.5 1xl:pt-3.5 pt-2">
                                        {instructor.certifications.map((cert: string) => (
                                            <li>
                                                <p>- {cert}</p>
                                            </li>
                                        ))}
                                    </ul>
                                </li>
                            </ul>
                            <!-- Social Media Icons -->
                            <div
                                class="flex items-center flex-wrap 1xl:gap-9 xl:gap-7 md:gap-5 gap-3 1xl:mt-6 sm:mt-5 mt-4">
                                <a href={instructor.instagram} target="_blank"
                                    class="1xl:size-12 lg:size-11 sm:size-9.5 size-8 lg:p-[10px] sm:p-[9px] p-[7px] btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px"
                                        viewBox="0 0 24 24" class="1xl:w-[26px] 1xl:h-[26px] w-5 h-5">
                                        <path fill="currentColor"
                                            d="M13.028 2c1.125.003 1.696.009 2.189.023l.194.007c.224.008.445.018.712.03c1.064.05 1.79.218 2.427.465c.66.254 1.216.598 1.772 1.153a4.9 4.9 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428c.012.266.022.487.03.712l.006.194c.015.492.021 1.063.023 2.188l.001.746v1.31a79 79 0 0 1-.023 2.188l-.006.194c-.008.225-.018.446-.03.712c-.05 1.065-.22 1.79-.466 2.428a4.9 4.9 0 0 1-1.153 1.772a4.9 4.9 0 0 1-1.772 1.153c-.637.247-1.363.415-2.427.465l-.712.03l-.194.006c-.493.014-1.064.021-2.189.023l-.746.001h-1.309a78 78 0 0 1-2.189-.023l-.194-.006a63 63 0 0 1-.712-.031c-1.064-.05-1.79-.218-2.428-.465a4.9 4.9 0 0 1-1.771-1.153a4.9 4.9 0 0 1-1.154-1.772c-.247-.637-.415-1.363-.465-2.428l-.03-.712l-.005-.194A79 79 0 0 1 2 13.028v-2.056a79 79 0 0 1 .022-2.188l.007-.194c.008-.225.018-.446.03-.712c.05-1.065.218-1.79.465-2.428A4.9 4.9 0 0 1 3.68 3.678a4.9 4.9 0 0 1 1.77-1.153c.638-.247 1.363-.415 2.428-.465c.266-.012.488-.022.712-.03l.194-.006a79 79 0 0 1 2.188-.023zM12 7a5 5 0 1 0 0 10a5 5 0 0 0 0-10m0 2a3 3 0 1 1 .001 6a3 3 0 0 1 0-6m5.25-3.5a1.25 1.25 0 0 0 0 2.5a1.25 1.25 0 0 0 0-2.5" />
                                    </svg>
                                </a>
                                <a href={instructor.twitter} target="_blank"
                                    class="1xl:size-12 lg:size-11 sm:size-9.5 size-8 lg:p-[10px] sm:p-[9px] p-[7px] btn-secondary rounded-full flex items-center justify-center transition-all decoration-1000">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                        viewBox="0 0 22 22" fill="none" class="1xl:w-[22px] 1xl:h-[22px] w-5 h-5">
                                        <path
