---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;

  formEndpoint?: string;
  successMessage?: string;
  namePlaceholder?: string;
  emailPlaceholder?: string;
  buttonText?: string;

  quote?: string;
  quoteAuthor?: string;

  backgroundImage?: string;
  flowerImage?: string;
  image?: string;
  imageAlt?: string;
}

const {
  eyebrow = "Subscribe to the newsletter",
  title = "Feel Grounded. Feel Good.",
  description = `Welcome to your monthly dose of calm and inspiration. Here’s
what’s blooming this month in your yoga journey.`,

  formEndpoint = "",
  successMessage = "Subscribed successfully!",
  namePlaceholder = "Name",
  emailPlaceholder = "Email",
  buttonText = "Subscribe",

  quote = `"Your breath is your anchor. No matter where you are, it's
your way back to peace."`,
  quoteAuthor = "– With love & light",

  backgroundImage = "/Newsletter-Bg-Images.webp",
  flowerImage = "/flower-shape.svg",
  image = "/Newsletter-Images.webp",
  imageAlt = "newsletter yoga",
} = Astro.props;
---

<section
  class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10"
>
  <div class="container">

    <div
      class="rounded border border-primary/50 relative overflow-hidden"
    >

      <!-- Background -->
      <div
        class="absolute top-0 left-0 w-full h-full bg-whitesmoke-200"
      >
        <img
          loading="lazy"
          decoding="async"
          src={backgroundImage}
          class="w-full h-full object-cover opacity-[0.03]"
          alt="Newsletter Bg Images"
        />
      </div>

      <div
        class="flex justify-between md:flex-row flex-col items-center lt:gap-7.5 gap-2.5 relative md:py-0 py-9 lg:px-[55px] lt:px-8 md:px-6.5 px-4"
      >

        <!-- Left: Copy + Form -->
        <div
          class="w-full max-w-[903px] 2xl:py-20 1xl:py-18 xl:py-16 lg:py-14 lg::py-12 md:py-8"
        >

          <div
            class="xl:space-y-4.5 md:space-y-4 space-y-3.5"
          >
            <h3
              class="text-thunder-100 font-primary italic font-medium"
            >
              {eyebrow}
            </h3>

            <h2
              class="text-primary font-normal uppercase"
            >
              {title}
            </h2>

            <p class="text-thunder-100 max-w-[752px]">
              {description}
            </p>
          </div>

          <!-- Newsletter Form -->
          <form
            id="validate-form"
            data-endpoint={formEndpoint}
            novalidate
            data-success={successMessage}
            class="validate-form 2xl:my-10 1xl:my-9 xl:my-8 lg:my-7.5 md:my-7 sm:my-6.5 my-6 max-w-[560px]"
          >

            <!-- Name -->
            <div class="sm:mb-4 mb-3">
              <input
                type="text"
                name="name"
                placeholder={namePlaceholder}
                required
                class="type-filed p placeholder:text-thunder-100 bg-white"
              />
            </div>

            <!-- Email -->
            <div class="sm:mb-4 mb-3">
              <input
                type="email"
                name="email"
                placeholder={emailPlaceholder}
                required
                class="type-filed p placeholder:text-thunder-100 bg-white"
              />
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="w-full btn btn-secondary"
            >
              {buttonText}
            </button>

            <!-- Success Message -->
            <p
              class="form-success-msg hidden"
              aria-live="polite"
            ></p>

          </form>

          <!-- Quote -->
          <p
            class="text-primary font-medium sm:mb-[18px] mb-[14px] font-primary"
          >
            {quote}
          </p>

          <p>{quoteAuthor}</p>

        </div>

        <!-- Right: Image -->
        <div
          class="w-full 1xl:max-w-[700px] lt:max-w-[530px] max-w-[330px] md:py-5"
        >

          <!-- Decorative Flower -->
          <div
            class="pointer-events-none absolute top-0 right-0 max-[2600px]:w-[clamp(16.5%,11.2vw,25%)] opacity-13 hidden md:block"
          >
            <img
              loading="lazy"
              src={flowerImage}
              alt="decor"
              class="w-full h-full object-contain"
            />
          </div>

          <!-- Newsletter Image -->
          <img
            loading="lazy"
            src={image}
            alt={imageAlt}
            class="w-full h-full object-contain"
          />

        </div>

      </div>
    </div>
  </div>
</section>