---
interface Props {
  image?: string;
  imageAlt?: string;
  video?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  image = "/yoga-made-simple.webp",
  imageAlt = "Yoga by nature",
  video = "/video/yoga.mp4",
  eyebrow = "Yoga Made Simple",
  title = "Find Peace Where Nature and Stillness Meet",
  description = `Escape the noise and immerse yourself in a tranquil yoga
  retreat designed to heal, restore, and inspire.`,
  buttonText = "Transform Your Mind and Body",
  buttonHref = "/classes/classOne/",
} = Astro.props;
---

<section
  class="relative w-full overflow-hidden bg-fantasy-100 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10"
>
  <div
    class="1xl:h-[600px] xl:h-[550px] lg:h-[445px] md:h-[390px] relative md:flex items-center h-full"
  >
    <!-- gradient overlay right side for text contrast -->
    <div class="md:absolute relative inset-0">
      <div
        class="absolute md:top-0 top-1/2 inset-0 md:left-auto md:right-0 right-1/2 md:w-[55%] w-full h-full md:bg-linear-to-l bg-linear-to-t from-60% from-[#F6F2F0] to-[#F6F2F0]/0"
      >
      </div>

      <img
        loading="lazy"
        decoding="async"
        src={image}
        alt={imageAlt}
        class="lt:w-[68%] md:w-[73%] w-full h-full object-cover object-center"
      />

      <div
        class="absolute top-0 h-full md:w-[33%] w-full pointer-events-auto"
      >
        <!-- Left play button -->
        <div
          class="flex md:justify-end justify-center relative m-auto w-full h-full items-center"
        >
          <a
            href={video}
            class="video-popup group/video_popup pointer-events-all relative inline-flex items-center justify-center 2xl:w-25 2xl:h-25 1xl:w-24 1xl:h-24 xl:w-22 xl:h-22 lg:w-20 lg:h-20 md:w-18 md:h-18 sm:w-16 sm:h-16 w-13.5 h-13.5 rounded-full bg-white/50 md:p-[7px] p-1"
          >
            <div
              class="absolute inset-0 animate-ping w-full h-full rounded-full bg-white/50"
            ></div>

            <span
              class="relative w-full h-full rounded-full bg-white flex items-center justify-center md:p-[5px] p-[3px]"
            >
              <span
                class="w-full h-full rounded-full bg-white flex items-center justify-center group-hover/video_popup:border-thunder-100 md:border-2 border border-primary transition-all decoration-300"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  class="2xl:size-9 1xl:size-8 xl:size-7.5 lg:size-6.5 sm:size-5.5 size-5 group-hover/video_popup:text-thunder-100 text-primary transition-all decoration-300"
                >
                  <path
                    fill="currentColor"
                    d="M21.409 9.353a2.998 2.998 0 0 1 0 5.294L8.597 21.614C6.534 22.737 4 21.277 4 18.968V5.033c0-2.31 2.534-3.769 4.597-2.648z"
                    stroke-width="0.5"
                    stroke="currentColor"
                  ></path>
                </svg>
              </span>
            </span>
          </a>
        </div>
      </div>
    </div>

    <div class="container relative h-full pointer-events-none">
      <!-- Right text -->
      <div
        class="2xl:py-20 1xl:py-16 xl:py-14 lg:py-12 md:py-10 sm:pb-8 pb-6 md:absolute md:top-0 md:right-0 relative max-md:container 2xl:max-w-[49%] 1xl:max-w-[52%] xl:max-w-[47%] lg:max-w-[53%] md:max-w-[48%] w-full h-full flex items-start flex-col justify-center"
      >
        <div>
          <h3
            class="text-thunder-100 font-primary italic font-medium 1xl:mb-7.5 lg:mb-6 md:mb-5 sm:mb-4 mb-2.5"
          >
            {eyebrow}
          </h3>

          <h2 class="text-primary font-normal uppercase 1xl:mb-5 mb-3">
            {title}
          </h2>

          <p class="text-thunder-100 mix-blend-multiply">
            {description}
          </p>

          <a
            href={buttonHref}
            class="btn btn-secondary lg:mt-10 mt-6 pointer-events-auto"
          >
            {buttonText}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>