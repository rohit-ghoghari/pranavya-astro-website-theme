---
interface InstagramPost {
  image: string;
  alt?: string;
  href?: string;
}

interface Props {
  posts?: InstagramPost[];
  instagramUrl?: string;
}

const {
  instagramUrl = "https://www.instagram.com/",
  posts = [
    {
      image: "/instagram_style_1_img_1.webp",
      alt: "instagram_style_1_images_1",
    },
    {
      image: "/instagram_style_1_img_2.webp",
      alt: "instagram_style_1_images_2",
    },
    {
      image: "/instagram_style_1_img_3.webp",
      alt: "instagram_style_1_images_3",
    },
    {
      image: "/instagram_style_1_img_4.webp",
      alt: "instagram_style_1_images_4",
    },
    {
      image: "/instagram_style_1_img_5.webp",
      alt: "instagram_style_1_images_5",
    },
    {
      image: "/instagram_style_1_img_6.webp",
      alt: "instagram_style_1_images_6",
    },
  ],
} = Astro.props;
---

<section
  class="relative 2xl:pb-25 1xl:pb-20 xl:pb-16 lg:pb-14 md:pb-12 sm:pb-10 pb-10 bg-white"
>
  <!-- Instagram Swiper -->
  <div class="instagram_swiper_style_1 swiper">
    <div class="swiper-wrapper">

      {posts.map((post) => (
        <div class="swiper-slide">

          <a
            href={post.href ?? instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="relative group cursor-pointer"
          >
            <!-- Image -->
            <div
              class="relative before:content-[''] before:block before:pt-[145%] overflow-hidden"
            >
              <img
                loading="lazy"
                decoding="async"
                src={post.image}
                alt={post.alt ?? "Instagram image"}
                class="absolute left-0 top-0 w-full h-full object-cover object-center scale-101 group-hover:scale-110 origin-center transition-all duration-1000"
              />
            </div>

            <!-- Hover Overlay -->
            <div
              class="absolute inset-0 bg-linear-to-b from-black-200/0 to-black-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
            >
              <div
                class="bg-white rounded-full overflow-hidden size-12 flex items-center justify-center"
              >
                <!-- Instagram Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <path
                    d="M6.76667 0H16.5667C20.3 0 23.3333 3.03333 23.3333 6.76667V16.5667C23.3333 18.3613 22.6204 20.0824 21.3514 21.3514C20.0824 22.6204 18.3613 23.3333 16.5667 23.3333H6.76667C3.03333 23.3333 0 20.3 0 16.5667V6.76667C0 4.97203 0.712915 3.25091 1.98191 1.98191C3.25091 0.712915 4.97203 0 6.76667 0ZM6.53333 2.33333C5.41942 2.33333 4.35114 2.77583 3.56348 3.56348C2.77583 4.35114 2.33333 5.41942 2.33333 6.53333V16.8C2.33333 19.1217 4.21167 21 6.53333 21H16.8C17.9139 21 18.9822 20.5575 19.7698 19.7698C20.5575 18.9822 21 17.9139 21 16.8V6.53333C21 4.21167 19.1217 2.33333 16.8 2.33333H6.53333ZM17.7917 4.08333C18.1784 4.08333 18.5494 4.23698 18.8229 4.51047C19.0964 4.78396 19.25 5.15489 19.25 5.54167C19.25 5.92844 19.0964 6.29937 18.8229 6.57286C18.5494 6.84635 18.1784 7 17.7917 7C17.4049 7 17.034 6.84635 16.7605 6.57286C16.487 6.29937 16.3333 6.84635 16.7605 6.57286C16.487 6.29937 16.3333 5.92844 16.3333 5.54167C16.3333 5.15489 16.487 4.78396 16.7605 4.51047C17.034 4.23698 17.4049 4.08333 17.7917 4.08333ZM11.6667 5.83333C13.2138 5.83333 14.6975 6.44791 15.7915 7.54188C16.8854 8.63584 17.5 10.1196 17.5 11.6667C17.5 13.2138 16.8854 14.6975 15.7915 15.7915C14.6975 16.8853 13.2138 17.5 11.6667 17.5C10.1196 17.5 8.63584 16.8855 7.54188 15.7915C6.44791 14.6975 5.83333 13.2138 5.83333 11.6667C5.83333 10.1196 6.44791 8.63584 7.54188 7.54188C8.63584 6.44791 10.1196 5.83333 11.6667 5.83333ZM11.6667 8.16667C10.7384 8.16667 9.84817 8.53541 9.19179 9.19179C8.53541 9.84817 8.16667 10.7384 8.16667 11.6667C8.16667 12.5949 8.53541 13.4852 9.19179 14.1415C9.84817 14.7979 10.7384 15.1667 11.6667 15.1667C12.5949 15.1667 13.4852 14.7979 14.1415 14.1415C14.7979 13.4852 15.1667 12.5949 15.1667 11.6667C15.1667 10.7384 14.7979 9.84817 14.1415 9.19179C13.4852 8.53541 12.5949 8.16667 11.6667 8.16667Z"
                    fill="#673e2c"
                  />
                </svg>
              </div>
            </div>
          </a>

        </div>
      ))}

    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";

  import "swiper/css";

  const initInstagramSwiper = () => {
    const slider = document.querySelector(
      ".instagram_swiper_style_1"
    ) as HTMLElement | null;

    if (!slider) return;

    // Prevent duplicate initialization
    if (slider.dataset.initialized === "true") return;

    new Swiper(slider, {
      modules: [Autoplay],

      loop: true,

      speed: 1000,

      autoplay: {
        delay: 2500,
        disableOnInteraction: false,
      },

      slidesPerView: 2,

      spaceBetween: 0,

      breakpoints: {
        640: {
          slidesPerView: 3,
        },

        1024: {
          slidesPerView: 4,
        },

        1280: {
          slidesPerView: 5,
        },

        1536: {
          slidesPerView: 6,
        },
      },
    });

    slider.dataset.initialized = "true";
  };

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initInstagramSwiper
    );
  } else {
    initInstagramSwiper();
  }

  document.addEventListener(
    "astro:page-load",
    initInstagramSwiper
  );
</script>