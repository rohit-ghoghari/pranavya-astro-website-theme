---
interface AboutBullet {
    text: string;
}

interface Props {
    decorativeImage?: string;
    decorativeAlt?: string;
    image?: string;
    imageAlt?: string;
    eyebrow?: string;
    title?: string;
    description?: string;
    bullets?: AboutBullet[];
    buttonText?: string;
    buttonHref?: string;
}

const {
    decorativeImage = "/flower-shape.svg",
    decorativeAlt = "decor",

    image = "/about-img.webp",
    imageAlt = "About Image",

    eyebrow = "About Us",

    title = "Discover Balance, Embrace Serenity",

    description = `At Pranavya Yoga, we create a modern sanctuary for wellness,
where the wisdom of ancient yoga meets the rhythm of
contemporary living. Rooted in tradition yet open to evolution,
our studio offers a space that nurtures both the body and the
mind encouraging balance, strength, and self-awareness in a
fast-paced world.`,

    bullets = [
        {
            text: "Come breathe and move freely.",
        },
        {
            text: "Step into stillness and movement.",
        },
        {
            text: "Reconnect with the calm inside you.",
        },
        {
            text: "Awaken the balance within you.",
        },
    ],

    buttonText = "Begin Your Journey",
    buttonHref = "/about/",
} = Astro.props;
---

<section class="relative bg-white 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10">
    <!-- Decorative Flower -->
    <div class="pointer-events-none absolute top-0 left-auto right-[85px] max-[2600px]:w-[clamp(12.5%,11.2vw,25%)] opacity-20 hidden md:block">
        <img
            loading="lazy"
            src={decorativeImage}
            alt={decorativeAlt}
            class="w-full h-full object-contain"
        >
    </div>

    <div class="container">
        <div class="flex lg:items-center items-start md:flex-row flex-col 2xl:gap-16 1xl:gap-14 xl:gap-12 lg:gap-11 md:gap-9 sm:gap-7 gap-5">

            <!-- Left: Image -->
            <div class="w-full 1xl:max-w-[748px] max-w-[560px] md:sticky md:top-24">
                <div class="rounded overflow-hidden relative before:content-[''] before:block 1xl:before:pt-[98%] xl:before:pt-[106%] md:before:pt-[122%] before:pt-[100%] w-full">
                    <img
                        loading="lazy"
                        decoding="async"
                        src={image}
                        alt={imageAlt}
                        class="absolute top-0 left-0 w-full h-full object-cover"
                    >
                </div>
            </div>

            <!-- Right: Content -->
            <div class="w-full">

                <h3 class="text-thunder-100 font-primary italic font-medium 1xl:mb-7 lg:mb-6 md:mb-5 sm:mb-4 mb-2.5">
                    {eyebrow}
                </h3>

                <h2 class="text-primary font-normal uppercase 1xl:mb-5 mb-3">
                    {title}
                </h2>

                <p class="text-thunder-100 max-w-[890px]">
                    {description}
                </p>

                <!-- Bullets -->
                <ul class="2xl:mt-9 1xl:mt-8.5 xl:mt-8 lg:mt-7 md:mt-6 sm:mt-5 mt-4 2xl:gap-7.5 1xl:gap-4 sm:gap-3 gap-3 grid xl:grid-cols-2 grid-cols-1">

                    {bullets.map((bullet) => (
                        <ul class="flex items-center md:gap-2.5 gap-2">
                            <span class="shrink-0 whitespace-nowrap 1xl:w-7.5 xl:w-7 lg:w-6 md:w-5 w-4 h-full">
                                <img
                                    loading="lazy"
                                    src="/bullets-point.svg"
                                    alt="Bullets Point"
                                >
                            </span>

                            <p class="text-primary font-medium p2">
                                {bullet.text}
                            </p>
                        </ul>
                    ))}

                </ul>

                <div class="2xl:mt-11.5 1xl:mt-11 xl:mt-10 lg:mt-9 md:mt-8 sm:mt-7 mt-6">
                    <a href={buttonHref} class="btn btn-secondary">
                        {buttonText}
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>