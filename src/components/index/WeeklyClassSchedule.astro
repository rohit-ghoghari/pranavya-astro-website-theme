---
import {
  defaultWeeklyScheduleIndex1,
  type DaySchedule,
} from "../../data/scheduleIndex1";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  flowerImage?: string;
  bookClassHref?: string;
  days?: DaySchedule[];
}

const {
  eyebrow = "Weekly Class Schedule",
  title = "Move mindfully. Grow at your pace.",
  description = "Our weekly schedule offers a balanced mix of classes for all levels. Whether you’re starting your journey or deepening your practice, there’s a session designed just for you. Join us in-studio or online, morning or evening.",
  flowerImage = "/flower-shape.svg",
  bookClassHref = "/bookClass/",
  days = defaultWeeklyScheduleIndex1,
} = Astro.props;
---

<section
  class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 bg-white"
>
  <div id="schedule" class="schedule-1">

    <!-- Decorative Flower -->
    <div
      class="pointer-events-none absolute 2xl:-top-[100px] 1xl:-top-20 xl:-top-17 lg:-top-14 md:-top-12 sm:-top-11 -top-10 left-0 max-2xl:w-[clamp(18%,11.2vw,30%)] hidden md:block opacity-20"
    >
      <img
        loading="lazy"
        src={flowerImage}
        alt="decor"
        class="w-full h-full object-contain"
      />
    </div>

    <div class="container relative z-10">

      <!-- Intro -->
      <div
        class="text-center 1xl:max-w-[75%] lt:max-w-4/5 mx-auto lg:mb-10 mb-7"
      >
        <h3
          class="text-thunder-100 font-primary italic font-medium xl:mb-7 lg:mb-6 md:mb-5 sm:mb-4 mb-2.5"
        >
          {eyebrow}
        </h3>

        <h2 class="text-primary font-normal uppercase 1xl:mb-5 mb-3">
          {title}
        </h2>

        <p>
          {description}
        </p>
      </div>

      <!-- Day Tabs -->

      <!-- Mobile -->
      <div>
        <div class="md:hidden relative w-full">
          <select
            id="scheduleSelect"
            class="w-full sm:px-5 sm:py-3 px-4 py-2 bg-primary text-white font-Work border border-primary focus:outline-none appearance-none select-arrow"
          >
            {days.map((day) => (
              <option value={`#${day.id}`}>{day.name}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Desktop -->
      <div class="overflow-x-auto md:block hidden">
        <div class="inline-flex min-w-full border border-primary overflow-hidden">
          {days.map((day, index) => (
            <button
              class:list={[
                "schedule-tab rounded-none text-primary font-Work border-r w-full border-primary",
                index === days.length - 1 && "border-r-0",
                index === 0 && "is-active",
              ]}
              data-target={`#${day.id}`}
            >
              {day.name}
            </button>
          ))}
        </div>
      </div>

      <!-- Tables by Day -->
      <div class="xl:mt-8 mt-5">

        {days.map((day, dayIndex) => (
          <div
            id={day.id}
            class:list={[
              "schedule-panel",
              dayIndex !== 0 && "hidden",
            ]}
          >
            <div class="overflow-x-auto lt:space-y-0 sm:space-y-6 space-y-4">

              {day.items.map((item) => (
                <div
                  class="2xl:px-[58px] 1xl:px-11 xl:px-9 lt:px-5 lt:flex grid grid-cols-1 lt:divide-none divide-y divide-primary/20 lt:gap-6 items-stretch lt:border-b lt:border-t-0 lt:border-l-0 lt:border-r-0 border border-primary/20 1xl:py-6 xl:py-5 lt:py-[18px] p-0 bg-white lt:hover:bg-whitesmoke-100"
                >

                  <!-- TIME -->
                  <div
                    class="1xl:w-[22%] lt:w-[20%] w-full flex lt:flex-col flex-row lt:items-start items-center lt:divide-none divide-x divide-primary/20"
                  >
                    <div
                      class="flex items-center flex-wrap 1xl:mb-[22px] lt:mb-4 gap-1 lt:w-full w-1/2 lt:p-0 md:p-4 p-3"
                    >
                      <h5 class="text-primary uppercase">Time</h5>
                      <p>{item.timeOfDay}</p>
                    </div>

                    <p class="lt:w-full w-1/2 lt:p-0 md:p-4 p-3">
                      {item.time}
                    </p>
                  </div>

                  <!-- CLASS -->
                  <div
                    class="flex lt:flex-col flex-row 1xl:gap-2.5 xl:gap-2 lt:gap-[6px] lg:w-[22%] lt:w-[24%] w-full lt:divide-none divide-x divide-primary/20"
                  >
                    <h5
                      class="text-primary uppercase lt:w-full w-1/2 lt:p-0 md:p-4 p-3"
                    >
                      Class
                    </h5>

                    <div
                      class="flex flex-col 1xl:gap-2.5 xl:gap-2 gap-[6px] lt:w-full w-1/2 lt:p-0 md:p-4 p-3"
                    >
                      {item.classes.map((className) => (
                        <p>{className}</p>
                      ))}
                    </div>
                  </div>

                  <!-- LEVEL -->
                  <div
                    class="flex lt:flex-col flex-row 1xl:gap-2.5 xl:gap-2 lt:gap-[6px] 1xl:w-[18%] lg:w-[16%] lt:w-[14%] w-full lt:divide-none divide-x divide-primary/20"
                  >
                    <h5
                      class="text-primary uppercase lt:w-full w-1/2 lt:p-0 md:p-4 p-3"
                    >
                      Level
                    </h5>

                    <div
                      class="flex flex-col 1xl:gap-2.5 xl:gap-2 gap-[6px] lt:w-full w-1/2 lt:p-0 md:p-4 p-3"
                    >
                      {item.levels.map((level) => (
                        <p>{level}</p>
                      ))}
                    </div>
                  </div>

                  <!-- TRAINER -->
                  <div
                    class="lt:w-[22%] w-full flex lt:flex-col flex-row lt:divide-none divide-x divide-primary/20"
                  >
                    <h5
                      class="text-primary uppercase 1xl:mb-5 lt:mb-4 lt:w-full w-1/2 lt:p-0 md:p-4 p-3"
                    >
                      Trainer
                    </h5>

                    <div
                      class="flex items-center flex-wrap sm:gap-[14px] gap-[10px] lt:p-0 md:p-4 p-3 lt:w-full w-1/2"
                    >
                      <div
                        class="1xl:w-[54px] 1xl:h-[54px] xl:w-[50px] xl:h-[50px] md:w-12 md:h-12 sm:w-9 sm:h-9 w-8 h-8 rounded-full overflow-hidden shrink-0"
                      >
                        <img
                          loading="lazy"
                          src={item.trainerImage}
                          alt={item.trainerAlt ?? item.trainer}
                          class="w-full h-full rounded-full"
                        />
                      </div>

                      <p>{item.trainer}</p>
                    </div>
                  </div>

                  <!-- ACTION -->
                  <div
                    class="1xl:w-[10%] lt:w-[14%] w-full flex lt:flex-col flex-row lt:items-start items-center lt:divide-none divide-x divide-primary/20"
                  >
                    <h5
                      class="text-primary uppercase 1xl:mb-5 lt:mb-4 lt:w-full w-1/2 lt:p-0 md:p-4 p-3"
                    >
                      Action
                    </h5>

                    <a
                      href={bookClassHref}
                      class="text-thunder-100 hover:text-primary hover:underline decoration-1 flex items-center flex-wrap sm:gap-1 gap-0.5 lt:p-1 md:p-4 p-3 lt:w-full w-1/2"
                    >
                      Book Now

                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="27"
                        height="27"
                        viewBox="0 0 27 27"
                        fill="none"
                        class="2xl:w-[27px] 2xl:h-[27px] sm:w-[25px] sm:h-[25px] w-5 h-5"
                      >
                        <g clip-path="url(#clip0_3130_6678)">
                          <path
                            d="M8.37896 18.7836L19.207 7.95556M19.207 7.95556C19.4636 8.21217 19.62 8.56903 19.616 8.96328L19.5384 16.6458M19.207 7.95556C18.9504 7.69895 18.5935 7.54257 18.1993 7.54655L10.5168 7.62418"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </g>
                      </svg>
                    </a>
                  </div>

                </div>
              ))}

            </div>
          </div>
        ))}

      </div>
    </div>
  </div>
</section>




<script>
  const initScheduleTabs = () => {
    const tabs = document.querySelectorAll<HTMLElement>(".schedule-tab");
    const panels = document.querySelectorAll<HTMLElement>(".schedule-panel");
    const select = document.querySelector<HTMLSelectElement>("#scheduleSelect");

    if (!tabs.length || !panels.length) return;

    const showPanel = (target: string) => {
      // Hide every panel
      panels.forEach((panel) => {
        panel.classList.add("hidden");
      });

      // Show selected panel
      const activePanel = document.querySelector<HTMLElement>(target);

      if (activePanel) {
        activePanel.classList.remove("hidden");
      }

      // Update desktop active tab
      tabs.forEach((tab) => {
        tab.classList.remove("is-active");

        if (tab.dataset.target === target) {
          tab.classList.add("is-active");
        }
      });

      // Keep mobile select synchronized
      if (select) {
        select.value = target;
      }
    };

    // Desktop tabs
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.target;

        if (target) {
          showPanel(target);
        }
      });
    });

    // Mobile dropdown
    select?.addEventListener("change", () => {
      showPanel(select.value);
    });

    // Initial state
    const activeTab =
      document.querySelector<HTMLElement>(".schedule-tab.is-active");

    const initialTarget =
      activeTab?.dataset.target ||
      select?.value ||
      "#sun";

    showPanel(initialTarget);
  };

  document.addEventListener("DOMContentLoaded", initScheduleTabs);
</script>