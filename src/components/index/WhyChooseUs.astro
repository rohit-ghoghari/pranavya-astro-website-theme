---
interface Feature {
    icon: string;
    iconAlt: string;
    title: string;
    description: string;
}

interface Props {
    image?: string;
    imageAlt?: string;
    eyebrow?: string;
    title?: string;
    description?: string;
    features?: Feature[];
}

const {
    image = "/why-choose-us.webp",
    imageAlt = "Yoga",

    eyebrow = "Why Choose Us",

    title = "Guiding Your Path to Wellness",

    description = `Our weekly schedule offers a balanced mix of classes for all
levels. Whether you’re starting your journey or deepening your
practice, there’s a session designed just for you. Join us
in-studio or online, morning or evening.`,

    features = [
        {
            icon: "/why-choose-us-icon-1.svg",
            iconAlt: "Personalized Yoga",
            title: "Personalized Yoga",
            description: "Custom guidance that fits your body and flow.",
        },
        {
            icon: "/why-choose-us-icon-2.svg",
            iconAlt: "yoga Workshops",
            title: "yoga Workshops",
            description:
                "Supportive, body-aware instruction in every session.",
        },
        {
            icon: "/why-choose-us-icon-3.svg",
            iconAlt: "Yoga Retreats",
            title: "Yoga Retreats",
            description:
                "One-on-one sessions crafted for your unique journey.",
        },
        {
            icon: "/why-choose-us-icon-4.svg",
            iconAlt: "Flexible Class",
            title: "Flexible Class",
            description:
                "Adaptable teaching to match your rhythm and goals.",
        },
    ],
} = Astro.props;
---

<section class="relative bg-white 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10">
    <div class="container">
        <div class="flex justify-between lt:flex-row flex-col 2xl:gap-22.5 1xl:gap-20 lg:gap-12 md:gap-10 sm:gap-8 gap-6 xl:items-center items-start">

            <!-- Left: Image -->
            <div class="lt:sticky relative lt:top-20 top-0 w-full lg:max-w-[44%]">
                <div class="overflow-hidden relative before:block before:content-[''] 1xl:before:pt-[116%] lg:before:pt-[130%] before:pt-[110%]">
                    <img
                        loading="lazy"
                        decoding="async"
                        src={image}
                        alt={imageAlt}
                        class="w-full h-full object-cover object-center absolute top-0 left-0"
                    >
                </div>
            </div>

            <!-- Right: Content -->
            <div class="w-full lg:max-w-[56%]">

                <h3 class="text-thunder-100 font-primary italic font-medium 2xl:mb-7.5 1xl:mb-6 md:mb-4 sm:mb-3 mb-2.5">
                    {eyebrow}
                </h3>

                <h2 class="text-primary font-normal uppercase 1xl:mb-5 mb-3">
                    {title}
                </h2>

                <p>
                    {description}
                </p>

                <div class="2xl:mt-15 1xl:mt-14 mt-6 grid xl:grid-cols-2 lt:grid-cols-1 md:grid-cols-2 sm:grid-cols-2 grid-cols-1 2xl:gap-12.5 1xl:gap-8 md:gap-6 sm:gap-5.5 gap-5">

                    {features.map((feature) => (
                        <div class="group border border-primary/15 bg-transparent 2xl:p-6 sm:p-4 p-3.5 hover:bg-whitesmoke-100 hover:border-whitesmoke-100 transition-all duration-300">

                            <div class="flex 1xl:gap-6 gap-4">

                                <div class="2xl:w-13.5 2xl:h-13.5 1xl:w-12 1xl:h-12 lg:w-10 lg:h-10 md:w-10 md:h-10 w-9 h-9 shrink-0">
                                    <img
                                        loading="lazy"
                                        src={feature.icon}
                                        alt={feature.iconAlt}
                                        class="w-full h-full object-cover"
                                    >
                                </div>

                                <div>

                                    <h5 class="uppercase group-hover:text-primary text-black-100 transition-all duration-300 lg:mb-3.5 mb-3">
                                        {feature.title}
                                    </h5>

                                    <p>
                                        {feature.description}
                                    </p>

                                </div>

                            </div>

                        </div>
                    ))}

                </div>

            </div>
        </div>
    </div>
</section>