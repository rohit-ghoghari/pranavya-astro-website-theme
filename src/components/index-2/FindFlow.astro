---
const classes = [
    {
        title: "Hatha Yoga",
        description: "Balanced & Foundational",
        image: "/nav-class-1.webp",
        alt: "Hatha Yoga",
        href: "/classes/hatha-yoga/",
    },
    {
        title: "Vinyasa Flow",
        description: "Dynamic & Energizing",
        image: "/nav-class-2.webp",
        alt: "Vinyasa Flow",
        href: "/classes/vinyasa-flow/",
    },
    {
        title: "Gentle Flow",
        description: "Slow, Soothing, Centered",
        image: "/nav-class-3.webp",
        alt: "Gentle Flow",
        href: "/classes/restorative-yoga/",
    },
    {
        title: "Yin & Restore",
        description: "Deep & Meditative",
        image: "/nav-class-4.webp",
        alt: "Yin & Restore",
        href: "/classes/yin-restore/",
    },
];

const classesSection = {
    eyebrow: "Find Your Flow",
    title: "Classes That Move You Inside & Out",
    description:
        "Every body is different, and so is every class. At Pranavya Yoga, our sessions are crafted to meet you where you are with space to grow, breathe, and simply be.",
    buttonText: "Discover Our Classes",
    buttonHref: "/classes/classOne/",
};
---

<section
    class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full 2xl:py-20 1xl:py-17 lg:py-14 md:py-12 sm:py-11 py-10 bg-whitesmoke-200"
>
    <div class="container">
        <div
            class="flex flex-col items-center justify-center 1xl:mb-[50px] sm:mb-11 mb-10"
        >
            <h3
                class="font-primary italic font-medium 2xl:mb-7 1xl:mb-6 xl:mb-5 sm:mb-3 mb-2.5 text-center"
            >
                {classesSection.eyebrow}
            </h3>

            <h2
                class="text-primary uppercase 1xl:mb-5 mb-3 text-center"
            >
                {classesSection.title}
            </h2>

            <p
                class="2xl:w-[51%] xl:w-[56%] lg:w-[67%] lt:w-[75%] w-full text-center"
            >
                {classesSection.description}
            </p>
        </div>

        <div
            class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 1xl:gap-[30px] xl:gap-6 gap-5"
        >
            {
                classes.map((item) => (
                    <a
                        href={item.href}
                        class="block overflow-hidden relative shrink-0 before:content-[''] xl:before:pt-[119%] sm:before:pt-[135%] before:pt-[115%] before:block w-full h-full group/class"
                        data-aos="fade-up"
                    >
                        <img
                            loading="lazy"
                            decoding="async"
                            src={item.image}
                            alt={item.alt}
                            class="w-full h-full object-cover absolute top-0 left-0 bottom-0 right-0 group-hover/class:scale-105 scale-100 transition-all ease-in-out duration-350"
                        />

                        <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent">
                        </div>

                        <div class="absolute bottom-0 left-0 text-white backdrop-blur-xs w-full">
                            <div class="2xl:p-5 1xl:p-4 p-[14px]">
                                <div class="flex items-center justify-between w-full gap-3 1xl:mb-[10px] mb-2">
                                    <h3 class="font-normal font-secondary uppercase hover:underline underline-offset-1 decoration-1 text-white!">
                                        {item.title}
                                    </h3>

                                    <div class="rounded-full border border-white shrink-0 2xl:size-11 lt:size-10 size-9 flex items-center justify-center nav-class-arrow">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="18"
                                            height="14"
                                            viewBox="0 0 11 11"
                                            fill="none"
                                            class="mt-px ml-px stroke-white! group-hover:stroke-primary!"
                                        >
                                            <path
                                                d="M0.692504 9.68278C0.692504 9.68278 6.5362 3.54949 8.97019 0.994861M8.97019 0.994861L9.59281 7.58973M8.97019 0.994861L2.35248 0.69208"
                                                stroke="currentColor"
                                                stroke-width="1.38442"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            ></path>
                                        </svg>
                                    </div>
                                </div>

                                <p class="text-white!">
                                    {item.description}
                                </p>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>

        <a
            href={classesSection.buttonHref}
            class="btn btn-secondary mt-[50px] mx-auto"
        >
            {classesSection.buttonText}
        </a>
    </div>
</section>