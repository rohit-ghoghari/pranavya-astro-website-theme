---
import {
    defaultScheduleIndex2,
    type ScheduleDay,
} from "../../data/scheduleIndex2";

interface Props {
    titleEyebrow?: string;
    title?: string;
    description?: string;
    schedule?: ScheduleDay[];
    activeDay?: string;
    bookClassHref?: string;
}

const {
    titleEyebrow = "Weekly Class Schedule",
    title = "Find the Flow That Fits You",
    description =
        "Stay consistent, stay grounded. Whether you're an early riser or prefer evening calm, our weekly schedule has something for every body and every pace.",
    bookClassHref = "/bookClass/",
    activeDay = "sun",
    schedule = defaultScheduleIndex2,
} = Astro.props;
---

<section
    class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 bg-white"
>
    <div id="schedule" class="schedule-2">
        <div class="container relative z-10">

            <div
                class="text-center 1xl:max-w-[965px] xl:max-w-[810px] md:max-w-[680px] max-w-full w-full mx-auto mb-10"
            >
                <h3
                    class="font-primary italic font-medium 2xl:mb-7 1xl:mb-6 xl:mb-5 sm:mb-3 mb-2.5 text-center"
                >
                    {titleEyebrow}
                </h3>

                <h2
                    class="text-primary uppercase 1xl:mb-5 mb-3 text-center"
                >
                    {title}
                </h2>

                <p>
                    {description}
                </p>
            </div>

            <!-- Day Tabs -->
            <div>
                <div class="md:hidden relative w-full">
                    <select
                        id="scheduleSelect"
                        class="w-full sm:px-5 sm:py-3 px-4 py-2 bg-primary text-white font-Work border border-primary focus:outline-none appearance-none select-arrow"
                    >
                        {
                            schedule.map((day) => (
                                <option
                                    value={`#${day.id}`}
                                    selected={day.id === activeDay}
                                >
                                    {day.name}
                                </option>
                            ))
                        }
                    </select>
                </div>
            </div>

            <div class="overflow-x-auto md:block hidden">
                <div
                    class="inline-flex min-w-full overflow-hidden 1xl:gap-5 lg:gap-4 lt:gap-3 gap-2"
                >
                    {
                        schedule.map((day) => (
                            <button
                                class:list={[
                                    "schedule-tab text-primary w-full",
                                    {
                                        "is-active":
                                            day.id === activeDay,
                                    },
                                ]}
                                data-target={`#${day.id}`}
                                type="button"
                            >
                                {day.name}
                            </button>
                        ))
                    }
                </div>
            </div>

            <!-- Tables by Day -->
            <div class="2xl:mt-8 1xl:mt-7 xl:mt-6 lt:mt-5 mt-4">
                {
                    schedule.map((day) => (
                        <div
                            id={day.id}
                            class:list={[
                                "schedule-panel",
                                {
                                    hidden: day.id !== activeDay,
                                },
                            ]}
                        >
                            <div class="transition-all duration-300">
                                <table class={day.tableClass}>
                                    <thead class={day.theadClass}>
                                        <tr>
                                            <th class="w-1/5">Time</th>
                                            <th class="w-1/5">Class</th>
                                            <th class="w-1/5">Level</th>
                                            <th class="w-1/5">Trainer</th>
                                            <th class="w-1/5">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody class="block md:table-row-group space-y-5">
                                        {
                                            day.items.map((item) => (
                                                <tr class="lt:group lt:hover:bg-whitesmoke-100">
                                                    <!-- TIME -->
                                                    <td class="group-hover:text-primary">
                                                        <h5 class="w-1/3 md:hidden text-start font-medium font-primary text-sm">
                                                            Time
                                                        </h5>
                                                        <p>{item.time}</p>
                                                    </td>

                                                    <!-- CLASS -->
                                                    <td class="group-hover:text-primary">
                                                        <h5 class="w-1/3 md:hidden text-start font-medium font-primary text-sm">
                                                            Class
                                                        </h5>
                                                        <p>{item.className}</p>
                                                    </td>

                                                    <!-- LEVEL -->
                                                    <td class="group-hover:text-primary">
                                                        <h5 class="w-1/3 md:hidden text-start font-medium font-primary text-sm">
                                                            Level
                                                        </h5>
                                                        <p>{item.level}</p>
                                                    </td>

                                                    <!-- TRAINER -->
                                                    <td class="group-hover:text-primary">
                                                        <h5 class="w-1/3 md:hidden text-start font-medium font-primary text-sm">
                                                            Trainer
                                                        </h5>
                                                        <p>{item.trainer}</p>
                                                    </td>

                                                    <!-- ACTION -->
                                                    <td class="group-hover:text-primary">
                                                        <h5 class="w-1/3 md:hidden text-start font-medium font-primary text-sm">
                                                            Action
                                                        </h5>

                                                        <a
                                                            href={bookClassHref}
                                                            class="p text-thunder-100 hover:text-primary underline decoration-1 underline-offset-2 flex items-center flex-wrap sm:gap-1 gap-0.5 w-full md:justify-center justify-end"
                                                        >
                                                            Book Now

                                                            <svg
                                                                xmlns="http://www.w3.org/2000/svg"
                                                                width="27"
                                                                height="27"
                                                                viewBox="0 0 27 27"
                                                                fill="none"
                                                                class="2xl:w-[27px] 2xl:h-[27px] sm:w-[25px] sm:h-[25px] w-5 h-5"
                                                            >
                                                                <g clip-path="url(#clip0_3130_6678)">
                                                                    <path
                                                                        d="M8.37896 18.7836L19.207 7.95556M19.207 7.95556C19.4636 8.21217 19.62 8.56903 19.616 8.96328L19.5384 16.6458M19.207 7.95556C18.9504 7.69895 18.5935 7.54257 18.1993 7.54655L10.5168 7.62418"
                                                                        stroke="currentColor"
                                                                        stroke-width="1.5"
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                    ></path>
                                                                </g>
                                                            </svg>
                                                        </a>
                                                    </td>
                                                </tr>
                                            ))
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    const initSchedule = () => {
        const schedule = document.querySelector("#schedule");

        if (!schedule) return;

        const tabs = schedule.querySelectorAll(".schedule-tab");
        const panels = schedule.querySelectorAll(".schedule-panel");
        const select = schedule.querySelector("#scheduleSelect");

        const activateSchedule = (target: string) => {
            tabs.forEach((tab) => {
                const tabTarget = tab.getAttribute("data-target");

                if (tabTarget === target) {
                    tab.classList.add("is-active");
                } else {
                    tab.classList.remove("is-active");
                }
            });

            panels.forEach((panel) => {
                if (`#${panel.id}` === target) {
                    panel.classList.remove("hidden");
                } else {
                    panel.classList.add("hidden");
                }
            });

            if (select instanceof HTMLSelectElement) {
                select.value = target;
            }
        };

        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const target = tab.getAttribute("data-target");

                if (target) {
                    activateSchedule(target);
                }
            });
        });

        if (select instanceof HTMLSelectElement) {
            select.addEventListener("change", () => {
                activateSchedule(select.value);
            });
        }
    };

    initSchedule();

    document.addEventListener("astro:page-load", initSchedule);
</script>