---
import { defaultFooterData, type FooterLink, type SocialLink } from '../../data/footer';
import FooterBottom from './FooterBottom.astro';

interface Props {
  logo?: string;
  logoAlt?: string;
  description?: string;
  quickLinks?: FooterLink[];
  serviceLinks?: FooterLink[];
  studioHours?: {
    weekday?: string;
    weekend?: string;
  };
  address?: string;
  addressHref?: string;
  phone?: string;
  phoneHref?: string;
  email?: string;
  emailHref?: string;
  socials?: SocialLink[];
  copyright?: string;
  privacyHref?: string;
  termsHref?: string;
  helpHref?: string;
}

const {
  logo = defaultFooterData.logo,
  logoAlt = defaultFooterData.logoAlt,
  description = defaultFooterData.description,
  quickLinks = defaultFooterData.quickLinks,
  serviceLinks = defaultFooterData.serviceLinks,
  studioHours = defaultFooterData.studioHours,
  address = defaultFooterData.address,
  addressHref = defaultFooterData.addressHref,
  phone = defaultFooterData.phone,
  phoneHref = defaultFooterData.phoneHref,
  email = defaultFooterData.email,
  emailHref = defaultFooterData.emailHref,
  socials = defaultFooterData.socials,
  copyright = defaultFooterData.copyright,
  privacyHref = defaultFooterData.privacyHref,
  termsHref = defaultFooterData.termsHref,
  helpHref = defaultFooterData.helpHref,
} = Astro.props;
---
<footer class="bg-grey-goose-100/20">
  <!-- Main Footer Content -->
  <div class="container">
    <div class="2xl:py-[100px] 1xl:py-20 xl:py-17 lg:py-14 md:py-12 sm:py-11 py-10">
      <div class="flex xl:flex-nowrap flex-wrap justify-between 1xl:gap-10 sm:gap-7 gap-5">

        <!-- Column 1: Pranavya Yoga Logo & Description -->
        <div class="2xl:max-w-[361px] 1xl:max-w-[305px] xl:max-w-[270px] lt:max-w-full sm:max-w-[40%] max-w-full xl:w-auto w-full 2xl:space-y-8 1xl:space-y-7 xl:space-y-6 lg:space-y-5.5 md:space-y-5 sm:space-y-4.5 space-y-4">
          <div class="xl:w-auto lt:w-[60%] w-full xl:m-0 mx-auto flex flex-col xl:items-start lt:items-center items-start 2xl:gap-8 1xl:gap-7 xl:gap-6 lg:gap-5.5 md:gap-5 sm:gap-4.5 gap-4">

            <div class="w-full 2xl:max-w-[332px] 1xl:max-w-[300px] lg:max-w-[230px] md:max-w-[200px] sm:max-w-[180px] max-w-[150px]">
              <a href="/" class="block w-full">
                <img
                  loading="lazy"
                  src={logo}
                  alt={logoAlt}
                  class="w-full h-auto"
                  decoding="async"
                />
              </a>
            </div>

            <p class="xl:text-start lt:text-center text-start">
              {description}
            </p>

            <!-- Social Media Icons -->
            <div class="flex items-center flex-wrap md:gap-5 gap-3">
              {socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.name}
                  class="1xl:size-12 md:size-11 sm:size-10 size-[38px] sm:p-[10px] p-2 btn border border-primary bg-primary text-white hover:bg-white hover:text-primary rounded-full flex items-center justify-center transition-all decoration-1000"
                >
                  {social.icon === "instagram" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="30px"
                      height="30px"
                      viewBox="0 0 24 24"
                      class="1xl:w-[26px] 1xl:h-[26px] w-5 h-5"
                    >
                      <path
                        fill="currentColor"
                        d="M13.028 2c1.125.003 1.696.009 2.189.023l.194.007c.224.008.445.018.712.03c1.064.05 1.79.218 2.427.465c.66.254 1.216.598 1.772 1.153a4.9 4.9 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428c.012.266.022.487.03.712l.006.194c.015.492.021 1.063.023 2.188l.001.746v1.31a79 79 0 0 1-.023 2.188l-.006.194c-.008.225-.018.446-.03.712c-.05 1.065-.22 1.79-.466 2.428a4.9 4.9 0 0 1-1.153 1.772a4.9 4.9 0 0 1-1.772 1.153c-.637.247-1.363.415-2.427.465l-.712.03l-.194.006c-.493.014-1.064.021-2.189.023l-.746.001h-1.309a78 78 0 0 1-2.189-.023l-.194-.006a63 63 0 0 1-.712-.031c-1.064-.05-1.79-.218-2.428-.465a4.9 4.9 0 0 1-1.771-1.153a4.9 4.9 0 0 1-1.154-1.772c-.247-.637-.415-1.363-.465-2.428l-.03-.712l-.005-.194A79 79 0 0 1 2 13.028v-2.056a79 79 0 0 1 .022-2.188l.007-.194c.008-.225.018-.446.03-.712c.05-1.065.218-1.79.465-2.428A4.9 4.9 0 0 1 3.68 3.678a4.9 4.9 0 0 1 1.77-1.153c.638-.247 1.363-.415 2.428-.465c.266-.012.488-.022.712-.03l.194-.006a79 79 0 0 1 2.188-.023zM12 7a5 5 0 1 0 0 10a5 5 0 0 0 0-10m0 2a3 3 0 1 1 .001 6a3 3 0 0 1 0-6m5.25-3.5a1.25 1.25 0 0 0 0 2.5a1.25 1.25 0 0 0 0-2.5"
                      />
                    </svg>
                  )}

                  {social.icon === "x" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      viewBox="0 0 22 22"
                      fill="none"
                      class="1xl:w-[22px] 1xl:h-[22px] w-5 h-5"
                    >
                      <path
                        d="M16.8407 1.65039L11.6141 7.62498L7.09475 1.65039H0.546875L8.36897 11.8776L0.955921 20.3504H4.12995L9.85137 13.8119L14.852 20.3504H21.2356L13.0819 9.57082L20.0127 1.65039H16.8407ZM15.7276 18.4516L4.25235 3.44873H6.13857L17.4852 18.4506L15.7276 18.4516Z"
                        fill="currentColor"
                      />
                    </svg>
                  )}

                  {social.icon === "facebook" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="30px"
                      height="30px"
                      viewBox="0 0 24 24"
                      class="xl:w-[26px] xl:h-[26px] w-6 h-6"
                    >
                      <path
                        fill="currentColor"
                        d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4z"
                      />
                    </svg>
                  )}

                  {social.icon === "youtube" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="30px"
                      height="30px"
                      viewBox="0 0 24 24"
                      class="xl:w-[26px] xl:h-[26px] w-6 h-6"
                    >
                      <path
                        fill="currentColor"
                        d="m10 15l5.19-3L10 9zm11.56-7.83c.13.47.22 1.1.28 1.9c.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83c-.25.9-.83 1.48-1.73 1.73c-.47.13-1.33.22-2.65.28c-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44c-.9-.25-1.48-.83-1.73-1.73c-.13-.47-.22-1.1-.28-1.9c-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83c.25-.9.83-1.48 1.73-1.73c.47-.13 1.33-.22 2.65-.28c1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44c.9.25 1.48.83 1.73 1.73"
                      />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Column 2: Quick Links -->
        <div>
          <h5 class="text-primary uppercase 2xl:mb-5.5 1xl:mb-5 xl:mb-4.5 md:mb-3.5 sm:mb-3 mb-2.5">
            Quick Links
          </h5>

          <ul class="1xl:space-y-4 xl:space-y-2.5 space-y-2">
            {quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-thunder-100 hover:text-primary transition-all 2xl:text-20 1xl:text-19 xl:text-18 lg:text-17 md:text-16 sm:text-15 text-14 lt:leading-[30px] sm:leading-[26px] leading-[22px]"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 3: Service -->
        <div>
          <h5 class="text-primary uppercase 2xl:mb-5.5 1xl:mb-5 xl:mb-4.5 lg:mb-4 md:mb-3.5 mb-2.5">
            Service
          </h5>

          <ul class="1xl:space-y-4 xl:space-y-2.5 space-y-2">
            {serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-thunder-100 hover:text-primary transition-all 2xl:text-20 1xl:text-19 xl:text-18 lg:text-17 md:text-16 sm:text-15 text-14 lt:leading-[30px] sm:leading-[26px] leading-[22px]"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 4: Schedule -->
        <div>
          <h5 class="text-primary uppercase 2xl:mb-5.5 1xl:mb-5 xl:mb-4.5 lg:mb-4 md:mb-3.5 mb-2.5">
            Schedule
          </h5>

          <div class="1xl:space-y-4 xl:space-y-2.5 space-y-2">
            <p class="2xl:text-20 1xl:text-19 xl:text-18 lg:text-17 md:text-16 sm:text-15 text-14 lt:leading-[30px] sm:leading-[26px] leading-[22px] font-semibold">
              Studio Hours
            </p>

            <p class="2xl:text-20 1xl:text-19 xl:text-18 lg:text-17 md:text-16 sm:text-15 text-14 lt:leading-[30px] sm:leading-[26px] leading-[22px]">
              {studioHours.weekday}
            </p>

            <p class="2xl:text-20 1xl:text-19 xl:text-18 lg:text-17 md:text-16 sm:text-15 text-14 lt:leading-[30px] leading-[22px]">
              {studioHours.weekend}
            </p>
          </div>
        </div>

        <!-- Column 5: Contact Us -->
        <div class="2xl:max-w-fit 1xl:max-w-[290px] xl:max-w-[255px] max-w-[315px]">
          <h5 class="text-primary uppercase 2xl:mb-5.5 1xl:mb-5 xl:mb-4.5 lg:mb-4 md:mb-3.5 mb-2.5">
            Contact Us
          </h5>

          <ul class="1xl:space-y-4 xl:space-y-2.5 space-y-2">

            <li>
              <a
                href={addressHref}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center xl:gap-3 gap-2.5 text-thunder-100 hover:text-primary transition-all 2xl:text-20 1xl:text-19 xl:text-18 lg:text-17 md:text-16 sm:text-15 text-14 lt:leading-[30px] sm:leading-[26px] leading-[22px]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 22 22"
                  fill="none"
                  class="shrink-0 lt:w-[22px] lt:h-[22px] w-[18px] h-[18px]"
                >
                  <path
                    d="M9.27208 19.9937C9.82758 20.4521 10.4069 20.871 11 21.2798C11.5944 20.8764 12.1709 20.4473 12.7279 19.9937C13.6565 19.2313 14.5304 18.4045 15.3432 17.5197C17.2168 15.4709 19.25 12.5009 19.25 9.16699C19.25 8.08359 19.0366 7.01079 18.622 6.00985C18.2074 5.00892 17.5997 4.09944 16.8336 3.33336C16.0675 2.56728 15.1581 1.95959 14.1571 1.54499C13.1562 1.13038 12.0834 0.916992 11 0.916992C9.91659 0.916992 8.8438 1.13038 7.84286 1.54499C6.84193 1.95959 5.93245 2.56728 5.16637 3.33336C4.40029 4.09944 3.7926 5.00892 3.37799 6.00985C2.96339 7.01079 2.75 8.08359 2.75 9.16699C2.75 12.5009 4.78317 15.47 6.65683 17.5197C7.46957 18.4049 8.34347 19.231 9.27208 19.9937ZM11 12.1462C10.2099 12.1462 9.45211 11.8323 8.89341 11.2736C8.33471 10.7149 8.02083 9.95712 8.02083 9.16699C8.02083 8.37687 8.33471 7.61911 8.89341 7.0604C9.45211 6.5017 10.2099 6.18783 11 6.18783C11.7901 6.18783 12.5479 6.5017 13.1066 7.0604C13.6653 7.61911 13.9792 8.37687 13.9792 9.16699C13.9792 9.95712 13.6653 10.7149 13.1066 11.2736C12.5479 11.8323 11.7901 12.1462 11 12.1462Z"
                    fill="#673E2C"
                  />
                </svg>

                {address}
              </a>
            </li>

            <li>
              <a
                href={phoneHref}
                class="flex items-center xl:gap-3 gap-2.5 text-thunder-100 hover:text-primary transition-all 2xl:text-20 1xl:text-19 xl:text-18 lg:text-17 md:text-16 sm:text-15 text-14 lt:leading-[30px] sm:leading-[26px] leading-[22px]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 19 22"
                  fill="none"
                  class="shrink-0 lt:w-[22px] lt:h-[22px] w-[18px] h-[18px]"
                >
                  <path
                    d="M18.048 16.0613L13.984 14.3196C13.8104 14.2456 13.6175 14.23 13.4342 14.2752C13.251 14.3203 13.0874 14.4238 12.968 14.57L11.1683 16.7689C8.34372 15.4371 6.07061 13.164 4.73887 10.3395L6.93776 8.53971C7.08424 8.42058 7.18791 8.25697 7.23308 8.07365C7.27826 7.89032 7.26248 7.69728 7.18813 7.52372L5.44643 3.45977C5.36483 3.27268 5.22051 3.11993 5.03835 3.02786C4.85619 2.93579 4.64761 2.91016 4.44858 2.9554L0.674908 3.82625C0.483019 3.87056 0.311816 3.9786 0.189241 4.13274C0.0666653 4.28689 -4.42032e-05 4.47802 2.19752e-08 4.67496C2.19752e-08 13.9822 7.54372 21.5114 16.8364 21.5114C17.0334 21.5115 17.2246 21.4448 17.3788 21.3222C17.5331 21.1997 17.6412 21.0284 17.6855 20.8365L18.5563 17.0628C18.6013 16.8628 18.5751 16.6534 18.4823 16.4706C18.3895 16.2878 18.2359 16.1431 18.048 16.0613Z"
                    fill="#673E2C"
                  />
                </svg>

                {phone}
              </a>
            </li>

            <li>
              <a
                href={emailHref}
                class="flex items-center xl:gap-3 gap-2.5 text-thunder-100 hover:text-primary transition-all 2xl:text-20 1xl:text-19 xl:text-18 lg:text-17 md:text-16 sm:text-15 text-14 lt:leading-[30px] sm:leading-[26px] leading-[22px]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 22 22"
                  fill="none"
                  class="shrink-0 lt:w-[22px] lt:h-[22px] w-[18px] h-[18px]"
                >
                  <path
                    d="M18.2598 7.1862L10.9264 11.7695L3.5931 7.1862V5.35286L10.9264 9.9362L18.2598 5.35286M18.2598 3.51953H3.5931C2.5756 3.51953 1.75977 4.33536 1.75977 5.35286V16.3529C1.75977 16.8391 1.95292 17.3054 2.29674 17.6492C2.64055 17.993 3.10687 18.1862 3.5931 18.1862H18.2598C18.746 18.1862 19.2123 17.993 19.5561 17.6492C19.8999 17.3054 20.0931 16.8391 20.0931 16.3529V5.35286C20.0931 4.86663 19.8999 4.40032 19.5561 4.0565C19.2123 3.71269 18.746 3.51953 18.2598 3.51953Z"
                    fill="#673E2C"
                  />
                </svg>

                {email}
              </a>
            </li>

          </ul>
        </div>

      </div>
    </div>

    <!-- Footer Bottom -->

    <!-- Footer Bottom -->
    <FooterBottom
      copyright={copyright}
      privacyHref={privacyHref}
      termsHref={termsHref}
      helpHref={helpHref}
    />
  </div>
</footer>
