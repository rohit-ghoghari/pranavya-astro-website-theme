---
const {
    shopHref = "/shop",
} = Astro.props;
---

<!-- ====== Start empty cart ====== -->
<section class="relative 2xl:mb-[100px] 1xl:mb-20 xl:mb-17 lg:mb-14 md:mb-12 sm:mb-11 mb-10 w-full">
    <div class="container">
        <div
            class="relative 2xl:my-[100px] 1xl:my-20 xl:my-17 lg:my-14 md:my-12 sm:my-11 my-10 w-full flex items-center justify-center flex-col">

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-0 left-0 right-auto w-[22%] opacity-30 hidden md:block">
                <img
                    loading="lazy"
                    decoding="async"
                    src="/flower-shape.svg"
                    alt="decor"
                    class="w-full h-full object-contain"
                />
            </div>

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-0 left-auto right-0 lt:w-[10%] w-[17%] opacity-30 hidden md:block">
                <img
                    loading="lazy"
                    decoding="async"
                    src="/flower-shape.svg"
                    alt="decor"
                    class="w-full h-full object-contain"
                />
            </div>

            <!-- Decorative Flower -->
            <div class="pointer-events-none absolute top-auto bottom-20 left-auto right-0 w-[17%] opacity-30 hidden md:block">
                <img
                    loading="lazy"
                    decoding="async"
                    src="/flower-shape.svg"
                    alt="decor"
                    class="w-full h-full object-contain"
                />
            </div>

            <img
                loading="lazy"
                decoding="async"
                src="/empty-cart.webp"
                alt="empty-cart"
                class="lt:w-[28%] sm:w-[34%] w-[78%] h-auto mx-auto 2xl:mb-12.5 1xl:mb-10 xl:mb-8 lg:mb-6 md:mb-5 sm:mb-4 mb-3.5"
            />

            <h3 class="font-medium italic font-primary 2xl:mb-6 1xl:mb-5 mb-4 text-center">
                Your Cart is Empty
            </h3>

            <p class="1xl:mb-10 sm:mb-7 mb-6 text-center md:max-w-[66%] wfull">
                Looks like you haven’t added anything to your practice yet. Explore our yoga mats, props,
                clothing, and mindful essentials — and bring home what supports your journey on and off the mat.
            </p>

            <a href={shopHref} class="btn btn-secondary">retune to shop</a>
        </div>
    </div>
</section>
<!-- ====== End empty cart ====== -->
