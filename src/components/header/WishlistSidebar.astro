<div id="wishlistSidebar"
    class="fixed top-0 right-0 h-screen w-auto translate-x-full transition-transform duration-300 z-999999 flex flex-col items-end">
    <div class="bg-white flex flex-col h-screen w-full 2xl:max-w-[440px] sm:max-w-[375px] max-w-[320px]">

        <!-- Header -->
