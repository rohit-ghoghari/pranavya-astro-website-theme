                            class="2xl:w-[30px] 2xl:h-[30px] w-[26px] h-[26px] rounded-full border-thunder-100 border flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 18" fill="none"
                                class="2xl:w-[18px] 2xl:h-[18px] w-[16px] h-[16px]">
