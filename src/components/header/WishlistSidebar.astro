                    <img loading="lazy" src="/nav-product-3.webp" alt="product-1" class="w-auto h-auto" />
                </div>
                <div class="flex-1 2xl:space-y-2 space-y-1">
                    <div class="flex items-start justify-between gap-2">
                        <p class="font-primary text-[#2D2D22]">Gaiam Yoga Starter Kit</p>
                        <button
                            aria-label="Remove item from wishlist"
                            class="2xl:w-[30px] 2xl:h-[30px] w-[26px] h-[26px] rounded-full border-thunder-100 border flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 18" fill="none"
