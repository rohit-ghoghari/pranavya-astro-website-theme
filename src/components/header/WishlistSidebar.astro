        </div>

        <!-- Sticky bottom buttons -->
        <div class="mt-auto pt-6 sticky bottom-5 bg-white 2xl:px-[22px] px-4">
            <div class="flex flex-col 2xl:gap-6 gap-4">
                <button class="btn btn-secondary w-full 2xl:text-18px text-15px font-normal">
