                    class="bg-[#E0E0E0] rounded-sm 2xl:p-[10px] p-2 border border-[#F4F1EF] relative 2xl:h-[150px] lt:h-[120px] sm:h-[132px] h-[110px] 2xl:w-[120px] w-[110px] flex items-center justify-center group/shop">
                    <img loading="lazy" src="/nav-product-2.webp" alt="product-1" class="w-auto h-auto" />
