---
const additionalClasses = [
    {
        title: "Hatha Yoga",
        description: "Balanced & Foundational",
        image: "/nav-class-1.webp",
        href: "/classes/hatha-yoga/",
    },
    {
        title: "Vinyasa Flow",
        description: "Dynamic & Energizing",
        image: "/nav-class-2.webp",
        href: "/classes/vinyasa-flow/",
    },
    {
        title: "Restorative Yoga",
        description: "Slow, Soothing, Centered",
        image: "/nav-class-3.webp",
        href: "/classes/restorative-yoga/",
    },
    {
        title: "Yin & Restore",
        description: "Deep & Meditative",
        image: "/nav-class-4.webp",
        href: "/classes/yin-restore/",
    },
    {
        title: "Power Yoga",
        description: "Strength Flow Intensity",
        image: "/nav-class-5.webp",
        href: "/classes/power-yoga/",
    },
];
---
<li>
    <div class="has-mega 2xl:px-5 1xl:px-3 xl:px-[10px] px-[7px]">
        <a href="/classes/classOne/"
            class="menu_link_text inline-flex items-center min-[1221px]:justify-normal justify-between w-full gap-x-2.5 md:leading-9 2xl:text-18 md:text-15 text-14 font-normal uppercase group-hover:text-primary">
            <span class="xl:py-5 lg:py-4 sm:py-2.5 py-2">Classes</span>
            <svg width="11" height="7" viewBox="0 0 11 7" fill="none"
                class="group-hover:rotate-180 transition-transform duration-300 min-[1221px]:flex hidden">
                <path d="M1.49951 1.5L5.49991 5.5L9.49951 1.5" stroke="currentColor"
                    stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="6" height="10"
                viewBox="0 0 6 10" fill="none" class="min-[1221px]:hidden flex">
                <path d="M0.649901 8.65039L4.6499 4.64999L0.649902 0.65039"
                    stroke="#673E2C" stroke-width="1.3" stroke-linecap="round"
                    stroke-linejoin="round" />
            </svg>
        </a>
        <div
            class="w-full min-[1221px]:absolute min-[1221px]:left-0 min-[1221px]:top-full hidden z-60 mega-panel pt-px top-1">
            <div
                class="min-[1221px]:mt-0 sm:mt-6 mt-5 bg-white lg:rounded-b-[10px] 2xl:p-[30px] min-[1221px]:p-6 sm:p-0 px-4 mx-auto pointer-events-auto overflow-y-auto min-[1221px]:h-[calc(100vh-49vh)] h-[calc(100vh-21vh)] scrollbar-custom mega-menu">
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lt:grid-cols-4 1xl:grid-cols-5 xl:gap-[30px] gap-5">

                    <!-- 1 -->
                    <a href="/classes/hatha-yoga/"
                        class="block overflow-hidden relative shrink-0 before:content-[''] before:pt-[119%] before:block w-full h-full group">
                        <img loading="lazy" src="/nav-class-1.webp" alt="Hatha Yoga"
                            class="w-full h-full object-cover absolute top-0 left-0 bottom-0 right-0 group-hover:scale-105 scale-100 transition-all ease-in-out duration-350" />
                        <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent"></div>
                        <div class="absolute bottom-0 left-0 text-white backdrop-blur-xs w-full">
                            <div class="p-[15px]">
                                <div class="flex items-center justify-between w-full gap-3">
                                    <h5 class="font-normal font-secondary uppercase text-white!">Hatha Yoga</h5>
                                    <div class="rounded-full border border-white shrink-0 w-8 h-8 flex items-center justify-center group-hover:bg-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none" class="mt-px ml-px">
                                            <path d="M0.692504 9.68278C0.692504 9.68278 6.5362 3.54949 8.97019 0.994861M8.97019 0.994861L9.59281 7.58973M8.97019 0.994861L2.35248 0.69208"
                                                stroke="currentColor" stroke-width="1.38442" stroke-linecap="round" stroke-linejoin="round"
                                                class="stroke-white! group-hover:stroke-primary!" />
                                        </svg>
                                    </div>
                                </div>
                                <p class="text-white!">Balanced & Foundational</p>
                            </div>
                        </div>
                    </a>

                    <!-- 2 -->
                    <a href="/classes/vinyasa-flow/"
                        class="block overflow-hidden relative shrink-0 before:content-[''] before:pt-[119%] before:block w-full h-full group">
                        <img loading="lazy" src="/nav-class-2.webp" alt="Vinyasa Flow"
                            class="w-full h-full object-cover absolute top-0 left-0 bottom-0 right-0 group-hover:scale-105 scale-100 transition-all ease-in-out duration-350" />
                        <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent"></div>
                        <div class="absolute bottom-0 left-0 backdrop-blur-xs w-full">
                            <div class="p-[15px] text-white">
                                <div class="flex items-center justify-between w-full gap-3">
                                    <h5 class="font-normal font-secondary uppercase text-white!">Vinyasa Flow</h5>
                                    <div class="rounded-full border border-white shrink-0 w-8 h-8 flex items-center justify-center group-hover:bg-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none" class="mt-px ml-px">
                                            <path d="M0.692504 9.68278C0.692504 9.68278 6.5362 3.54949 8.97019 0.994861M8.97019 0.994861L9.59281 7.58973M8.97019 0.994861L2.35248 0.69208"
                                                stroke="currentColor" stroke-width="1.38442" stroke-linecap="round" stroke-linejoin="round"
                                                class="stroke-white! group-hover:stroke-primary!" />
                                        </svg>
                                    </div>
                                </div>
                                <p class="text-white!">Dynamic & Energizing</p>
                            </div>
                        </div>
                    </a>

                    <!-- 3 -->
                    <a href="/classes/restorative-yoga/"
                        class="block overflow-hidden relative shrink-0 before:content-[''] before:pt-[119%] before:block w-full h-full group">
                        <img loading="lazy" src="/nav-class-3.webp" alt="Restorative Yoga"
                            class="w-full h-full object-cover absolute top-0 left-0 bottom-0 right-0 group-hover:scale-105 scale-100 transition-all ease-in-out duration-350" />
                        <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent"></div>
                        <div class="absolute bottom-0 left-0 text-white backdrop-blur-xs w-full">
                            <div class="p-[15px]">
                                <div class="flex items-center justify-between w-full gap-3">
                                    <h5 class="font-normal font-secondary uppercase text-white!">Restorative Yoga</h5>
                                    <div class="rounded-full border border-white shrink-0 w-8 h-8 flex items-center justify-center group-hover:bg-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none" class="mt-px ml-px">
                                            <path d="M0.692504 9.68278C0.692504 9.68278 6.5362 3.54949 8.97019 0.994861M8.97019 0.994861L9.59281 7.58973M8.97019 0.994861L2.35248 0.69208"
                                                stroke="currentColor" stroke-width="1.38442" stroke-linecap="round" stroke-linejoin="round"
                                                class="stroke-white! group-hover:stroke-primary!" />
                                        </svg>
                                    </div>
                                </div>
                                <p class="text-white!">Slow, Soothing, Centered</p>
                            </div>
                        </div>
                    </a>

                    <!-- 4 -->
                    <a href="/classes/yin-restore/"
                        class="block overflow-hidden relative shrink-0 before:content-[''] before:pt-[119%] before:block w-full h-full group">
                        <img loading="lazy" src="/nav-class-4.webp" alt="Yin & Restore"
                            class="w-full h-full object-cover absolute top-0 left-0 bottom-0 right-0 group-hover:scale-105 scale-100 transition-all ease-in-out duration-350" />
                        <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent"></div>
                        <div class="absolute bottom-0 left-0 text-white backdrop-blur-xs w-full">
                            <div class="p-[15px]">
                                <div class="flex items-center justify-between w-full gap-3">
                                    <h5 class="font-normal font-secondary uppercase text-white!">Yin & Restore</h5>
                                    <div class="rounded-full border border-white shrink-0 w-8 h-8 flex items-center justify-center group-hover:bg-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none" class="mt-px ml-px">
                                            <path d="M0.692504 9.68278C0.692504 9.68278 6.5362 3.54949 8.97019 0.994861M8.97019 0.994861L9.59281 7.58973M8.97019 0.994861L2.35248 0.69208"
                                                stroke="currentColor" stroke-width="1.38442" stroke-linecap="round" stroke-linejoin="round"
                                                class="stroke-white! group-hover:stroke-primary!" />
                                        </svg>
                                    </div>
                                </div>
                                <p class="text-white!">Deep & Meditative</p>
                            </div>
                        </div>
                    </a>

                    <!-- 5 -->
                    <a href="/classes/power-yoga/"
                        class="block overflow-hidden relative shrink-0 before:content-[''] before:pt-[119%] before:block w-full h-full group">
                        <img loading="lazy" src="/nav-class-5.webp" alt="Power Yoga"
                            class="w-full h-full object-cover absolute top-0 left-0 bottom-0 right-0 group-hover:scale-105 scale-100 transition-all ease-in-out duration-350" />
                        <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent"></div>
                        <div class="absolute bottom-0 left-0 text-white backdrop-blur-xs w-full">
                            <div class="p-[15px]">
                                <div class="flex items-center justify-between w-full gap-3">
                                    <h5 class="font-normal font-secondary uppercase text-white!">Power Yoga</h5>
                                    <div class="rounded-full border border-white shrink-0 w-8 h-8 flex items-center justify-center group-hover:bg-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none" class="mt-px ml-px">
                                            <path d="M0.692504 9.68278C0.692504 9.68278 6.5362 3.54949 8.97019 0.994861M8.97019 0.994861L9.59281 7.58973M8.97019 0.994861L2.35248 0.69208"
                                                stroke="currentColor" stroke-width="1.38442" stroke-linecap="round" stroke-linejoin="round"
                                                class="stroke-white! group-hover:stroke-primary!" />
                                        </svg>
                                    </div>
                                </div>
                                <p class="text-white!">Strength Flow Intensity</p>
                            </div>
                        </div>
                    </a>

                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lt:grid-cols-4 1xl:grid-cols-5 xl:gap-[30px] gap-5 mt-5">
                    {additionalClasses.map((item) => (
                        <a href={item.href}
                            class="block overflow-hidden relative shrink-0 before:content-[''] before:pt-[119%] before:block w-full h-full group">
                            <img loading="lazy" src={item.image} alt={item.title}
                                class="w-full h-full object-cover absolute top-0 left-0 bottom-0 right-0 group-hover:scale-105 scale-100 transition-all ease-in-out duration-350" />
                            <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent"></div>
                            <div class="absolute bottom-0 left-0 text-white backdrop-blur-xs w-full">
                                <div class="p-[15px]">
                                    <div class="flex items-center justify-between w-full gap-3">
                                        <h5 class="font-normal font-secondary uppercase text-white!">{item.title}</h5>
                                        <div class="rounded-full border border-white shrink-0 w-8 h-8 flex items-center justify-center group-hover:bg-white">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none" class="mt-px ml-px">
                                                <path d="M0.692504 9.68278C0.692504 9.68278 6.5362 3.54949 8.97019 0.994861M8.97019 0.994861L9.59281 7.58973M8.97019 0.994861L2.35248 0.69208"
                                                    stroke="currentColor" stroke-width="1.38442" stroke-linecap="round" stroke-linejoin="round"
                                                    class="stroke-white! group-hover:stroke-primary!" />
                                            </svg>
                                        </div>
                                    </div>
                                    <p class="text-white!">{item.description}</p>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </div>
</li>
