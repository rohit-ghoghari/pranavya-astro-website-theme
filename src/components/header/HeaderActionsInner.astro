---
interface Props {
    /** Render the "My Account" profile dropdown (account page) instead of the login button. */
    accountMenu?: boolean;
}

const { accountMenu = false } = Astro.props;
---

<!-- Right icons — inner/about page variant -->
<!-- Differences from HeaderActions.astro:
     1. Login href → /login
     2. Hamburger → no text-white (header is always light bg) -->
<div class="flex items-center 2xl:gap-[35px] 1xl:gap-7 sm:gap-3 gap-[6px]">

    <!-- Search -->
    <div id="nav-site-search" class="site-search">
        <button class="site-search__open cursor-pointer border-0 bg-transparent block" aria-label="Open search">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 28 28" fill="none"
                class="nav-icon 2xl:w-6 2xl:h-6 xl:w-5.5 xl:h-5.5 sm:w-6 sm:h-6 w-5 h-5">
                <path
                    d="M17.473 18.888C15.7839 20.2576 13.6746 21.0034 11.5 21C9.62108 21 7.78435 20.4428 6.22209 19.399C4.65982 18.3551 3.44218 16.8714 2.72315 15.1355C2.00412 13.3996 1.81598 11.4895 2.18254 9.64665C2.5491 7.80383 3.45389 6.11109 4.78249 4.78249C6.11109 3.45389 7.80383 2.5491 9.64665 2.18254C11.4895 1.81598 13.3996 2.00412 15.1355 2.72315C16.8714 3.44218 18.3551 4.65982 19.399 6.22209C20.4428 7.78435 21 9.62108 21 11.5C21.0032 13.6747 20.2569 15.7841 18.887 17.473L24.707 23.293C24.8892 23.4816 24.99 23.7342 24.9877 23.9964C24.9854 24.2586 24.8802 24.5094 24.6948 24.6948C24.5094 24.8802 24.2586 24.9854 23.9964 24.9877C23.7342 24.99 23.4816 24.8892 23.293 24.707L17.473 18.888ZM19 11.5C19 9.51088 18.2098 7.60323 16.8033 6.1967C15.3968 4.79018 13.4891 4 11.5 4C9.51088 4 7.60323 4.79018 6.1967 6.1967C4.79018 7.60323 4 9.51088 4 11.5C4 13.4891 4.79018 15.3968 6.1967 16.8033C7.60323 18.2098 9.51088 19 11.5 19C13.4891 19 15.3968 18.2098 16.8033 16.8033C18.2098 15.3968 19 13.4891 19 11.5Z"
                    fill="currentColor" />
            </svg>
        </button>

        <!-- Search form -->
        <div class="site-search__form-wrap rounded-full">
            <form class="site-search__search-form flex grow flex-nowrap">

                <!-- Search submit -->
                <button class="site-search__search-submit" title="search" aria-label="Submit search">
                    <span class="icon-search">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28" fill="none"
                            class="2xl:w-6 2xl:h-6 xl:w-5.5 xl:h-5.5 sm:w-6 sm:h-6 w-5 h-5">
                            <path
                                d="M17.473 18.888C15.7839 20.2576 13.6746 21.0034 11.5 21C9.62108 21 7.78435 20.4428 6.22209 19.399C4.65982 18.3551 3.44218 16.8714 2.72315 15.1355C2.00412 13.3996 1.81598 11.4895 2.18254 9.64665C2.5491 7.80383 3.45389 6.11109 4.78249 4.78249C6.11109 3.45389 7.80383 2.5491 9.64665 2.18254C11.4895 1.81598 13.3996 2.00412 15.1355 2.72315C16.8714 3.44218 18.3551 4.65982 19.399 6.22209C20.4428 7.78435 21 9.62108 21 11.5C21.0032 13.6747 20.2569 15.7841 18.887 17.473L24.707 23.293C24.8892 23.4816 24.99 23.7342 24.9877 23.9964C24.9854 24.2586 24.8802 24.5094 24.6948 24.6948C24.5094 24.8802 24.2586 24.9854 23.9964 24.9877C23.7342 24.99 23.4816 24.8892 23.293 24.707L17.473 18.888ZM19 11.5C19 9.51088 18.2098 7.60323 16.8033 6.1967C15.3968 4.79018 13.4891 4 11.5 4C9.51088 4 7.60323 4.79018 6.1967 6.1967C4.79018 7.60323 4 9.51088 4 11.5C4 13.4891 4.79018 15.3968 6.1967 16.8033C7.60323 18.2098 9.51088 19 11.5 19C13.4891 19 15.3968 18.2098 16.8033 16.8033C18.2098 15.3968 19 13.4891 19 11.5Z"
                                fill="#2D2D2D" />
                        </svg>
                    </span>
                </button>

                <!-- Search input -->
                <input class="site-search__search-input" name="searchValue" placeholder="Search here.." />

                <!-- Suggestions block -->
                <div
                    class="site-search__suggestions-block 2xl:p-[50px]! sm:p-10! p-4! border-t border-bronco-100 1xl:space-y-14 space-y-12">

                    <!-- Blog suggestions -->
                    <section class="site-search__suggestions-section lg:w-[80%] w-full z-9999 relative">
                        <p class="text-thunder-100 font-primary 2xl:mb-5 mb-4 uppercase">Blog</p>
                        <div class="w-full h-full">
                            <div
                                class="grid md:grid-cols-2 grid-cols-1 2xl:gap-10 lg:gap-8 gap-2 relative w-full h-full">

                                <!-- 1st Blog -->
                                <div
                                    class="flex sm:flex-row flex-col sm:items-center items-start 2xl:gap-7 1xl:gap-6 gap-4 w-full h-full">
                                    <div
                                        class="rounded-sm block overflow-hidden relative shrink-0 2xl:w-[150px] 1xl:w-[140px] lg:w-[130px] w-[120px] 2xl:h-[150px] lg:h-[140px] sm:h-[135px] h-[118px]">
                                        <img loading="lazy" src="/search-blog-1.webp" alt="blog"
                                            class="w-full h-full object-cover" />
                                    </div>
                                    <div>
                                        <a href="/blog/hip-opening-sequence-for-mobility" class="flex flex-col items-start gap-[6px]">
                                            <h5 class="text-primary uppercase group-hover:text-thunder-100">
                                                HIP-OPENING SEQUENCE FOR MOBILITY
                                            </h5>
                                            <p class="text-thunder-100 line-clamp-2 sm:w-[70%] w-full">
                                                Free up tight hips and enhance movement with this soothing stretch routine.
                                            </p>
                                        </a>
                                    </div>
                                </div>

                                <!-- 2nd Blog -->
                                <div
                                    class="flex sm:flex-row flex-col sm:items-center items-start 2xl:gap-7 1xl:gap-6 gap-4 w-full h-full">
                                    <div
                                        class="rounded-sm block overflow-hidden relative shrink-0 2xl:w-[150px] 1xl:w-[140px] lg:w-[130px] w-[120px] 2xl:h-[150px] lg:h-[140px] sm:h-[135px] h-[118px]">
                                        <img loading="lazy" src="/search-blog-2.webp" alt="blog"
                                            class="w-full h-full object-cover" />
                                    </div>
                                    <div>
                                        <a href="/blog/restorative-poses-for-stress-relief" class="flex flex-col items-start gap-[6px]">
                                            <h5 class="text-primary uppercase group-hover:text-thunder-100">
                                                RESTORATIVE POSES FOR STRESS RELIEF
                                            </h5>
                                            <p class="text-thunder-100 line-clamp-2 sm:w-[70%] w-full">
                                                Melt away anxiety with gentle, supported positions that calm the nervous system.
                                            </p>
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                    <!-- Class suggestions -->
                    <section class="site-search__suggestions-section lg:w-[80%] w-full z-9999 relative">
                        <p class="text-thunder-100 font-primary 2xl:mb-5 mb-4 uppercase">CLASS</p>
                        <div class="w-full h-full">
                            <div
                                class="w-full h-full grid 1xl:grid-cols-4 sm:grid-cols-3 grid-cols-1 lg:gap-[65px] lt:gap-9 sm:gap-5 gap-4">

                                <!-- 1st class -->
                                <div class="bg-whitesmoke-100 flex flex-col">
                                    <div class="xl:h-[155px] h-[135px] overflow-hidden">
                                        <img loading="lazy" src="/search-class-1.webp" alt="class"
                                            class="w-full h-full object-cover" />
                                    </div>
                                    <div class="2xl:p-4 p-[14px]">
                                        <h5 class="uppercase text-primary mb-[10px]">Core Flow Yoga</h5>
                                        <button
                                            class="btn-link uppercase 2xl:text-20 1xl:text-14 text-13 group decoration-1 text-primary font-medium hover:text-black">
                                            view now
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                                viewBox="0 0 13 13" fill="none"
                                                class="mt-1 2xl:w-[13px] 2xl:h-[13px] w-[11px] h-[11px]">
                                                <path
                                                    d="M0.71517 11.4403L11.0492 1.1062M11.0492 1.1062C11.2941 1.35111 11.4434 1.69168 11.4396 2.06795L11.3655 9.39997M11.0492 1.1062C10.8043 0.861295 10.4637 0.712054 10.0875 0.715856L2.75546 0.789943"
                                                    stroke="currentColor" stroke-width="1.43157" stroke-linecap="round"
                                                    stroke-linejoin="round" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- 2nd class -->
                                <div class="bg-whitesmoke-100 flex flex-col">
                                    <div class="xl:h-[155px] h-[135px] overflow-hidden">
                                        <img loading="lazy" src="/search-class-2.webp" alt="class"
                                            class="w-full h-full object-cover" />
                                    </div>
                                    <div class="2xl:p-4 p-[14px]">
                                        <h5 class="uppercase text-primary mb-[10px]">Yoga Sculpt</h5>
                                        <button
                                            class="btn-link uppercase 2xl:text-20 1xl:text-14 text-13 group decoration-1 text-primary font-medium hover:text-black">
                                            view now
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                                viewBox="0 0 13 13" fill="none"
                                                class="mt-1 2xl:w-[13px] 2xl:h-[13px] w-[11px] h-[11px]">
                                                <path
                                                    d="M0.71517 11.4403L11.0492 1.1062M11.0492 1.1062C11.2941 1.35111 11.4434 1.69168 11.4396 2.06795L11.3655 9.39997M11.0492 1.1062C10.8043 0.861295 10.4637 0.712054 10.0875 0.715856L2.75546 0.789943"
                                                    stroke="currentColor" stroke-width="1.43157" stroke-linecap="round"
                                                    stroke-linejoin="round" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- 3rd class -->
                                <div class="bg-whitesmoke-100 flex flex-col">
                                    <div class="xl:h-[155px] h-[135px] overflow-hidden">
                                        <img loading="lazy" src="/search-class-3.webp" alt="class"
                                            class="w-full h-full object-cover" />
                                    </div>
                                    <div class="2xl:p-4 p-[14px]">
                                        <h5 class="uppercase text-primary mb-[10px]">Family Yoga</h5>
                                        <button
                                            class="btn-link uppercase 2xl:text-20 1xl:text-14 text-13 group decoration-1 text-primary font-medium hover:text-black">
                                            view now
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                                viewBox="0 0 13 13" fill="none"
                                                class="mt-1 2xl:w-[13px] 2xl:h-[13px] w-[11px] h-[11px]">
                                                <path
                                                    d="M0.71517 11.4403L11.0492 1.1062M11.0492 1.1062C11.2941 1.35111 11.4434 1.69168 11.4396 2.06795L11.3655 9.39997M11.0492 1.1062C10.8043 0.861295 10.4637 0.712054 10.0875 0.715856L2.75546 0.789943"
                                                    stroke="currentColor" stroke-width="1.43157" stroke-linecap="round"
                                                    stroke-linejoin="round" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                </div>
            </form>

            <!-- Close search button -->
            <button role="button" class="site-search__close" aria-label="Close search">
                <span class="icon-close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M15 5L5 15" stroke="#000000" stroke-width="1.4" stroke-linecap="round"
                            stroke-linejoin="round" />
                        <path d="M5 5L15 15" stroke="#000000" stroke-width="1.4" stroke-linecap="round"
                            stroke-linejoin="round" />
                    </svg>
                </span>
            </button>
        </div>
    </div>

    <!-- Wishlist icon (desktop only) -->
    <button id="openWishlist" class="sm:flex hidden" aria-label="Open wishlist">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
            class="nav-icon 2xl:w-6 2xl:h-6 xl:w-5.5 xl:h-5.5 sm:w-6 sm:h-6 w-5 h-5" fill="none">
            <path
                d="M7.5 4C4.4625 4 2 6.4625 2 9.5C2 15 8.5 20 12 21.163C15.5 20 22 15 22 9.5C22 6.4625 19.5375 4 16.5 4C14.64 4 12.995 4.9235 12 6.337C11.4928 5.61469 10.819 5.0252 10.0357 4.61841C9.25238 4.21162 8.38263 3.9995 7.5 4Z"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>

    <!-- Cart icon -->
    <button id="openCart" aria-label="Open shopping cart">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
            class="nav-icon 2xl:w-6 2xl:h-6 xl:w-5.5 xl:h-5.5 sm:w-6 sm:h-6 w-5 h-5" fill="none">
            <path
                d="M8.75 13C8.75 12.8011 8.67098 12.6103 8.53033 12.4697C8.38968 12.329 8.19891 12.25 8 12.25C7.80109 12.25 7.61032 12.329 7.46967 12.4697C7.32902 12.6103 7.25 12.8011 7.25 13V17C7.25 17.1989 7.32902 17.3897 7.46967 17.5303C7.61032 17.671 7.80109 17.75 8 17.75C8.19891 17.75 8.38968 17.671 8.53033 17.5303C8.67098 17.3897 8.75 17.1989 8.75 17V13ZM16 12.25C16.1989 12.25 16.3897 12.329 16.5303 12.4697C16.671 12.6103 16.75 12.8011 16.75 13V17C16.75 17.1989 16.671 17.3897 16.5303 17.5303C16.3897 17.671 16.1989 17.75 16 17.75C15.8011 17.75 15.6103 17.671 15.4697 17.5303C15.329 17.3897 15.25 17.1989 15.25 17V13C15.25 12.8011 15.329 12.6103 15.4697 12.4697C15.6103 12.329 15.8011 12.25 16 12.25ZM12.75 13C12.75 12.8011 12.671 12.6103 12.5303 12.4697C12.3897 12.329 12.1989 12.25 12 12.25C11.8011 12.25 11.6103 12.329 11.4697 12.4697C11.329 12.6103 11.25 12.8011 11.25 13V17C11.25 17.1989 11.329 17.3897 11.4697 17.5303C11.6103 17.671 11.8011 17.75 12 17.75C12.1989 17.75 12.3897 17.671 12.5303 17.5303C12.671 17.3897 12.75 17.1989 12.75 17V13Z"
                fill="currentColor" />
            <path fill-rule="evenodd" clip-rule="evenodd"
                d="M17.2736 3.473C16.7976 3.287 16.2646 3.256 15.5816 3.251C15.4398 2.95147 15.2158 2.69838 14.9357 2.52117C14.6557 2.34396 14.3311 2.24993 13.9996 2.25H9.99963C9.66832 2.24984 9.34378 2.34373 9.06372 2.52075C8.78367 2.69777 8.55963 2.95066 8.41763 3.25C7.73363 3.256 7.20163 3.287 6.72563 3.473C6.15741 3.69527 5.66323 4.07301 5.29964 4.563C4.93264 5.056 4.75964 5.69 4.52364 6.561L3.89563 8.864C3.50225 9.06248 3.15741 9.34518 2.88563 9.692C2.26363 10.489 2.15364 11.438 2.26464 12.526C2.37164 13.582 2.70463 14.912 3.12063 16.576L3.14663 16.683C3.41063 17.735 3.62364 18.59 3.87764 19.257C4.14263 19.953 4.47963 20.523 5.03363 20.956C5.58863 21.389 6.22363 21.576 6.96263 21.666C7.67063 21.75 8.55263 21.75 9.63763 21.75H14.3616C15.4466 21.75 16.3276 21.75 17.0366 21.665C17.7766 21.577 18.4106 21.389 18.9646 20.955C19.5196 20.523 19.8556 19.953 20.1206 19.257C20.3756 18.59 20.5886 17.735 20.8516 16.682L20.8786 16.577C21.2946 14.912 21.6266 13.582 21.7346 12.527C21.8446 11.437 21.7346 10.489 21.1126 9.692C20.8411 9.34529 20.4967 9.0626 20.1036 8.864L19.4756 6.561C19.2386 5.69 19.0656 5.056 18.6996 4.562C18.3359 4.07238 17.8417 3.695 17.2736 3.473ZM9.99963 3.75C9.93333 3.75 9.86974 3.77634 9.82286 3.82322C9.77597 3.87011 9.74963 3.9337 9.74963 4C9.74963 4.0663 9.77597 4.12989 9.82286 4.17678C9.86974 4.22366 9.93333 4.25 9.99963 4.25H13.9996C14.0659 4.25 14.1295 4.22366 14.1764 4.17678C14.2233 4.12989 14.2496 4.0663 14.2496 4C14.2496 3.9337 14.2233 3.87011 14.1764 3.82322C14.1295 3.77634 14.0659 3.75 13.9996 3.75H9.99963Z"
                fill="currentColor" />
        </svg>
    </button>

    <!-- User icon (tablet — between sm and 1221px) -->
    <a href="/account"
        class="text-white hover:text-gray-300 border-0 bg-transparent min-[1221px]:hidden sm:flex hidden">
        <svg width="21" height="20" viewBox="0 0 21 20" fill="none" class="nav-icon sm:w-5 sm:h-5 w-4.5 h-4.5">
            <path
                d="M8.61133 12.1709H12.3887C15.6169 12.1709 18.25 14.8089 18.25 18.0527V18.25H2.75V18.0527C2.75 14.8088 5.38224 12.1709 8.61133 12.1709ZM10.5 1.75C12.4266 1.75 13.9997 3.32451 14 5.2627C14 7.20109 12.4268 8.77637 10.5 8.77637C8.57323 8.77637 7 7.20109 7 5.2627C7.00025 3.32451 8.57338 1.75 10.5 1.75Z"
                stroke="currentColor" stroke-width="1.5" />
        </svg>
    </a>

    {accountMenu ? (
        <div class="relative flex items-center">
            <button id="accountMenuToggle"
                class="rounded-full inline-flex items-center justify-center overflow-hidden border border-[#E0E0E0] sm:w-9 sm:h-9 w-8 h-8"
                aria-label="Toggle account menu">
                <img src="/profile.webp" alt="Profile" class="w-full h-full object-cover" />
            </button>

            <div id="accountMenuDropdown"
                class="absolute right-0 top-full sm:mt-3 mt-2 2xl:w-[265px] 1xl:w-[250px] xl:w-[238px] sm:w-[220px] w-[190px] bg-white rounded-sm shadow-[0_14px_40px_rgba(0,0,0,0.12)] overflow-hidden hidden z-50">
                {/* Header */}
                <div class="bg-[#B39F95] px-4 1xl:py-4 py-3">
                    <h3 class="uppercase text-white 1xl:mb-1.5 xl:mb-1">ANITA S.</h3>
                    <p class="text-white">Essence Plan</p>
                </div>
                {/* Items */}
                <div class="xl:p-5 sm:p-4.5 p-3.5 1xl:space-y-3.5 sm:space-y-3 space-y-2.5 divide-y divide-primary/15">
                    <button type="button"
                        class="account-menu-item w-full flex items-center gap-2 1xl:pb-3.5 sm:pb-3 pb-2.5 text-thunder-100 hover:bg-whitesmoke-100"
                        data-target="#account">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                            viewBox="0 0 24 24" fill="none" class="1xl:size-6 size-5">
                            <path
                                d="M5 18.9998H6.425L16.2 9.2248L14.775 7.7998L5 17.5748V18.9998ZM3 20.9998V16.7498L17.625 2.1748L21.8 6.4498L7.25 20.9998H3ZM15.475 8.5248L14.775 7.7998L16.2 9.2248L15.475 8.5248Z"
                                fill="#2D2D2D" />
                        </svg>
                        <span>Edit My Profile</span>
                    </button>
                    <button type="button"
                        class="account-menu-item w-full flex items-center gap-2 1xl:pb-3.5 sm:pb-3 pb-2.5 text-thunder-100 hover:bg-whitesmoke-100"
                        data-target="#plans">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                            viewBox="0 0 24 24" fill="none" class="1xl:size-6 size-5">
                            <path
                                d="M2.5 9.5H21.5V20.5C21.5 21.0523 21.0523 21.5 20.5 21.5H3.5C2.94771 21.5 2.5 21.0523 2.5 20.5V9.5Z"
                                stroke="#2D2D2D" stroke-width="2" stroke-linejoin="round" />
                            <path
                                d="M2.5 5C2.5 4.44771 2.94771 4 3.5 4H20.5C21.0523 4 21.5 4.44771 21.5 5V9.5H2.5V5Z"
                                stroke="black" stroke-width="2" stroke-linejoin="round" />
                            <path d="M8 15.5L11 18.5L17 12.5" stroke="#2D2D2D" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M8 2.5V6.5" stroke="black" stroke-width="2"
                                stroke-linecap="round" />
                            <path d="M16 2.5V6.5" stroke="black" stroke-width="2"
                                stroke-linecap="round" />
                        </svg>
                        <span>My Plan</span>
                    </button>
                    <button type="button"
                        class="account-menu-item w-full flex items-center gap-2 text-thunder-100 hover:bg-whitesmoke-100"
                        data-target="#classes">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
